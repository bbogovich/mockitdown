  "elements": {
    "Container": {"role": "vstack", "doc": "Centered, padded page container (max 1140px on desktop); .fluid() for full width"},
    "Row": {"role": "hstack", "defaults": {"wrap": true}, "doc": "Flex grid row with 24px gutters; .gap(0…5) sets the gutter (g-*)"},
    "Col": {"role": "vstack", "params": ["level"], "doc": "Grid column: Col() is equal width, Col(6) or .md(6) spans 6 of 12, Col(\"auto\") sizes to content"},
    "Stack": {"role": "vstack", "doc": "Flex stack: .direction(.horizontal) for hstack, .gap(0…5) for the spacer scale"},
    "Navbar": {"role": "appbar", "params": ["brand"], "defaults": {"color": "body-tertiary"}, "variants": ["light", "dark"],
               "doc": "Navbar(brand: \"Acme\") { Nav { NavLink… }; Button… } · .bg(.dark) / .bg(.primary) / variant: \"dark\""},
    "NavbarBrand": {"role": "text", "params": ["content"], "doc": "The brand text inside a Navbar"},
    "NavbarToggle": {"role": "button", "defaults": {"icon": "line.3.horizontal", "iconOnly": true, "variant": "toggler"}, "doc": "The collapsed-navbar hamburger toggler"},
    "NavbarCollapse": {"role": "group", "doc": "Groups the collapsible part of a Navbar (layout only)"},
    "NavbarText": {"role": "text", "params": ["content"], "doc": "Plain text inside a Navbar"},
    "Nav": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top"}, "variants": ["tabs", "pills", "underline"],
            "doc": "Nav { NavLink(\"Home\").active(); NavLink(\"Link\") } · variant: \"tabs\"|\"pills\"|\"underline\" · .class(\"flex-column\")"},
    "NavItem": {"role": "tab", "params": ["label"], "doc": "A Nav entry (same as NavLink)"},
    "NavLink": {"role": "tab", "params": ["label"], "doc": "NavLink(\"Home\", systemImage:) · .active() · disabled: true"},
    "NavDropdown": {"role": "menu", "params": ["title"], "defaults": {"variant": "nav"}, "doc": "A nav link with a dropdown menu; open: true shows it"},
    "Tabs": {"role": "tabs", "defaults": {"placement": "top", "variant": "tabs"}, "variants": ["tabs", "pills", "underline"],
             "doc": "Tabs(selection: \"Profile\") { Tab(\"Home\") { … } … } — nav tabs with panes"},
    "Tab": {"role": "tab", "params": ["title"], "doc": "Tab(\"Profile\") { pane content } · .active()"},
    "TabContainer": {"role": "group", "doc": "Layout-only wrapper"},
    "TabContent": {"role": "group", "doc": "Layout-only wrapper"},
    "TabPane": {"role": "group", "doc": "Layout-only wrapper"},
    "Breadcrumb": {"role": "breadcrumb", "params": ["items"], "doc": "Breadcrumb([\"Home\", \"Library\", \"Data\"]) or BreadcrumbItem children"},
    "BreadcrumbItem": {"role": "text", "params": ["content"], "doc": "One breadcrumb (the last is the active page)"},
    "Pagination": {"role": "pagination", "doc": "Pagination(count: 10, page: 2) · size: \"sm\"|\"lg\""},

    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "primary"},
               "variants": ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark", "link",
                            "outline-primary", "outline-secondary", "outline-success", "outline-danger",
                            "outline-warning", "outline-info", "outline-light", "outline-dark"],
               "doc": "Button(\"Save\", variant: \"outline-secondary\", size: \"sm\", systemImage:) · .active() · disabled: true"},
    "CloseButton": {"role": "button", "defaults": {"icon": "xmark", "iconOnly": true, "variant": "close"}, "doc": "The btn-close ×"},
    "ButtonGroup": {"role": "toolbar", "defaults": {"variant": "group"}, "doc": "Joined buttons; size: \"sm\"|\"lg\" on the buttons"},
    "ButtonToolbar": {"role": "toolbar", "doc": "A row of button groups"},
    "ToggleButton": {"role": "toggle", "params": ["label"], "defaults": {"variant": "button"}, "doc": "ToggleButton(\"Bold\", checked: true) — outline-primary checkable button"},
    "ToggleButtonGroup": {"role": "toolbar", "defaults": {"variant": "group"}, "doc": "Joined ToggleButtons"},
    "Dropdown": {"role": "menu", "params": ["title"], "defaults": {"variant": "primary"}, "doc": "Dropdown(\"Actions\", open: true) { DropdownItem… }"},
    "DropdownButton": {"role": "menu", "params": ["title"], "defaults": {"variant": "primary"},
                       "doc": "DropdownButton(\"Filter\", variant: \"outline-secondary\", open: true) { DropdownItem… }"},
    "SplitButton": {"role": "menu", "params": ["title"], "defaults": {"variant": "primary"}, "doc": "A button with a separate caret toggle"},
    "DropdownToggle": {"role": "button", "params": ["label"], "defaults": {"variant": "primary", "dropdown": true}, "doc": "A button with a caret"},
    "DropdownMenu": {"role": "menu", "doc": "A static, always-visible dropdown menu"},
    "DropdownItem": {"role": "menuitem", "params": ["label"], "doc": "DropdownItem(\"Edit\", systemImage:) · .active() · disabled: true"},
    "DropdownDivider": {"role": "divider", "doc": "Separator inside a dropdown"},
    "DropdownHeader": {"role": "text", "params": ["content"], "doc": "Small muted heading inside a dropdown"},
    "DropdownItemText": {"role": "text", "params": ["content"], "doc": "Non-interactive text inside a dropdown"},

    "Form": {"role": "form", "doc": "Form { FormGroup… ; Button } (no padding; 16px between groups)"},
    "FormGroup": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "A label + control + help text group"},
    "FormLabel": {"role": "text", "params": ["content"], "doc": "A form label"},
    "FormControl": {"role": "textfield", "params": ["placeholder"],
                    "doc": "FormControl(\"name@example.com\", label:, text:, type: \"email\"|\"password\"|\"textarea\", size: \"sm\"|\"lg\", helper:) · .isInvalid() · .plaintext()"},
    "FormSelect": {"role": "select", "params": ["selection"], "doc": "FormSelect(\"Choose…\", label:) { Text(\"One\") … } · open: true"},
    "FormCheck": {"role": "toggle", "params": ["label"], "defaults": {"variant": "checkbox"}, "doc": "Checkbox: FormCheck(\"Remember me\", checked: true)"},
    "FormSwitch": {"role": "toggle", "params": ["label"], "doc": "Switch: FormSwitch(\"Notifications\", checked: true)"},
    "FormRadio": {"role": "radio", "params": ["label"], "doc": "Radio (Form.Check type=\"radio\"): FormRadio(\"Credit card\", checked: true)"},
    "FormRange": {"role": "slider", "params": ["label"], "doc": "FormRange(\"Volume\", value: 40, in: 0...100)"},
    "FormText": {"role": "text", "params": ["content"], "doc": "Muted help text under a control"},
    "FormFloating": {"role": "group", "doc": "Layout-only wrapper"},
    "FloatingLabel": {"role": "textfield", "params": ["label"], "defaults": {"variant": "floating"},
                      "doc": "FloatingLabel(\"Email address\", text: \"name@example.com\")"},
    "FormControlFeedback": {"role": "text", "params": ["content"], "doc": "invalid-feedback text; kind: \"valid\" for valid-feedback"},
    "InputGroup": {"role": "hstack", "defaults": {"spacing": 0}, "doc": "InputGroup { InputGroupText(\"@\"); FormControl(\"Username\") } — joined controls"},
    "InputGroupText": {"role": "text", "params": ["content"], "doc": "An add-on box inside an InputGroup"},

    "Alert": {"role": "alert", "params": ["message"], "defaults": {"variant": "primary", "showIcon": false},
              "variants": ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark"],
              "doc": "Alert(\"Saved!\", variant: \"success\", title:, dismissible: true) { AlertLink… }"},
    "AlertHeading": {"role": "text", "params": ["content"], "defaults": {"font": "h4"}, "doc": "An alert heading"},
    "AlertLink": {"role": "link", "params": ["label"], "doc": "A bold link coloured for its alert"},
    "Badge": {"role": "badge", "params": ["text"], "defaults": {"color": "primary"},
              "doc": "Badge(\"New\").bg(.success) · .pill() · variant: \"subtle\" (bg-*-subtle text-*-emphasis)"},
    "Card": {"role": "card", "params": ["title"],
             "doc": "Card(\"Title\", subtitle:, image:) { body } footer: { … } · header: { Text(\"Featured\") } draws a header band"},
    "CardBody": {"role": "group", "doc": "Layout-only wrapper (the Card's children are its body)"},
    "CardTitle": {"role": "text", "params": ["content"], "defaults": {"font": "h5"}, "doc": "card-title inside a body"},
    "CardSubtitle": {"role": "text", "params": ["content"], "defaults": {"font": "h6"}, "doc": "card-subtitle (muted)"},
    "CardText": {"role": "text", "params": ["content"], "doc": "card-text"},
    "CardLink": {"role": "link", "params": ["label"], "doc": "card-link"},
    "CardImg": {"role": "image", "params": ["name"], "doc": "An image inside a card body"},
    "CardGroup": {"role": "hstack", "defaults": {"spacing": 0}, "doc": "Cards joined edge to edge"},
    "ListGroup": {"role": "list", "variants": ["flush"], "doc": "ListGroup { ListGroupItem… } · .flush() · .numbered() · .horizontal()"},
    "ListGroupItem": {"role": "listitem", "params": ["title"],
                      "variants": ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark"],
                      "doc": "ListGroupItem(\"Inbox\", subtitle:, detail:) .badge(14) · .active() · .action() · variant: \"success\""},
    "Table": {"role": "table", "doc": "Table(columns:, rows:) · .striped() .hover() .bordered() .borderless() .size(.sm) · variant: \"dark\""},
    "ProgressBar": {"role": "progress", "params": ["value"],
                    "doc": "ProgressBar(60, label: \"60%\", variant: \"success\") · .striped()"},
    "Spinner": {"role": "badge", "doc": "Spinner(variant: \"primary\", size: \"sm\") · .animation(.grow)"},
    "Placeholder": {"role": "shape", "params": ["level"], "doc": "Loading placeholder bar: Placeholder(6) or .xs(6) spans 6/12 · size: \"lg\"|\"sm\"|\"xs\" · .animation(.glow)"},
    "PlaceholderButton": {"role": "button", "params": ["level"], "defaults": {"variant": "primary"}, "doc": "A placeholder in button shape"},
    "Image": {"role": "image", "params": ["name"], "doc": "Image(\"photo.jpg\") · .rounded() · .roundedCircle() · .thumbnail() · .fluid()"},
    "Figure": {"role": "vstack", "defaults": {"alignment": "leading", "spacing": 8}, "doc": "Figure { FigureImage(…); FigureCaption(…) }"},
    "FigureImage": {"role": "image", "params": ["name"], "doc": "figure-img"},
    "FigureCaption": {"role": "text", "params": ["content"], "doc": "figure-caption (muted, small)"},
    "Ratio": {"role": "zstack", "params": ["kind"], "doc": "Ratio(\"16x9\") { content } — 1x1, 4x3, 16x9, 21x9"},
    "Carousel": {"role": "card", "params": ["title"], "doc": "One carousel slide: Carousel(\"First slide\", subtitle:, image:, mediaHeight:) with indicators and controls"},
    "Accordion": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Accordion { AccordionItem… } · .flush()"},
    "AccordionItem": {"role": "accordion", "params": ["title"], "doc": "AccordionItem(\"Item #1\", expanded: true) { body }"},
    "Modal": {"role": "dialog", "params": ["title"], "defaults": {"variant": "modal", "closeButton": true},
              "doc": "Modal(\"Title\") { body } footer: { Button… } · size: \"sm\"|\"lg\"|\"xl\" · .centered() · inline: true"},
    "Offcanvas": {"role": "dialog", "params": ["title"], "defaults": {"variant": "offcanvas", "closeButton": true},
                  "doc": "Offcanvas(\"Menu\") { body } · placement: \"end\""},
    "Toast": {"role": "card", "params": ["title"], "doc": "Toast(\"Bootstrap\", status: \"11 mins ago\", systemImage:) { Text(body) } · .bg(.primary)"},
    "ToastBody": {"role": "group", "doc": "Layout-only wrapper"},
    "ToastContainer": {"role": "dialog", "defaults": {"variant": "toast-container", "position": "top-end"},
                       "doc": "Positions toasts over the screen: position: \"top-end\"|\"top-start\"|\"bottom-end\"|… · inline: true"},
    "Tooltip": {"role": "tooltip", "params": ["text"], "defaults": {"placement": "top"}, "doc": "Tooltip(\"Hint\", placement: .bottom) { trigger }"},
    "Popover": {"role": "tooltip", "params": ["title", "message"], "defaults": {"placement": "right"},
                "doc": "Popover(\"Title\", \"Body text\") { trigger } · placement: .bottom"}
  }
}
