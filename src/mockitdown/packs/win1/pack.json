  "fonts": {
    "system": "body",
    "systemFixed": "body",
    "terminal": "footnote",
    "helv": "body",
    "tmsRmn": "title3",
    "modern": "body",
    "script": "title3",
    "caption": "caption"
  },
  "icons": {
    "hand": "xmark.circle",
    "exclamation": "exclamationmark.triangle",
    "question": "questionmark.circle",
    "asterisk": "info.circle",
    "application": "app",
    "drive": "archivebox",
    "file": "doc"
  },
  "modifiers": {
    "checked": {
      "attr": "checked"
    },
    "grayed": {
      "attr": "disabled"
    },
    "highlighted": {
      "attr": "selected"
    }
  },
  "elements": {
    "Desktop": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "The whole screen: a TiledArea of windows above the IconArea; dialogs and menus overlap it"
    },
    "TiledArea": {
      "role": "hstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "The tiling region above the icon area: windows share it side by side, never overlapping"
    },
    "TileColumn": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "A column of tiled windows stacked top to bottom"
    },
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "variants": [
        "active",
        "inactive"
      ],
      "doc": "Tiled application window: a caption bar with the centred title only (no boxes), menu bar and client area; .variant(.inactive) for a white caption"
    },
    "PopupWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "popup"
      },
      "doc": "Overlapping pop-up window (Control Panel, About): double-line frame over the tiles"
    },
    "DialogBox": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "doc": "Modal dialog box: no caption, a thick double black frame; overlaps the tiles"
    },
    "MessageBox": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert"
      },
      "doc": "MessageBox(\"Write\", message: \"…\", icon: \"exclamation\", buttons: [\"OK\", \"Cancel\"])"
    },
    "ClientArea": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "The white client area of a window"
    },
    "MenuBar": {
      "role": "toolbar",
      "doc": "The menu bar under the caption; children are MenuBarItem or PopupMenu"
    },
    "MenuBarItem": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "menubar"
      },
      "doc": "A menu title in the menu bar; .selected() inverts it (Windows 1.0 shows no mnemonic underlines)"
    },
    "PopupMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "menubar",
        "caret": false
      },
      "doc": "PopupMenu(\"File\", open: true) { MenuItem(\"New\") … }"
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "Menu command; checked:, shortcut:, .disabled() (grey), .selected()"
    },
    "MenuSeparator": {
      "role": "divider",
      "doc": "Separator line in a drop-down menu"
    },
    "PushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "variants": [
        "default"
      ],
      "doc": "Push button: rounded box with a 1px black border"
    },
    "DefPushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "doc": "DEFPUSHBUTTON: the default button, with a heavier border"
    },
    "CheckBox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "Check box: square that shows an X when checked"
    },
    "AutoCheckBox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "BS_AUTOCHECKBOX"
    },
    "RadioButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "RADIOBUTTON: circle, filled dot when checked"
    },
    "AutoRadioButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "BS_AUTORADIOBUTTON"
    },
    "RadioGroup": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "Radio buttons from items:/selection:"
    },
    "GroupBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "groupbox"
      },
      "doc": "GROUPBOX: rectangle with its title on the top line"
    },
    "EditText": {
      "role": "textfield",
      "params": [
        "text"
      ],
      "doc": "EDITTEXT: single-line edit control in a black box"
    },
    "Edit": {
      "role": "textfield",
      "params": [
        "text"
      ],
      "doc": "Edit control (window class \"edit\")"
    },
    "MultiLineEdit": {
      "role": "textfield",
      "params": [
        "text"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "doc": "ES_MULTILINE edit control"
    },
    "ListBox": {
      "role": "list",
      "doc": "LISTBOX: bordered list; ListBoxItem children, .selected() inverts"
    },
    "ListBoxItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "doc": "A list box string"
    },
    "LText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "LTEXT: left-aligned static text"
    },
    "RText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "RTEXT: right-aligned static text"
    },
    "CText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "CTEXT: centred static text"
    },
    "Static": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Static control (window class \"static\")"
    },
    "DialogIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "doc": "ICON in a dialog: hand, exclamation, question, asterisk"
    },
    "ScrollBar": {
      "role": "slider",
      "params": [
        "value"
      ],
      "defaults": {
        "variant": "scrollbar"
      },
      "doc": "Horizontal scroll bar: grey shaft, white thumb, arrow boxes"
    },
    "VScrollBar": {
      "role": "slider",
      "params": [
        "value"
      ],
      "defaults": {
        "variant": "scrollbar",
        "orientation": "vertical"
      },
      "doc": "Vertical scroll bar at a window's right edge"
    },
    "IconArea": {
      "role": "hstack",
      "defaults": {
        "alignment": "center",
        "spacing": 14
      },
      "doc": "The strip along the bottom of the screen where iconic (inactive) applications park"
    },
    "IconicWindow": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "An application shrunk to an icon in the icon area, its name below"
    },
    "DriveBar": {
      "role": "hstack",
      "defaults": {
        "spacing": 10
      },
      "doc": "MS-DOS Executive: the row of drive icons"
    },
    "DriveIcon": {
      "role": "chip",
      "params": [
        "label"
      ],
      "doc": "MS-DOS Executive drive icon, e.g. DriveIcon(\"C\").selected()"
    },
    "PathLine": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "MS-DOS Executive current path, e.g. \"C: \\\\WINDOWS\""
    },
    "FileList": {
      "role": "grid",
      "defaults": {
        "columns": 4,
        "spacing": 0
      },
      "doc": "MS-DOS Executive file names in columns"
    },
    "FileName": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "A file name in the list; .selected() inverts it"
    },
    "ToolPalette": {
      "role": "grid",
      "defaults": {
        "columns": 2,
        "spacing": 0
      },
      "doc": "Paint tool palette"
    },
    "PaletteTool": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "tool"
      },
      "doc": "A palette tool: icon:, .selected()"
    },
    "PatternPalette": {
      "role": "swatches",
      "doc": "Paint pattern/colour palette from colors:"
    },
    "Ruler": {
      "role": "slider",
      "defaults": {
        "variant": "ruler",
        "ticks": 12
      },
      "doc": "Write ruler with tick marks"
    },
    "StatusLine": {
      "role": "toolbar",
      "defaults": {
        "variant": "status"
      },
      "doc": "Status text line at the bottom of a window"
    },
    "PageView": {
      "role": "vstack",
      "defaults": {
        "alignment": "leading",
        "spacing": 4
      },
      "doc": "Document text area (Write)"
    },
    "SizeBox": {
      "role": "color",
      "defaults": {
        "variant": "sizebox"
      },
      "doc": "The square where the two scroll bars meet"
    },
    "IndexCard": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "indexcard"
      },
      "doc": "Cardfile card: the index line on top, a red rule, then the card text"
    },
    "CardStack": {
      "role": "zstack",
      "defaults": {
        "alignment": "topLeading"
      },
      "doc": "Cardfile's cascade of index cards"
    },
    "AppointmentList": {
      "role": "list",
      "defaults": {
        "variant": "appointments"
      },
      "doc": "Calendar day view: one ListBoxItem per time slot"
    },
    "MonthView": {
      "role": "calendar",
      "doc": "Calendar month view (date:, selection:)"
    },
    "Clock": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "variant": "clock"
      },
      "doc": "Digital-style clock face text shown in a Clock window"
    },
    "TerminalScreen": {
      "role": "code",
      "defaults": {
        "kind": "terminal"
      },
      "doc": "Terminal / DOS-application screen (code role, terminal kind)",
      "params": [
        "code"
      ]
    }
  }
}