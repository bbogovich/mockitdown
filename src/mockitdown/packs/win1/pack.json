{
  "id": "win1",
  "name": "Windows 1.0",
  "framework": "Microsoft Windows 1.01–1.04 (1985–87), tiled windows, EGA 16 colours / CGA monochrome",
  "version": "Windows 1.03",
  "modules": [
    "Windows1",
    "Win1",
    "Windows101",
    "MSDOSExecutive1"
  ],
  "device": "desktop",
  "chrome": {
    "desktop": "window",
    "wide": "window",
    "tablet": "window",
    "phone": "window"
  },
  "sizes": {
    "desktop": [
      640,
      350
    ],
    "wide": [
      800,
      480
    ],
    "tablet": [
      640,
      350
    ],
    "phone": [
      640,
      200
    ]
  },
