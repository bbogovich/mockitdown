      "on-accent": "#140c00",
      "accent-soft": "#3d2800",
      "danger": "#ffe2a8",
      "warning": "#ffd27a",
      "success": "#ffb000",
      "info": "#d48f00",
      "field-bg": "#120b02",
      "field-border": "#d48f00",
      "scrim": "rgb(10 6 0 / 0.72)",
      "shadow-1": "none",
      "shadow-2": "none",
      "shadow-3": "none",
      "radius-s": "0px",
      "radius-m": "0px",
      "radius-l": "0px",
      "radius-xl": "0px",
      "radius-pill": "0px",
      "font": "\"VT323\", \"IBM Plex Mono\", \"Courier New\", ui-monospace, monospace",
      "font-mono": "\"VT323\", \"IBM Plex Mono\", \"Courier New\", ui-monospace, monospace",
      "font-size": "15px",
      "line-height": "1.35",
      "icon-stroke": "2",
      "icon-size": "16px",
      "control-h": "30px",
      "gap": "8px",
      "pad": "12px",
      "chrome-bg": "#120b02",
      "chrome-fg": "#ffb000",
      "fs-display": "44px",
      "fw-display": "700",
      "fs-largeTitle": "34px",
      "fw-largeTitle": "700",
      "fs-title": "26px",
      "fw-title": "700",
      "fs-title2": "21px",
      "fw-title2": "700",
      "fs-title3": "18px",
      "fw-title3": "700",
      "fs-headline": "16px",
      "fw-headline": "700",
      "fs-subheadline": "15px",
      "fw-subheadline": "400",
      "fs-body": "15px",
      "fw-body": "400",
      "fs-callout": "15px",
      "fw-callout": "400",
      "fs-footnote": "13px",
      "fw-footnote": "400",
      "fs-caption": "12px",
      "fw-caption": "400",
      "fs-caption2": "11px",
      "fw-caption2": "400",
      "fs-overline": "12px",
      "fw-overline": "700",
