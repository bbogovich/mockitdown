{
  "id": "phosphor",
  "name": "Phosphor Terminal",
  "framework": "An original homage to the green-screen ship and mainframe computers of 1970s–80s science fiction",
  "version": "Cold-boot edition 1",
  "hidden": true,
  "modules": [
    "Phosphor",
    "Mainframe",
    "CRT"
  ],
  "device": "desktop",
  "chrome": {
    "phone": "none",
    "phone-landscape": "none",
    "tablet": "none",
    "tablet-portrait": "none",
    "desktop": "none",
    "wide": "none"
  },
  "fonts": {
    "header": "title2",
    "banner": "title",
    "label": "footnote",
    "readout": "largeTitle",
    "fine": "caption"
  },
  "tokens": {
