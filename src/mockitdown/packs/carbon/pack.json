    "HeaderMenu": {"role": "menu", "params": ["label"], "attrs": {"menuLinkName": "label"}, "doc": "HeaderMenu(\"Manage\", open: true) { HeaderMenuItem … }"},
    "HeaderGlobalBar": {"role": "toolbar", "doc": "Right-hand group of HeaderGlobalAction icons"},
    "HeaderGlobalAction": {"role": "button", "params": ["icon"], "defaults": {"iconOnly": true},
      "doc": "48×48 header icon button: HeaderGlobalAction(\"Notification\").badge(true)"},
    "HeaderPanel": {"role": "sidebar", "params": ["title"], "defaults": {"variant": "panel"}, "doc": "Right-hand panel under the header (e.g. Switcher)"},
    "Switcher": {"role": "group"},
    "SwitcherItem": {"role": "navitem", "params": ["label"]},
    "SwitcherDivider": {"role": "divider"},
    "SideNav": {"role": "sidebar", "params": ["title"], "variants": ["fixed", "rail"],
      "doc": "SideNav { SideNavLink(\"Dashboard\", icon: \"Dashboard\").selected(); SideNavMenu(\"Manage\") { SideNavMenuItem … } }"},
    "SideNavItems": {"role": "group"},
    "SideNavLink": {"role": "navitem", "params": ["label"], "attrs": {"renderIcon": "icon", "isActive": "selected"}},
    "SideNavMenu": {"role": "navitem", "params": ["label"], "attrs": {"renderIcon": "icon", "defaultExpanded": "expanded", "isActive": "selected"},
      "doc": "Expandable SideNav category; expands when a child is selected or expanded: true"},
    "SideNavMenuItem": {"role": "navitem", "params": ["label"], "attrs": {"isActive": "selected"}},
    "SideNavDivider": {"role": "divider"},

    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "primary"},
      "variants": ["primary", "secondary", "tertiary", "ghost", "danger", "danger--tertiary", "danger--ghost"],
      "attrs": {"kind": "variant", "renderIcon": "icon"},
      "doc": "Button(\"Create\", kind: \"secondary\", size: \"sm\" | \"md\" | \"lg\" | \"xl\", renderIcon: \"Add\") — icon sits at the trailing edge"},
    "IconButton": {"role": "button", "params": ["icon"], "defaults": {"iconOnly": true, "variant": "primary"},
      "variants": ["primary", "secondary", "tertiary", "ghost"], "attrs": {"kind": "variant", "renderIcon": "icon"},
      "doc": "IconButton(\"Edit\", kind: \"ghost\", size: \"sm\")"},
    "ButtonSet": {"role": "toolbar", "defaults": {"variant": "set"}, "doc": "Buttons side by side with no gap (secondary + primary)"},
    "MenuButton": {"role": "menu", "params": ["label"], "attrs": {"kind": "variant"}, "doc": "MenuButton(\"Actions\", kind: \"primary\", open: true) { MenuItem … }"},
    "ComboButton": {"role": "menu", "params": ["label"], "doc": "Primary action with a chevron menu"},
    "CopyButton": {"role": "button", "params": ["icon"], "defaults": {"icon": "doc.on.doc", "iconOnly": true, "variant": "ghost"}},
    "FileUploaderButton": {"role": "button", "params": ["label"], "defaults": {"variant": "primary", "size": "sm"}, "attrs": {"labelText": "label", "buttonKind": "variant"}},

    "TextInput": {"role": "textfield", "params": ["label"],
      "attrs": {"labelText": "label", "helperText": "helper", "invalidText": "error", "warnText": "helper"},
      "doc": "TextInput(\"Email\", placeholder:, helperText:, invalidText: \"…\", size: \"sm\" | \"md\" | \"lg\")"},
    "PasswordInput": {"role": "textfield", "params": ["label"], "defaults": {"kind": "password", "trailingIcon": "eye"},
      "attrs": {"labelText": "label", "helperText": "helper", "invalidText": "error"}},
    "TextArea": {"role": "textfield", "params": ["label"], "defaults": {"kind": "multiline"},
      "attrs": {"labelText": "label", "helperText": "helper", "invalidText": "error", "enableCounter": "counter"},
      "doc": "TextArea(\"Notes\", value:, rows: 4)"},
    "NumberInput": {"role": "stepper", "params": ["label"], "attrs": {"labelText": "label"},
      "doc": "NumberInput(\"Replicas\", value: 3) — field with − / + buttons"},
    "Search": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"}, "attrs": {"labelText": "label"},
      "doc": "Search(\"Search\", size: \"lg\") · value: shows the clear button"},
    "ExpandableSearch": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"}},
    "Select": {"role": "select", "params": ["label"], "attrs": {"labelText": "label", "helperText": "helper", "invalidText": "error"},
      "doc": "Select(\"Region\", value: \"US South\") { SelectItem(\"US South\") … }"},
    "Dropdown": {"role": "select", "params": ["label"],
      "attrs": {"titleText": "label", "selectedItem": "value", "initialSelectedItem": "value", "helperText": "helper", "invalidText": "error"},
      "doc": "Dropdown(\"Plan\", items: [\"Lite\", \"Standard\"], selectedItem: \"Standard\", open: true)"},
    "ComboBox": {"role": "select", "params": ["label"], "attrs": {"titleText": "label", "selectedItem": "value", "helperText": "helper"}},
    "MultiSelect": {"role": "select", "params": ["label"], "attrs": {"titleText": "label", "selectedItems": "value", "helperText": "helper"},
      "doc": "MultiSelect(\"Tags\", selectedItems: [\"api\", \"web\"]) — selected values show as tags"},
    "FilterableMultiSelect": {"role": "select", "params": ["label"], "attrs": {"titleText": "label", "selectedItems": "value"}},
    "Checkbox": {"role": "checkbox", "params": ["label"], "attrs": {"labelText": "label", "indeterminate": "checked"},
      "doc": "Checkbox(\"Email me\", checked: true) · checked: \"mixed\""},
    "CheckboxGroup": {"role": "radiogroup", "params": ["label"], "attrs": {"legendText": "label"}, "doc": "CheckboxGroup(legendText:) { Checkbox … }"},
    "RadioButton": {"role": "radio", "params": ["label"], "attrs": {"labelText": "label"}},
    "RadioButtonGroup": {"role": "radiogroup", "params": ["label"], "attrs": {"legendText": "label", "valueSelected": "value", "defaultSelected": "value"},
      "doc": "RadioButtonGroup(legendText: \"Plan\", options: [..], valueSelected: \"Lite\", orientation: .vertical)"},
    "Toggle": {"role": "toggle", "params": ["label"], "defaults": {"onText": "On", "offText": "Off"},
      "attrs": {"labelText": "label", "labelA": "offText", "labelB": "onText", "toggled": "isOn", "defaultToggled": "isOn"},
      "doc": "Toggle(\"Notifications\", toggled: true, size: \"sm\")"},
    "Slider": {"role": "slider", "defaults": {"showValue": true}, "attrs": {"labelText": "label"},
      "doc": "Slider(labelText: \"Budget\", value: 40, min: 0, max: 100, minLabel: \"0\", maxLabel: \"100\")"},
    "DatePicker": {"role": "datepicker", "params": ["label"], "defaults": {"format": "numeric", "placeholder": "mm/dd/yyyy"},
      "attrs": {"labelText": "label", "helperText": "helper", "invalidText": "error"}, "doc": "DatePicker(\"Start date\", value: \"2026-11-23\")"},
    "DatePickerInput": {"role": "datepicker", "params": ["label"], "defaults": {"format": "numeric", "placeholder": "mm/dd/yyyy"},
      "attrs": {"labelText": "label"}},
    "TimePicker": {"role": "datepicker", "params": ["label"], "defaults": {"kind": "time", "placeholder": "hh:mm"}, "attrs": {"labelText": "label"}},
    "FileUploader": {"role": "card", "params": ["title"], "attrs": {"labelTitle": "title", "labelDescription": "subtitle"},
      "doc": "FileUploader(labelTitle: \"Upload files\", labelDescription: \"Max 500 kB\") { FileUploaderButton(\"Add file\"); FileUploaderItem(\"a.png\", status: \"complete\") }"},
    "FileUploaderDropContainer": {"role": "dropzone", "params": ["label"], "attrs": {"labelText": "label"},
      "doc": "Dashed drop area: FileUploaderDropContainer(\"Drag and drop files here or click to upload\")"},
    "FileUploaderItem": {"role": "chip", "params": ["label"], "defaults": {"variant": "edit", "removable": true},
      "attrs": {"name": "label", "status": "variant"}, "variants": ["edit", "uploading", "complete"],
      "doc": "Uploaded file row: FileUploaderItem(\"report.pdf\", status: \"complete\")"},

    "DataTable": {"role": "table", "attrs": {"headers": "columns"}, "variants": ["zebra"],
      "doc": "DataTable(columns: [..], rows: [[..]], selectable: true, selectedRows: [1], sortColumn: 0, size: \"md\") — or TableRow/TableExpandRow children"},
    "Table": {"role": "table", "attrs": {"headers": "columns"}},
    "TableContainer": {"role": "card", "params": ["title"],
      "doc": "TableContainer(title: \"Deployments\", description: \"…\") { TableToolbar { … }; DataTable(…) }"},
    "TableToolbar": {"role": "toolbar", "doc": "48px toolbar above a DataTable: search, icon actions, primary button"},
    "TableToolbarContent": {"role": "hstack", "defaults": {"spacing": 0}},
    "TableToolbarSearch": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search", "placeholder": "Search"}},
    "TableToolbarMenu": {"role": "menu", "defaults": {"icon": "gear"}},
    "TableToolbarAction": {"role": "menuitem", "params": ["label"]},
    "TableBatchActions": {"role": "toolbar", "params": ["title"],
      "doc": "Blue batch bar shown when rows are selected: TableBatchActions(\"3 items selected\") { TableBatchAction(\"Delete\", renderIcon: \"TrashCan\"); Button(\"Cancel\") }"},
    "TableBatchAction": {"role": "button", "params": ["label"], "attrs": {"renderIcon": "icon"}},
    "TableRow": {"role": "tablerow"},
    "TableExpandRow": {"role": "tablerow", "defaults": {"status": "collapsed"},
      "doc": "Row with an expand chevron; follow it with TableExpandedRow { … } to show it expanded"},
    "TableExpandedRow": {"role": "tablerow", "defaults": {"status": "detail"}, "doc": "Full-width detail row under a TableExpandRow"},
    "TableHeader": {"role": "tablecolumn", "params": ["title"]},
    "StructuredList": {"role": "table", "params": ["columns"], "attrs": {"headers": "columns"},
      "doc": "StructuredList(columns: [..]) { StructuredListRow { StructuredListCell(\"…\") } } · selection: true for radio rows"},
    "StructuredListWrapper": {"role": "table", "params": ["columns"]},
    "StructuredListRow": {"role": "tablerow"},

    "Tile": {"role": "card", "params": ["title"], "doc": "Tile(title:) { … } — layer-01 surface, 16px padding, square"},
    "ClickableTile": {"role": "card", "params": ["title"], "defaults": {"variant": "clickable"}, "doc": "Whole tile is a link (arrow at the bottom right)"},
    "SelectableTile": {"role": "card", "params": ["title"], "defaults": {"variant": "selectable"}, "doc": "Checkbox at the top right; .selected() outlines it"},
    "ExpandableTile": {"role": "card", "params": ["title"], "defaults": {"variant": "expandable"},
      "doc": "Chevron at the bottom right; include TileBelowTheFoldContent to show it expanded"},
    "RadioTile": {"role": "card", "params": ["title"], "defaults": {"variant": "radio"}, "doc": "Radio at the top right; .selected()"},

    "Tag": {"role": "chip", "params": ["label"], "defaults": {"color": "gray"}, "attrs": {"type": "color", "text": "label"},
      "doc": "Tag(\"Running\", type: \"green\") — red, magenta, purple, blue, cyan, teal, green, gray, cool-gray, warm-gray, high-contrast, outline · size: \"sm\""},
    "DismissibleTag": {"role": "chip", "params": ["label"], "defaults": {"color": "gray", "removable": true}, "attrs": {"type": "color", "text": "label"}},
    "OperationalTag": {"role": "chip", "params": ["label"], "defaults": {"color": "gray"}, "attrs": {"type": "color", "text": "label"}},
    "SelectableTag": {"role": "chip", "params": ["label"], "attrs": {"text": "label"}, "doc": "SelectableTag(\"Python\").selected()"},
    "Link": {"role": "link", "params": ["label", "href"], "doc": "Link(\"Learn more\", icon: \"ArrowRight\") · size: \"sm\" | \"lg\""},
    "UnorderedList": {"role": "list", "doc": "UnorderedList { ListItem(\"…\") } — en-dash bullets"},
    "OrderedList": {"role": "list", "doc": "OrderedList { ListItem(\"…\") } — numbered"},
    "CodeSnippet": {"role": "code", "params": ["code"], "defaults": {"lineNumbers": false}, "attrs": {"type": "variant"},
      "variants": ["single", "multi", "inline"], "doc": "CodeSnippet(\"npm install @carbon/react\", type: \"single\") — copy button at the end"},
    "TreeView": {"role": "tree", "params": ["label"]},
    "TreeNode": {"role": "treeitem", "params": ["label"], "attrs": {"renderIcon": "icon", "isExpanded": "expanded"}},

    "Accordion": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Accordion { AccordionItem(title:, open: true) { … } }"},
    "AccordionItem": {"role": "accordion", "params": ["title"], "attrs": {"open": "expanded"}},
    "Tabs": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top"}, "variants": ["line", "contained"],
      "attrs": {"selectedIndex": "selection"}, "doc": "Tabs(selectedIndex: 0) { Tab(\"Overview\") { panel } … } · .contained()"},
    "TabList": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top"}, "attrs": {"selectedIndex": "selection"}},
    "Tab": {"role": "tab", "params": ["label"], "attrs": {"renderIcon": "icon"}},
    "ContentSwitcher": {"role": "segmented", "params": ["items"], "attrs": {"selectedIndex": "selection"},
      "doc": "ContentSwitcher(selectedIndex: 0) { Switch(\"All\"); Switch(\"Active\") } · size: \"sm\" | \"lg\""},
    "ProgressIndicator": {"role": "steps", "params": ["steps"], "attrs": {"currentIndex": "current"},
      "doc": "ProgressIndicator(currentIndex: 1) { ProgressStep(\"Details\") … } · errors: [2]"},
    "ProgressBar": {"role": "progress", "params": ["label"], "attrs": {"helperText": "caption"},
      "doc": "ProgressBar(\"Uploading\", value: 60, showValue: true) · size: \"small\""},
    "Loading": {"role": "progress", "defaults": {"kind": "circular"}, "doc": "Spinner; size: \"small\""},
    "InlineLoading": {"role": "progress", "params": ["label"], "defaults": {"kind": "circular", "size": "small"}, "attrs": {"description": "label"}},
    "MeterChart": {"role": "progress", "params": ["label"], "doc": "Carbon Charts meter: a labelled proportion bar"},
    "SkeletonText": {"role": "skeleton", "defaults": {"lines": 3}, "attrs": {"lineCount": "lines"}},
    "SkeletonPlaceholder": {"role": "skeleton", "defaults": {"shape": "rectangle", "lines": 0}},
    "DataTableSkeleton": {"role": "skeleton", "defaults": {"lines": 6}, "attrs": {"rowCount": "lines"}},
    "Pagination": {"role": "pagination", "params": ["summary"], "defaults": {"rowsPerPage": 10},
      "attrs": {"pageSize": "rowsPerPage", "totalPages": "count"},
      "doc": "Carbon's bar: Pagination(\"31–40 of 97 items\", page: 4, count: 10, pageSize: 10)"},
    "PaginationNav": {"role": "pagination", "attrs": {"totalItems": "count"}, "doc": "Numbered page links: PaginationNav(page: 3, totalItems: 12)"},
    "Breadcrumb": {"role": "breadcrumb", "params": ["items"], "doc": "Breadcrumb([\"Home\", \"Projects\", \"Atlas\"]) or BreadcrumbItem children"},
    "BreadcrumbItem": {"role": "link", "params": ["label", "href"], "attrs": {"isCurrentPage": "selected"}},
    "OverflowMenu": {"role": "menu", "defaults": {"icon": "ellipsis.vertical"}, "doc": "OverflowMenu(open: true) { OverflowMenuItem(\"Edit\"); OverflowMenuItem(\"Delete\", isDelete: true) }"},
    "OverflowMenuItem": {"role": "menuitem", "params": ["label"], "attrs": {"itemText": "label", "isDelete": "destructive"}},

    "Modal": {"role": "dialog", "params": ["title"], "attrs": {"modalHeading": "title", "modalLabel": "message"},
      "doc": "Modal(\"Delete project?\", buttons: [\"Cancel\", \"Delete\"], destructive: \"Delete\", closable: true) { body }"},
    "ComposedModal": {"role": "dialog", "params": ["title"], "doc": "ComposedModal(title:) { ModalBody { … } } actions: { Button(kind: \"secondary\"); Button }"},
    "InlineNotification": {"role": "alert", "params": ["title"], "defaults": {"severity": "error", "closable": true},
      "attrs": {"kind": "severity", "subtitle": "message", "lowContrast": "variant"}, "variants": ["lowContrast"],
      "doc": "InlineNotification(title: \"Error\", subtitle: \"…\", kind: \"error\" | \"success\" | \"warning\" | \"info\", lowContrast: true)"},
    "ActionableNotification": {"role": "alert", "params": ["title"], "defaults": {"severity": "error", "closable": true},
      "attrs": {"kind": "severity", "subtitle": "message", "lowContrast": "variant"},
      "doc": "Inline notification with an action: ActionableNotification(…) actions: { Button(\"Undo\", kind: \"tertiary\", size: \"sm\") }"},
    "ToastNotification": {"role": "toast", "params": ["title"], "defaults": {"severity": "error", "closable": true, "position": "topTrailing"},
      "attrs": {"kind": "severity", "subtitle": "description", "lowContrast": "variant"},
      "doc": "ToastNotification(title:, subtitle:, kind:) { Text(\"caption\") } — top-right; inline: true to place it"},
    "Tooltip": {"role": "tooltip", "params": ["text"], "attrs": {"label": "text", "align": "placement"}, "doc": "Tooltip(\"Copy\") { IconButton … } · align: .bottom"},
    "DefinitionTooltip": {"role": "tooltip", "params": ["text"], "attrs": {"definition": "text"}},
    "Toggletip": {"role": "tooltip", "params": ["text"]},

    "SimpleBarChart": {"role": "chart", "defaults": {"kind": "bar"}, "doc": "Carbon Charts: SimpleBarChart(values: [..], labels: [..])"},
    "GroupedBarChart": {"role": "chart", "defaults": {"kind": "bar"}, "doc": "GroupedBarChart(series: [[..], [..]], seriesNames:, labels:)"},
    "StackedBarChart": {"role": "chart", "defaults": {"kind": "bar", "stacked": true}},
    "LineChart": {"role": "chart", "defaults": {"kind": "line"}},
    "AreaChart": {"role": "chart", "defaults": {"kind": "area"}},
    "StackedAreaChart": {"role": "chart", "defaults": {"kind": "area", "stacked": true}},
    "DonutChart": {"role": "chart", "defaults": {"kind": "donut"}},
    "PieChart": {"role": "chart", "defaults": {"kind": "pie"}},
    "GaugeChart": {"role": "chart", "defaults": {"kind": "gauge"}},
    "ScatterChart": {"role": "chart", "defaults": {"kind": "scatter"}},
    "BubbleChart": {"role": "chart", "defaults": {"kind": "bubble"}},
    "RadarChart": {"role": "chart", "defaults": {"kind": "radar"}},
    "HeatmapChart": {"role": "chart", "defaults": {"kind": "heatmap"}},
    "TreemapChart": {"role": "chart", "defaults": {"kind": "treemap"}},
    "ComboChart": {"role": "chart", "defaults": {"kind": "combo"}},
    "HistogramChart": {"role": "chart", "defaults": {"kind": "histogram"}}
  }
}
