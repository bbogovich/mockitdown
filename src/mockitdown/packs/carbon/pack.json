    "FlexGrid": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "Grid": {"role": "grid", "params": ["columns"], "variants": ["wide", "narrow", "condensed"],
      "doc": "16-column CSS Grid: Grid { Column(lg: 4) { … } } · .narrow() / .condensed()"},
    "Column": {"role": "vstack", "defaults": {"alignment": "stretch"}, "attrs": {"lg": "size", "span": "size", "xlg": "size", "max": "size"},
      "doc": "Grid column: Column(lg: 8) spans 8 of 16 columns"},
    "Layer": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Raises nested components one layer (layer-02 / field-02)"},
    "Theme": {"role": "vstack", "params": ["variant"], "defaults": {"alignment": "stretch"}, "attrs": {"theme": "variant"},
      "variants": ["white", "g10", "g90", "g100"], "doc": "Zoned theme: Theme(\"g100\") { … } renders its content in that theme"},
    "Form": {"role": "form", "doc": "Form { TextInput … } · fields stack with 24px gaps"},
    "FormGroup": {"role": "section", "params": ["title"], "attrs": {"legendText": "title"}, "doc": "FormGroup(legendText: \"Contact\") { … }"},
