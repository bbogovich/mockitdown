      "subtle-hover": "rgb(0 0 0 / 0.037)", "subtle-pressed": "rgb(0 0 0 / 0.024)",
      "flyout-bg": "#f9f9f9", "flyout-stroke": "rgb(0 0 0 / 0.08)",
      "dialog-bg": "#ffffff", "dialog-footer": "#f3f3f3", "dialog-stroke": "rgb(117 117 117 / 0.40)",
      "infobar-info-bg": "#f6f6f6", "infobar-success-bg": "#dff6dd", "infobar-warning-bg": "#fff4ce",
      "infobar-error-bg": "#fde7e9", "infobar-info-icon": "#005fb8", "infobar-success-icon": "#0f7b0f",
      "infobar-warning-icon": "#9d5d00", "infobar-error-icon": "#c42b1c",
      "tab-selected-bg": "#f9f9f9",
      "fs-display": "68px", "fw-display": "600", "fs-largeTitle": "40px", "fw-largeTitle": "600",
      "fs-title": "28px", "fw-title": "600", "fs-title2": "20px", "fw-title2": "600",
      "fs-title3": "18px", "fw-title3": "400", "fs-headline": "14px", "fw-headline": "600",
      "fs-subheadline": "14px", "fw-subheadline": "400", "fs-body": "14px", "fw-body": "400",
      "fs-callout": "14px", "fw-callout": "400", "fs-footnote": "12px", "fw-footnote": "400",
      "fs-caption": "12px", "fw-caption": "400", "fs-caption2": "11px", "fw-caption2": "400",
      "fs-overline": "12px", "fw-overline": "600",
      "color-red": "#d13438", "color-orange": "#ca5010", "color-yellow": "#d29200", "color-green": "#107c10",
      "color-mint": "#00b294", "color-teal": "#038387", "color-cyan": "#0099bc", "color-blue": "#0078d4",
      "color-indigo": "#4f6bed", "color-purple": "#8764b8", "color-pink": "#e3008c", "color-brown": "#8e562e",
      "color-gray": "#7a7574",
      "chart-1": "#0078d4", "chart-2": "#8764b8", "chart-3": "#00b294", "chart-4": "#ca5010",
      "chart-5": "#e3008c", "chart-6": "#4f6bed"
    },
    "dark": {
      "bg": "#202020", "surface": "#2b2b2b", "surface-2": "#2d2d2d", "surface-3": "#383838",
      "fg": "#ffffff", "fg-2": "#cfcfcf", "fg-3": "#a0a0a0", "fg-disabled": "#787878",
      "border": "#1d1d1d", "divider": "#393939",
      "accent": "#60cdff", "on-accent": "#000000", "accent-soft": "rgb(96 205 255 / 0.12)",
      "accent-text": "#99ebff", "accent-hover": "#5bbcea",
      "danger": "#ff99a4", "warning": "#fce100", "success": "#6ccb5f", "info": "#60cdff",
      "field-bg": "#2d2d2d", "field-border": "#303030", "field-bg-focus": "#1f1f1f",
      "field-stroke-bottom": "#9a9a9a",
      "scrim": "rgb(0 0 0 / 0.30)",
      "shadow-1": "0 2px 4px rgb(0 0 0 / 0.13)",
      "shadow-2": "0 8px 16px rgb(0 0 0 / 0.26)",
      "shadow-3": "0 32px 64px rgb(0 0 0 / 0.37), 0 2px 21px rgb(0 0 0 / 0.37)",
      "shadow-tooltip": "0 4px 8px rgb(0 0 0 / 0.26)",
      "chrome-bg": "#202020", "chrome-fg": "#ffffff",
      "layer-bg": "#272727", "layer-stroke": "#1c1c1c",
      "card-bg": "#2b2b2b", "card-bg-2": "#262626", "card-stroke": "#1d1d1d",
      "control-fill": "#2d2d2d", "control-fill-hover": "#323232", "control-fill-pressed": "#272727",
      "control-stroke": "#303030", "control-stroke-top": "#363636", "control-stroke-bottom": "#303030",
      "control-strong": "#9a9a9a", "control-alt": "rgb(0 0 0 / 0.10)", "control-solid": "#454545",
      "accent-stroke-top": "rgb(255 255 255 / 0.08)", "accent-stroke-bottom": "rgb(0 0 0 / 0.14)",
      "subtle-hover": "rgb(255 255 255 / 0.061)", "subtle-pressed": "rgb(255 255 255 / 0.042)",
      "flyout-bg": "#2c2c2c", "flyout-stroke": "rgb(0 0 0 / 0.20)",
      "dialog-bg": "#2b2b2b", "dialog-footer": "#202020", "dialog-stroke": "rgb(117 117 117 / 0.40)",
      "infobar-info-bg": "#2b2b2b", "infobar-success-bg": "#393d1b", "infobar-warning-bg": "#433519",
      "infobar-error-bg": "#442726", "infobar-info-icon": "#60cdff", "infobar-success-icon": "#6ccb5f",
      "infobar-warning-icon": "#fce100", "infobar-error-icon": "#ff99a4",
      "tab-selected-bg": "#282828",
      "color-red": "#e37d80", "color-orange": "#e9835e", "color-yellow": "#ffd335", "color-green": "#6ccb5f",
      "color-mint": "#4fe0c3", "color-teal": "#4cc2c4", "color-cyan": "#4cc2ff", "color-blue": "#60cdff",
      "color-indigo": "#93a4f4", "color-purple": "#b4a0ff", "color-pink": "#ef6950", "color-brown": "#bb8e6e",
      "color-gray": "#a19f9d",
      "chart-1": "#4cc2ff", "chart-2": "#b4a0ff", "chart-3": "#4fe0c3", "chart-4": "#f7894a",
      "chart-5": "#ee5fb7", "chart-6": "#93a4f4"
    }
  },
  "fonts": {
    "caption": "caption", "body": "body", "bodyStrong": "headline", "bodyLarge": "title3",
    "subtitle": "title2", "title": "title", "titleLarge": "largeTitle", "display": "display",
    "captionTextBlockStyle": "caption", "CaptionTextBlockStyle": "caption",
    "bodyTextBlockStyle": "body", "BodyTextBlockStyle": "body",
    "bodyStrongTextBlockStyle": "headline", "BodyStrongTextBlockStyle": "headline",
    "bodyLargeTextBlockStyle": "title3", "BodyLargeTextBlockStyle": "title3",
    "subtitleTextBlockStyle": "title2", "SubtitleTextBlockStyle": "title2",
    "titleTextBlockStyle": "title", "TitleTextBlockStyle": "title",
    "titleLargeTextBlockStyle": "largeTitle", "TitleLargeTextBlockStyle": "largeTitle",
    "displayTextBlockStyle": "display", "DisplayTextBlockStyle": "display",
    "baseTextBlockStyle": "headline", "BaseTextBlockStyle": "headline"
  },
  "icons": {
    "Accept": "checkmark", "Back": "arrow.left", "Forward": "arrow.right", "Cancel": "xmark", "Clear": "xmark",
    "Find": "search", "Zoom": "search", "Save": "arrow.down.to.line", "SaveLocal": "arrow.down.to.line",
    "Undo": "arrowshape.turn.up.left", "OpenFile": "folder", "NewFolder": "folder", "FolderOpen": "folder",
    "Page": "doc", "Document": "doc", "Contact": "person", "People": "person.2", "Pictures": "photo",
    "World": "globe", "Globe": "globe", "Pin": "mappin", "Like": "hand.thumbsup", "Favorite": "star",
    "Important": "exclamationmark.circle", "Sync": "arrow.clockwise", "More": "ellipsis", "Manage": "wrench",
    "Repair": "wrench", "Shop": "bag", "Admin": "shield", "Permissions": "lock", "Placeholder": "square",
    "Display": "app", "System": "app", "Apps": "square.grid.2x2", "AllApps": "square.grid.2x2",
    "Devices": "square.grid.3x3", "Bluetooth": "link", "Network": "wifi", "Personalize": "pencil",
    "Personalization": "pencil", "Accounts": "person.circle", "Time": "clock", "TimeLanguage": "globe",
    "Gaming": "gauge", "Accessibility": "person.circle", "Privacy": "shield", "Update": "arrow.clockwise",
    "WindowsUpdate": "arrow.clockwise", "Power": "power", "Battery": "battery", "Storage": "archivebox",
    "Volume": "speaker", "Sound": "speaker", "Brightness": "sun", "NightLight": "moon", "Theme": "moon",
    "Cut": "doc.on.doc", "Copy": "doc.on.doc", "Paste": "doc.on.doc", "Rename": "pencil", "Delete": "trash",
    "Sort": "arrow.up.arrow.down", "View": "square.grid.2x2", "Filter": "line.3.horizontal.decrease",
    "GlobalNavigationButton": "line.3.horizontal", "Help": "questionmark.circle", "Attach": "paperclip",
    "Reply": "arrowshape.turn.up.left", "ReplyAll": "arrowshape.turn.up.left", "Flag": "flag",
    "Read": "envelope", "Unread": "envelope", "Inbox": "tray", "Drafts": "doc", "SentItems": "paperplane",
    "Send": "paperplane", "Archive": "archivebox", "Junk": "exclamationmark.triangle",
    "Download": "arrow.down.to.line", "Upload": "arrow.up.to.line", "Share": "square.and.arrow.up",
    "Print": "printer", "Edit": "pencil", "Add": "plus", "Remove": "minus", "Calendar": "calendar",
    "Clock": "clock", "Mail": "envelope", "Message": "message", "Phone": "phone", "Video": "video",
    "Home": "house", "Setting": "gear", "Settings": "gear", "Search": "search", "Refresh": "arrow.clockwise",
    "Lightbulb": "lightbulb", "Sparkle": "sparkles", "Copilot": "sparkles", "Cloud": "cloud", "OneDrive": "cloud",
    "Desktop": "app", "Downloads": "arrow.down.to.line", "Music": "music.note", "Videos": "video",
    "ThisPC": "app", "Gallery": "photo", "Recent": "clock", "Tag": "tag", "Lock": "lock", "Key": "key"
  },
  "modifiers": {
    "placeholderText": {"attr": "placeholder"},
    "header": {"attr": "header"},
    "isChecked": {"attr": "selected"},
    "isOn": {"attr": "isOn"},
    "isOpen": {"attr": "open"},
    "isExpanded": {"attr": "expanded"},
    "isClosable": {"attr": "isClosable"},
    "selectedIndex": {"attr": "selection"},
    "paneDisplayMode": {"attr": "variant"},
    "spinButtonPlacementMode": {"attr": "variant"},
    "defaultLabelPosition": {"attr": "placement"},
    "infoBadge": {"attr": "badge"}
  },
  "elements": {
    "Grid": {"role": "grid", "doc": "Grid(columns: 3) { … } — column count, or GridRow children"},
    "StackPanel": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "StackPanel(spacing: 8, orientation: .horizontal) { … } — children stretch across, controls keep their width (alignment: .leading to opt out)"},
    "Border": {"role": "vstack", "defaults": {"alignment": "leading"}, "doc": "A container; style it with .padding / .background / .cornerRadius / .border"},
    "ScrollViewer": {"role": "scroll", "params": ["axes"], "doc": "Scrolling region (static)"},
    "ScrollView": {"role": "scroll", "params": ["axes"], "doc": "WinUI 1.5 ScrollView (static)"},
    "Canvas": {"role": "zstack", "doc": "Overlapping layers"},
    "Viewbox": {"role": "zstack"},
    "RelativePanel": {"role": "zstack"},
    "ItemsRepeater": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "WrapPanel": {"role": "hstack", "defaults": {"wrap": true}, "doc": "Community Toolkit WrapPanel"},
    "UniformGrid": {"role": "grid", "doc": "Community Toolkit UniformGrid(columns: n)"},
    "DockPanel": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "Frame": {"role": "group", "doc": "Navigation host — renders its content"},
    "SplitView": {"role": "split", "doc": "SplitView { pane } content: { … }"},
    "TwoPaneView": {"role": "split", "doc": "TwoPaneView { pane1 } content: { pane2 }"},
    "HeaderedContentControl": {"role": "section", "params": ["header"], "doc": "Header text above content"},

    "TextBlock": {"role": "text", "params": ["content"], "doc": "TextBlock(\"Hi\", style: .titleTextBlockStyle) — Caption, Body, BodyStrong, BodyLarge, Subtitle, Title, TitleLarge, Display"},
    "RichTextBlock": {"role": "text", "params": ["content"]},
    "Hyperlink": {"role": "link", "params": ["label", "destination"]},
    "FontIcon": {"role": "icon", "params": ["name"], "doc": "FontIcon(\"Mail\") — Fluent / Segoe Fluent Icons name"},
    "SymbolIcon": {"role": "icon", "params": ["name"], "doc": "SymbolIcon(\"Accept\") — Symbol enum name"},
    "ImageIcon": {"role": "icon", "params": ["name"]},
    "BitmapIcon": {"role": "icon", "params": ["name"]},
    "PathIcon": {"role": "icon", "params": ["name"]},
    "PersonPicture": {"role": "avatar", "params": ["name"], "doc": "PersonPicture(\"Ana Diaz\", image:, initials:, badge:, size: .small|.large)"},
    "InfoBadge": {"role": "badge", "params": ["value"], "defaults": {"variant": "attention"},
                  "variants": ["attention", "informational", "success", "caution", "critical"],
                  "doc": "InfoBadge(5) or InfoBadge() dot; .variant(.critical)"},

    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "standard"},
               "variants": ["standard", "accent", "subtle", "hyperlink"],
               "doc": "Button(\"Save\", icon:) · .buttonStyle(.accent | .subtle)"},
    "HyperlinkButton": {"role": "button", "params": ["label"], "defaults": {"variant": "hyperlink"}, "doc": "Link-styled button"},
    "ToggleButton": {"role": "button", "params": ["label"], "defaults": {"variant": "standard"}, "doc": "ToggleButton(\"Bold\", selected: true) — selected is IsChecked"},
    "DropDownButton": {"role": "button", "params": ["label"], "defaults": {"variant": "standard", "dropdown": true}, "doc": "Button with a chevron that opens a flyout"},
    "SplitButton": {"role": "button", "params": ["label"], "defaults": {"variant": "standard", "split": true}, "doc": "Primary part + chevron part"},
    "ToggleSplitButton": {"role": "button", "params": ["label"], "defaults": {"variant": "standard", "split": true}, "doc": "SplitButton whose primary part toggles (selected:)"},
    "RepeatButton": {"role": "button", "params": ["label"], "defaults": {"variant": "standard"}},
    "AppBarButton": {"role": "button", "params": ["label"], "defaults": {"variant": "appBar"}, "doc": "AppBarButton(\"Share\", icon: \"Share\") inside a CommandBar"},
    "AppBarToggleButton": {"role": "button", "params": ["label"], "defaults": {"variant": "appBar"}, "doc": "selected: true = IsChecked"},
    "AppBarSeparator": {"role": "divider"},
    "AppBarElementContainer": {"role": "group"},
    "CommandBar": {"role": "toolbar", "defaults": {"placement": "right"}, "variants": ["right", "bottom", "collapsed"],
                   "doc": "CommandBar { AppBarButton… } · .defaultLabelPosition(.bottom | .right | .collapsed); AppBarButton(icon: \"More\") for the overflow button"},
    "CommandBarFlyout": {"role": "menu", "params": ["label"]},

    "ToggleSwitch": {"role": "toggle", "params": ["label"], "defaults": {"onText": "On", "offText": "Off"},
                     "doc": "ToggleSwitch(\"Wi-Fi\", isOn: true, onText:, offText:) — label is the Header"},
    "CheckBox": {"role": "checkbox", "params": ["label"], "doc": "CheckBox(\"Remember me\", checked: true | .indeterminate)"},
    "RadioButton": {"role": "radio", "params": ["label"], "doc": "RadioButton(\"Small\", checked: true)"},
    "RadioButtons": {"role": "radiogroup", "params": ["label"], "doc": "RadioButtons(\"Theme\", items: [\"Light\", \"Dark\"], selection: \"Dark\")"},
    "ComboBox": {"role": "select", "params": ["header"], "variants": ["editable"],
                 "doc": "ComboBox(\"Size\", items: [\"S\", \"M\"], selection: \"M\", placeholder:, open: true)"},
    "ComboBoxItem": {"role": "text", "params": ["content"]},
    "TextBox": {"role": "textfield", "params": ["header"], "doc": "TextBox(\"Name\", text:, placeholder:, description:) · .state(.focused)"},
    "PasswordBox": {"role": "textfield", "params": ["header"], "defaults": {"kind": "password", "reveal": true},
                    "doc": "PasswordBox(\"Password\", text: \"secret\")"},
    "NumberBox": {"role": "textfield", "params": ["header"], "defaults": {"kind": "number", "trailingIcon": "chevron.up.down"},
                  "variants": ["hidden", "compact", "inline"],
                  "doc": "NumberBox(\"Quantity\", text: \"3\") · .spinButtonPlacementMode(.inline | .compact)"},
    "AutoSuggestBox": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"},
                       "doc": "AutoSuggestBox(\"Search\", text:) — query icon on the right"},
    "RichEditBox": {"role": "textfield", "params": ["header"], "defaults": {"kind": "multiline"}, "doc": "Multi-line rich text editor (rows:)"},
    "TokenizingTextBox": {"role": "textfield", "params": ["header"]},
    "Slider": {"role": "slider", "params": ["label"], "doc": "Slider(\"Volume\", value: 40, in: 0...100, ticks: 10)"},
    "RangeSelector": {"role": "slider", "params": ["label"], "doc": "Community Toolkit: value: [20, 80]"},
    "RatingControl": {"role": "rating", "params": ["value"], "doc": "RatingControl(3.5, max: 5, label:)"},
    "ColorPicker": {"role": "placeholder", "params": ["label"], "defaults": {"icon": "palette"}},
    "Segmented": {"role": "segmented", "params": ["items"], "doc": "Community Toolkit Segmented(items:, selection:)"},

    "ProgressBar": {"role": "progress", "params": ["label"], "doc": "ProgressBar(value: 0.6) — no value = indeterminate; .state(.paused | .error)"},
    "ProgressRing": {"role": "progress", "params": ["label"], "defaults": {"variant": "ring"}, "doc": "ProgressRing() indeterminate, or value: 0.7"},
    "InfoBar": {"role": "alert", "params": ["title"], "defaults": {"severity": "informational", "isClosable": true},
                "variants": [],
                "doc": "InfoBar(\"Title\", message:, severity: .informational|.success|.warning|.error) { … } actions: { Button }"},
    "TeachingTip": {"role": "tooltip", "params": ["title"], "defaults": {"placement": "bottom"},
                    "doc": "TeachingTip(\"Title\", subtitle:, placement: .bottom|.top|.bottomLeft|.bottomRight|.topLeft|.topRight) { target } actions: { Button }"},
    "ToolTip": {"role": "tooltip", "params": ["text"], "doc": "ToolTip(\"Hint\") { target }"},
    "ContentDialog": {"role": "dialog", "params": ["title"],
                      "doc": "ContentDialog(\"Save?\", buttons: [\"Save\", \"Don't save\", \"Cancel\"], primary: \"Save\") { content }"},
    "Flyout": {"role": "card", "params": ["title"], "defaults": {"variant": "flyout"}, "doc": "A light-dismiss surface; place it with .overlay(alignment:)"},
    "MenuFlyout": {"role": "menu", "params": ["label"], "doc": "MenuFlyout { MenuFlyoutItem… } — open popup; with a label it is a button (open: true)"},
    "MenuFlyoutItem": {"role": "menuitem", "params": ["label"], "doc": "MenuFlyoutItem(\"Copy\", icon: \"Copy\", shortcut: \"Ctrl+C\")"},
    "MenuFlyoutSubItem": {"role": "menuitem", "params": ["label"], "doc": "Item with a submenu chevron (children)"},
    "ToggleMenuFlyoutItem": {"role": "menuitem", "params": ["label"], "defaults": {"checked": false}, "doc": "checked: true"},
    "RadioMenuFlyoutItem": {"role": "menuitem", "params": ["label"], "defaults": {"checked": false}, "doc": "checked: true"},
    "MenuFlyoutSeparator": {"role": "divider"},
    "MenuBar": {"role": "toolbar", "defaults": {"variant": "menubar"}, "doc": "MenuBar { MenuBarItem(\"File\") { … } }"},
    "MenuBarItem": {"role": "menu", "params": ["label"], "defaults": {"caret": false, "variant": "menubar"}, "doc": "MenuBarItem(\"Edit\", open: true) { MenuFlyoutItem… }"},

    "ListView": {"role": "list", "doc": "ListView { ListViewItem… } — selection with .selected()"},
    "ListViewItem": {"role": "listitem", "params": ["title"], "doc": "ListViewItem(\"Title\", subtitle:, detail:, icon:, avatar:)"},
    "ListViewHeaderItem": {"role": "text", "params": ["content"]},
    "GridView": {"role": "grid", "defaults": {"columns": 4}, "doc": "GridView(columns: 4) { GridViewItem… }"},
    "GridViewItem": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "ItemsView": {"role": "grid", "defaults": {"columns": 3}},
    "FlipView": {"role": "placeholder", "params": ["label"], "defaults": {"icon": "photo"}},
    "TreeView": {"role": "list", "defaults": {"variant": "tree"}, "doc": "TreeView { TreeViewItem(\"Docs\", icon:, expanded: true) { … } }"},
    "TreeViewItem": {"role": "navitem", "params": ["label"]},
    "TreeViewNode": {"role": "navitem", "params": ["label"]},
    "DataGrid": {"role": "table", "doc": "Community Toolkit DataGrid(columns: [...], rows: [[...]])"},
    "DataGridTextColumn": {"role": "tablecolumn", "params": ["title"]},
    "DataGridTemplateColumn": {"role": "tablecolumn", "params": ["title"]},
    "Expander": {"role": "accordion", "params": ["header"], "doc": "Expander(\"Header\", isExpanded: true) { content }"},
    "SettingsCard": {"role": "listitem", "params": ["title"],
                     "doc": "SettingsCard(\"Header\", description:, icon:, chevron:) { control } — Community Toolkit"},
    "SettingsExpander": {"role": "accordion", "params": ["header"],
                         "doc": "SettingsExpander(\"Header\", description:, icon:, expanded:) { SettingsCard… } trailing: { control }"},

    "NavigationView": {"role": "split", "defaults": {"variant": "left"},
                       "variants": ["left", "leftCompact", "leftMinimal", "top", "auto"],
                       "doc": "NavigationView { pane items } content: { page } · .paneDisplayMode(.leftCompact | .top)"},
    "NavigationViewItem": {"role": "navitem", "params": ["label"], "doc": "NavigationViewItem(\"Home\", icon: \"Home\", badge: 3) · .selected()"},
    "NavigationViewItemHeader": {"role": "text", "params": ["content"]},
    "NavigationViewItemSeparator": {"role": "divider"},
    "TitleBar": {"role": "appbar", "params": ["title"],
                 "doc": "TitleBar(\"App\", subtitle:, logo: \"icon\", back: true, menu: true) content: { AutoSuggestBox } { right header }"},
    "TabView": {"role": "tabs", "defaults": {"placement": "top", "variant": "document"},
                "doc": "TabView(selection:) { TabViewItem(\"Doc.txt\", icon:) { … } } — tabs with close buttons and “+”"},
