{
  "id": "win95",
  "name": "Windows 95",
  "framework": "Windows 95 · Win32 shell and common controls (Windows Standard colour scheme)",
  "version": "Windows 95 (1995)",
  "modules": [
    "Windows95",
    "Win95",
    "Win32"
  ],
  "device": "desktop",
  "chrome": {
    "desktop": "window",
    "wide": "window",
    "tablet": "window",
    "phone": "none"
  },
  "sizes": {
    "desktop": [
      640,
      480
    ],
    "wide": [
      800,
      600
    ],
    "tablet": [
      640,
      480
    ]
  },
  "fonts": {
    "caption": "headline",
    "captionText": "headline",
    "menuText": "body",
    "messageText": "body",
    "MSSansSerif": "body",
    "SmallFonts": "caption",
    "dialogTitle": "title3",
    "wizardTitle": "headline",
    "heading": "title2"
  },
