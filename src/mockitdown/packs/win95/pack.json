  "elements": {
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "variants": [
        "active",
        "inactive",
        "dialog",
        "tool"
      ],
      "doc": "A window drawn inside a Desktop: navy caption with the app icon, Minimize/Maximize, gap, Close. Window(\"Notepad\", systemImage: \"doc\") { … } · .variant(.inactive | .dialog | .tool)"
    },
    "DialogBody": {
      "role": "vstack",
      "variants": [
        "help"
      ],
      "doc": "Root of a dialog screen: the frame's caption keeps only Close (and ? with .variant(.help)); grey dialog face"
    },
    "PropertySheet": {
      "role": "vstack",
      "defaults": {
        "variant": "help"
      },
      "variants": [
        "help",
        "plain"
      ],
      "doc": "Root of a property-sheet screen (tabs + OK/Cancel/Apply): caption with ? and Close"
    },
    "Desktop": {
      "role": "canvas",
      "doc": "The teal #008080 desktop; place DesktopIcons and Windows with .position(x:y:)"
    },
    "DesktopIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "DesktopIcon(\"My Computer\", systemImage: \"my.computer\") — 32 px icon over a caption; .selected() draws the navy caption with the dotted focus rectangle"
    },
    "Taskbar": {
      "role": "hstack",
      "doc": "The grey taskbar along the bottom: StartButton, TaskbarButton…, Spacer, Tray"
    },
    "StartButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "label": "Start",
        "systemImage": "start"
      },
      "doc": "The raised bold Start button with a neutral glyph; .selected() while the menu is open"
    },
    "TaskbarButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "systemImage": "app"
      },
      "doc": "A window's taskbar button (160 px, icon + caption); .selected() for the active window: pressed and dithered"
    },
    "Tray": {
      "role": "hstack",
      "doc": "The sunken notification area at the right of the taskbar: TrayIcon… Clock"
    },
    "NotificationArea": {
      "role": "hstack",
      "doc": "Alias of Tray"
    },
    "TrayIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "doc": "A 16 px tray icon"
    },
    "Clock": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "content": "4:20 PM"
      },
      "doc": "Taskbar clock"
    },
    "StartMenu": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "title": "Workspace",
        "subtitle": "95"
      },
      "doc": "The Start menu with the vertical side banner: StartMenu(\"Workspace\", subtitle: \"95\") { StartMenuItem… }"
    },
    "StartMenuItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "attrs": {
        "submenu": "chevron",
        "cascade": "chevron"
      },
      "doc": "StartMenuItem(\"Programs\", systemImage: \"programs\", submenu: true) — 32 px icon, ▸ for a cascading menu; .selected() is the navy highlight"
    },
    "CascadeMenu": {
      "role": "menu",
      "doc": "A cascading menu beside the Start menu or a menu bar: CascadeMenu { MenuItem(\"Notepad\", systemImage: \"doc\") }"
    },
    "ContextMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "doc": "Pop-up (right-click) menu, grey with the navy highlight"
    },
    "PopupMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "doc": "A free-standing pop-up menu"
    },
    "DropDownMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "menubar",
        "caret": false,
        "open": true
      },
      "doc": "A menu-bar title with its menu dropped down: MenuBar { DropDownMenu(\"File\") { MenuItem… } MenuBarItem(\"Edit\") }"
    },
    "MenuBar": {
      "role": "toolbar",
      "doc": "A menu bar: MenuBarItem(\"File\")…"
    },
    "MenuBarItem": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "plain"
      },
      "doc": "A menu-bar title; .selected() when its menu is open (navy highlight)"
    },
    "MenuSeparator": {
      "role": "divider",
      "doc": "Etched separator in a menu"
    },
    "ToolBar": {
      "role": "toolbar",
      "doc": "A flat toolbar (the drive combo and 16 px buttons); a grip ridge at its left"
    },
    "ToolBarButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "toolbar",
        "iconOnly": true
      },
      "doc": "A flat 23 × 22 toolbar button, raised on .state(.hover), sunken when .selected()"
    },
    "PaneHeader": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Explorer's raised caption over a pane: PaneHeader(\"All Folders\")"
    },
    "TreeView": {
      "role": "tree",
      "doc": "Folder tree with dotted lines and +/− boxes in a sunken white well"
    },
    "TreeViewItem": {
      "role": "treeitem",
      "params": [
        "label"
      ],
      "doc": "TreeViewItem(\"Windows\", systemImage: \"folder\")"
    },
    "ListView": {
      "role": "table",
      "variants": [
        "details",
        "report"
      ],
      "doc": "Details view: raised column headers, columns:, rows:, selectedRows:"
    },
    "IconView": {
      "role": "grid",
      "doc": "Large Icons view: a grid of FileIcons in a sunken white well"
    },
    "FileIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "variants": [
        "large",
        "small"
      ],
      "doc": "FileIcon(\"Readme.txt\", systemImage: \"doc\") · .variant(.small) puts the name beside a 16 px icon"
    },
    "ListBox": {
      "role": "list",
      "doc": "Single-selection list box with a sunken border"
    },
    "StatusBar": {
      "role": "hstack",
      "doc": "Window status bar of sunken StatusBarPanels with the size grip"
    },
    "StatusBarPanel": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "One sunken status-bar field"
    },
    "TabControl": {
      "role": "tabs",
      "defaults": {
        "placement": "top"
      },
      "doc": "Property-sheet tabs: raised tabs with clipped corners, the selected one 2 px taller"
    },
    "TabPage": {
      "role": "tab",
      "params": [
        "label"
      ],
      "doc": "TabPage(\"General\") { … }"
    },
    "GroupBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "doc": "Etched frame with the caption breaking the top line"
    },
    "Frame": {
      "role": "card",
      "params": [
        "title"
      ],
      "doc": "Alias of GroupBox"
    },
    "PushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "variants": [
        "default",
        "standard"
      ],
      "doc": "75 × 23 push button with the two-pixel bevel; .variant(.default) adds the black outline, .state(.focused) the dotted focus rectangle"
    },
    "DefaultButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default",
        "state": "focused"
      },
      "doc": "The default (Enter) button: black outline and dotted focus rectangle"
    },
    "CheckBox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "13 px sunken white box with the black check: CheckBox(\"Hide files\", checked: true)"
    },
    "OptionButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "Round sunken option button (also RadioButton)"
    },
    "RadioButtonList": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "RadioButtonList(\"View\", items: […], selection:)"
    },
    "StaticText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "A static text control"
    },
    "TextBox": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "Sunken white edit control"
    },
    "PasswordBox": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "password"
      },
      "doc": "Password edit (asterisks)"
    },
    "MultilineTextBox": {
      "role": "textfield",
      "params": [
        "text"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "doc": "Multi-line edit control"
    },
    "ComboBox": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "Drop-down combo with the raised arrow button: ComboBox(items:, selection:)"
    },
    "DropDownList": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "Drop-down list (not editable)"
    },
    "ScrollBar": {
      "role": "slider",
      "defaults": {
        "variant": "scrollbar",
        "orientation": "horizontal"
      },
      "doc": "ScrollBar(value: 0.3, orientation: .vertical) — dithered track, arrow buttons and a square thumb"
    },
    "ProgressBar": {
      "role": "progress",
      "params": [
        "label"
      ],
      "variants": [
        "blocks",
        "smooth"
      ],
      "doc": "Sunken progress bar of navy blocks: ProgressBar(value: 0.6)"
    },
    "TrackBar": {
      "role": "slider",
      "doc": "Trackbar with the pointed raised thumb: TrackBar(value: 3, in: 0...10, ticks: 10)"
    },
    "UpDown": {
      "role": "stepper",
      "params": [
        "label"
      ],
      "doc": "Spin box: UpDown(\"Copies\", value: 2)"
    },
    "DateTimePicker": {
      "role": "datepicker",
      "params": [
        "label"
      ],
      "doc": "Date field with the drop-down arrow"
    },
    "MonthCalendar": {
      "role": "calendar",
      "doc": "Month calendar (Date/Time Properties)"
    },
    "MessageBox": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "systemImage": "info.circle",
        "severity": "info"
      },
      "variants": [
        "information",
        "warning",
        "error",
        "question"
      ],
      "attrs": {
        "type": "severity",
        "style": "severity"
      },
      "doc": "Modal message box: MessageBox(\"Confirm File Delete\", message: \"…\", severity: .question, buttons: [\"Yes\", \"No\"], primary: \"Yes\") — the icon is drawn from severity"
    },
    "Wizard": {
      "role": "card",
      "params": [
        "title"
      ],
      "doc": "Wizard page: the picture panel at left (systemImage:), title and body at right, actions: { < Back · Next > · Cancel } under an etched line"
    },
    "ToolTip": {
