    "settings": "gear",
    "find": "search",
    "help": "questionmark.circle",
    "run": "play",
    "shut.down": "power",
    "suspend": "moon",
    "notepad": "doc",
    "wordpad": "pencil",
    "paint": "photo",
    "calculator": "number",
    "msdos": "square",
    "control.panel": "slider.horizontal.3",
    "printers": "printer",
    "fonts": "doc",
    "mouse": "hand.thumbsup",
    "keyboard": "square.grid.3x3",
    "modems": "phone",
    "sounds": "speaker",
    "multimedia": "play",
    "passwords": "key",
    "regional": "globe",
    "date.time": "clock",
    "system": "app",
    "add.remove": "archivebox",
    "add.hardware": "wrench",
    "accessibility": "person.circle",
    "mail": "envelope",
    "floppy": "square",
    "drive": "archivebox",
    "cdrom": "circle",
    "accessories": "briefcase",
    "games": "star",
    "volume": "speaker"
  },
  "modifiers": {
    "isChecked": {
      "attr": "checked"
    },
    "defaultButton": {
      "attr": "variant",
      "value": "default"
    }
  },
