  "fonts": {
    "system": "headline",
    "systemFont": "headline",
    "application": "body",
    "applicationFont": "body",
    "small": "footnote",
    "smallSystem": "footnote",
    "smallSystemFont": "footnote",
    "label": "caption",
    "windowTitle": "headline",
    "emphasizedSystem": "headline",
    "views": "footnote"
  },
  "icons": {
    "Finder": "app",
    "SimpleText": "doc",
    "Folder": "folder",
    "Document": "doc",
    "Trash": "trash",
    "Sherlock": "magnifyingglass",
    "Find": "magnifyingglass",
    "Print": "printer",
    "Sound": "speaker",
    "Volume": "speaker",
    "Monitor": "app",
    "Monitors": "app",
    "AppleTalk": "link",
    "Network": "globe",
    "Internet": "globe",
    "Memory": "cube",
    "Date": "clock",
    "Time": "clock",
    "Help": "questionmark.circle",
    "Battery": "battery",
    "CD": "circle",
    "Keychain": "key",
    "Users": "person.2",
    "Mouse": "app",
    "Keyboard": "app",
    "Appearance": "sparkles",
    "Extensions": "cube",
    "Control Panels": "slider.horizontal.3",
    "ControlPanels": "slider.horizontal.3"
  },
  "modifiers": {
    "windowKind": {
      "attr": "variant"
    },
    "inactive": {
      "attr": "state",
      "value": "inactive"
    },
    "collapsed": {
      "attr": "state",
      "value": "collapsed"
    },
    "defaultButton": {
      "attr": "variant",
      "value": "default"
    },
    "highlighted": {
      "attr": "state",
      "value": "hover"
    }
  },
  "elements": {
    "Desktop": {
      "role": "canvas",
      "doc": "The Finder desktop (pattern background). Put a MenuBar first, then place windows and icons with .position(x:y:)"
    },
    "MenuBar": {
      "role": "toolbar",
      "doc": "The menu bar: AppleMenu(), Menu(\"File\") …, Spacer(), Text(clock), ApplicationMenu(\"Finder\")"
    },
    "AppleMenu": {
      "role": "menu",
      "defaults": {
        "icon": "circle",
        "caret": false
      },
      "doc": "The Apple menu at the left of the menu bar (a neutral rainbow glyph); open: true shows its items"
    },
    "ApplicationMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "icon": "app",
        "caret": false
      },
      "doc": "The Application menu at the right of the menu bar: icon and name of the frontmost application"
    },
    "MenuTitle": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "caret": false
      },
      "doc": "A menu bar title; MenuTitle(\"File\", open: true) { MenuItem(…) } shows its menu"
    },
    "PullDownMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "caret": false
      },
      "doc": "A pull-down menu (menu bar title or bevel button menu)"
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "A menu item. shortcut: \"⌘N\", checked:, .disabled(), .highlighted() (the item under the pointer)"
    },
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "document"
      },
      "variants": [
        "document",
        "dialog",
        "movableModal",
        "alert",
        "utility",
        "floating",
        "plain"
      ],
      "doc": "A Platinum window: striped title bar, close box, zoom and collapse boxes. .inactive() greys the title bar"
    },
    "DocumentWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "document"
      },
      "doc": "A document window"
    },
    "FloatingWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "utility"
      },
      "doc": "A floating palette / utility window with a thin title bar"
    },
    "ModalDialog": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "dialog"
      },
      "doc": "A modal dialog drawn in place (no title bar); use Dialog for a centred overlay"
    },
    "MovableModalDialog": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "movableModal"
      },
      "doc": "A movable modal dialog: title bar without close box"
    },
    "Finder": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "document"
      },
      "doc": "A Finder window; put an InfoBar, then FinderIcon/Folder… (icon view) or a FinderList (list view) inside"
    },
    "InfoBar": {
      "role": "labeled",
      "params": [
        "label",
        "value"
      ],
      "doc": "The Finder window header: InfoBar(\"12 items\", \"1.2 GB available\")"
    },
    "FinderList": {
      "role": "table",
      "doc": "Finder list view: columns: [\"Name\", \"Date Modified\", \"Size\", \"Kind\"], rows:, sortColumn:, selectedRows:"
    },
    "ListView": {
      "role": "list",
      "doc": "A list box (white, inset frame); Row/ListItem children, .selected() highlights"
    },
    "FinderIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "A Finder / desktop icon with its name below. icon: any icon name; .selected() inverts the name"
    },
    "Folder": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "icon": "folder",
        "kind": "folder"
      },
      "doc": "A folder icon"
    },
    "Disk": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "icon": "archivebox",
        "kind": "disk"
      },
      "doc": "A hard disk icon"
    },
    "DocumentIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "icon": "doc",
        "kind": "document"
      },
      "doc": "A document icon"
    },
    "ApplicationIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "icon": "app",
        "kind": "application"
      },
      "doc": "An application icon (the generic diamond)"
    },
    "TrashIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "title": "Trash",
        "icon": "trash",
        "kind": "trash"
      },
      "doc": "The Trash"
    },
    "Button": {
      "role": "button",
      "params": [
        "label"
      ],
      "variants": [
        "push",
        "default",
        "bevel"
      ],
      "doc": "A Platinum push button. .variant(.default) (or DefaultButton) draws the default ring"
    },
    "PushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "doc": "A Platinum push button"
    },
    "DefaultButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "doc": "The default push button with its thick outline (Return activates it)"
    },
    "BevelButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "bevel"
      },
      "doc": "A square bevel button (toolbar-style); icon:, .selected() for the pressed state"
    },
    "CheckBox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "A Platinum check box; checked: true | .mixed"
    },
    "RadioButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "A Platinum radio button"
    },
    "RadioGroup": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "RadioGroup(\"Size\", items: […], selection:)"
    },
    "PopupMenu": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "A popup menu button with the double arrow; PopupMenu(\"Font:\", items: […], selection:, open:)"
    },
    "TextField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "An edit-text field with the inset frame; .state(.focused) draws the focus ring"
    },
    "EditText": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "An edit-text field (Toolbox name)"
    },
    "PasswordField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "password"
      },
      "doc": "A password field (bullets)"
    },
    "SearchField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "search"
      },
      "doc": "A Sherlock-style search field"
    },
    "Slider": {
      "role": "slider",
      "doc": "A Platinum slider with the pointed thumb; Slider(\"Volume:\", value: 0.4, ticks: 5)",
      "params": [
        "label"
      ]
    },
    "LittleArrows": {
      "role": "stepper",
      "params": [
        "label"
      ],
      "doc": "The little up/down arrows control beside a number field"
    },
    "ProgressBar": {
      "role": "progress",
      "params": [
        "label"
      ],
      "doc": "A progress bar; value: 0…1, or no value for the (static) blue barber pole"
    },
    "AsyncArrows": {
      "role": "progress",
      "defaults": {
        "kind": "circular"
      },
      "doc": "The chasing-arrows busy indicator"
    },
    "Tabs": {
      "role": "tabs",
      "params": [
        "items"
      ],
      "defaults": {
        "placement": "top"
      },
      "doc": "Platinum tab control (as in the Appearance control panel); Tab(\"Fonts\") { … } children"
    },
    "TabControl": {
      "role": "tabs",
      "params": [
        "items"
      ],
      "defaults": {
        "placement": "top"
      },
      "doc": "Platinum tab control (Toolbox name)"
    },
    "DisclosureTriangle": {
      "role": "accordion",
      "params": [
        "title"
      ],
      "doc": "A disclosure triangle with its label; expanded: true shows the content"
    },
    "GroupBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "group"
      },
      "doc": "A primary group box (etched frame, title on the frame)"
    },
    "SecondaryGroupBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "secondary"
      },
      "doc": "A secondary group box (lighter etched frame)"
    },
    "Separator": {
      "role": "divider",
      "doc": "An etched separator line"
    },
    "ScrollArea": {
      "role": "scroll",
      "variants": [
        "both",
        "vertical",
        "horizontal",
        "none"
      ],
      "defaults": {
        "variant": "both"
      },
      "doc": "A scrolling content area with Platinum scroll bars (arrows together at the bottom / right)"
    },
    "Alert": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "exclamationmark.triangle",
        "severity": "caution"
      },
      "variants": [
        "alert"
      ],
      "doc": "A modal alert with the Stop / Note / Caution icon: severity: .stop | .note | .caution; buttons:, primary:"
    },
    "Dialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "dialog"
      },
      "doc": "A centred modal dialog (Mac OS 9 has no sheets)"
    },
    "ControlPanel": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "panel"
      },
      "doc": "A control panel window (platinum body); combine with Tabs, GroupBox, PopupMenu …"
    },
    "ControlStrip": {
      "role": "toolbar",
      "doc": "The Control Strip: ControlStripModule children; place at the bottom-left of the Desktop"
    },
    "ControlStripModule": {
      "role": "button",
      "params": [
        "icon"
      ],
      "defaults": {
        "iconOnly": true,
        "dropdown": true
      },
      "doc": "One Control Strip module (icon + popup arrow)"
    },
    "Balloon": {
      "role": "tooltip",
      "params": [
        "text"
      ],
      "doc": "Balloon help: Balloon(\"Click to empty the Trash.\") { target view }; placement:"
    },
    "Toolbar": {
      "role": "toolbar",
      "doc": "A window toolbar of BevelButtons (application-drawn, platinum)"
    },
    "ListItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "doc": "A list row"
    },
    "StickyNote": {
      "role": "stickynote",
      "params": [
        "text"
      ],
      "doc": "A Stickies note"
    }
  }
}