{
  "id": "macos9",
  "name": "Mac OS 9 (Platinum)",
  "framework": "Mac OS 8 / 9 Platinum appearance (Appearance Manager, 1997–2001)",
  "version": "Mac OS 9.2",
  "modules": [
    "MacOS9",
    "Platinum",
    "MacOS8"
  ],
  "device": "desktop",
  "chrome": {
    "desktop": "window",
    "wide": "window",
    "screen": "none",
    "screen-large": "none",
    "tablet": "window",
    "phone": "none"
  },
  "sizes": {
    "desktop": [
      640,
      480
    ],
    "wide": [
      800,
      600
    ],
    "screen": [
      800,
      600
    ],
    "screen-large": [
      1024,
      768
    ]
  },
