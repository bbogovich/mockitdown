  "elements": {
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "variants": [
        "active",
        "inactive",
        "dialog",
        "tool"
      ],
      "doc": "An Aero glass window drawn inside a Desktop: Window(\"Pictures\", systemImage: \"photo\") { … } · .variant(.inactive | .dialog | .tool)"
    },
    "DialogBody": {
      "role": "vstack",
      "variants": [
        "help"
      ],
      "doc": "Root of a dialog screen: the frame keeps only Close (and ? with .variant(.help))"
    },
    "Desktop": {
      "role": "canvas",
      "doc": "The desktop with an aurora-like wallpaper; place windows, icons and gadgets with .position(x:y:)"
    },
    "DesktopIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "DesktopIcon(\"Computer\", systemImage: \"computer\") — 48 px icon, white label; .selected()"
    },
    "Taskbar": {
      "role": "hstack",
      "doc": "The black glass taskbar: StartOrb, QuickLaunch, TaskbarButton…, NotificationArea"
    },
    "StartOrb": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "systemImage": "flag"
      },
      "doc": "The round glossy Start orb with a neutral glyph; .selected() while the menu is open"
    },
    "StartButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "systemImage": "flag"
      },
      "doc": "Alias of StartOrb"
    },
    "QuickLaunch": {
      "role": "hstack",
      "doc": "Quick Launch toolbar"
    },
    "TaskbarButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "doc": "A window's glass taskbar button; .selected() for the active window"
    },
    "NotificationArea": {
      "role": "hstack",
      "doc": "Tray at the right of the taskbar: TrayIcon… Clock"
    },
    "TrayIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "doc": "A 16 px notification icon"
    },
    "Clock": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "content": "10:42 AM"
      },
      "doc": "Taskbar clock"
    },
    "Balloon": {
      "role": "tooltip",
      "params": [
        "text"
      ],
      "defaults": {
        "placement": "top"
      },
      "doc": "Notification balloon pointing at its child: Balloon(\"Title\", message: \"…\") { TrayIcon(\"shield\") }"
    },
    "StartMenu": {
      "role": "card",
      "params": [
        "title"
      ],
      "doc": "Glass Start menu: StartMenu(\"Alex\", avatar:, avatarImage:) { StartMenuPrograms{…} StartMenuPlaces{…} }"
    },
    "StartMenuPrograms": {
      "role": "vstack",
      "doc": "The white left pane (programs, All Programs, Start Search)"
    },
    "StartMenuPlaces": {
      "role": "vstack",
      "doc": "The glass right pane (user folders, Control Panel, power buttons)"
    },
    "StartMenuItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "doc": "StartMenuItem(\"Internet\", subtitle: \"Web browser\", systemImage: \"globe\")"
    },
    "AllProgramsButton": {
      "role": "button",
      "params": [
