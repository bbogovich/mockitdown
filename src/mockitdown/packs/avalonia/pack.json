  "elements": {
    "Window": {
      "role": "vstack",
      "defaults": {
        "spacing": 0,
        "alignment": "stretch"
      },
      "doc": "Window { … } — the top-level window's content (title and decorations come from the fence's title/chrome)"
    },
    "UserControl": {
      "role": "vstack",
      "defaults": {
        "spacing": 0,
        "alignment": "stretch"
      },
      "doc": "A reusable view's root"
    },
    "ContentControl": {
      "role": "group",
      "doc": "Hosts one piece of content"
    },
    "ContentPresenter": {
      "role": "group"
    },
    "Decorator": {
      "role": "group"
    },
    "TransitioningContentControl": {
      "role": "group",
      "doc": "Shows the current page (transitions are static)"
    },
    "HeaderedContentControl": {
      "role": "section",
      "params": [
        "header"
      ],
      "attrs": {
        "header": "title"
      },
      "doc": "HeaderedContentControl(\"Header\") { content }"
    },
    "StackPanel": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      },
      "doc": "StackPanel(spacing: 8, orientation: .horizontal) { … } — vertical by default, children stretch across"
    },
    "VirtualizingStackPanel": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      }
    },
    "ReversibleStackPanel": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      }
    },
    "DockPanel": {
      "role": "vstack",
      "defaults": {
        "spacing": 0,
        "alignment": "stretch"
      },
      "doc": "DockPanel { top docks… ; fill } — docked children in order; put a left/right dock and the fill in an HStack"
    },
    "Grid": {
      "role": "grid",
      "doc": "Grid(columns: 3, spacing: 12) { … } — column count (ColumnDefinitions as a count), or GridRow children"
    },
    "UniformGrid": {
      "role": "grid",
      "doc": "UniformGrid(columns: n) { … }"
    },
    "WrapPanel": {
      "role": "hstack",
      "defaults": {
        "wrap": true
      },
      "doc": "Children left to right, wrapping"
    },
    "Canvas": {
      "role": "canvas",
      "doc": "Absolute positioning: place children with .position(x:y:) (Canvas.Left/Top)"
    },
    "Panel": {
      "role": "zstack",
      "doc": "Children overlap (Panel stacks them on top of each other)"
    },
    "RelativePanel": {
      "role": "zstack"
    },
    "Viewbox": {
      "role": "zstack",
      "doc": "Scales its child (static)"
    },
    "LayoutTransformControl": {
      "role": "group"
    },
    "Border": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      },
      "doc": "A decorator: style with .padding / .background / .cornerRadius / .border"
    },
    "ScrollViewer": {
      "role": "scroll",
      "params": [
        "axes"
      ],
      "doc": "Scrolling region (static; Fluent overlay scroll bars are hidden at rest)"
    },
    "ItemsControl": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      },
      "doc": "Repeats an item template: use ForEach inside"
    },
    "ItemsRepeater": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      },
      "doc": "Avalonia.Controls.ItemsRepeater: ForEach inside; .orientation(.horizontal) for a row"
    },
    "RefreshContainer": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch"
      },
      "doc": "Pull-to-refresh host; refreshing: true shows the visualizer"
    },
    "RefreshVisualizer": {
      "role": "progress",
      "defaults": {
        "kind": "circular"
      },
      "doc": "The pull-to-refresh spinner"
    },
    "Carousel": {
      "role": "zstack",
      "doc": "Carousel { current item } — one item at a time"
    },
    "SplitView": {
      "role": "split",
      "defaults": {
        "variant": "inline"
      },
      "variants": [
        "inline",
        "compactInline",
        "overlay",
        "compactOverlay"
      ],
      "doc": "SplitView(displayMode: .inline) { pane } content: { … } — the pane sits on PaneBackground"
    },
    "GridSplitter": {
      "role": "divider",
      "doc": "A draggable divider between grid cells"
    },
    "Separator": {
      "role": "divider",
      "doc": "A horizontal rule (menus, stack panels)"
    },
    "TextBlock": {
      "role": "text",
      "params": [
        "content"
      ],
      "attrs": {
        "text": "content",
        "classes": "font",
        "theme": "font"
      },
      "doc": "TextBlock(\"Hi\", classes: \"h2\") — Text; .font(.title2), FontWeight via .bold()"
    },
    "SelectableTextBlock": {
      "role": "text",
      "params": [
        "content"
      ],
      "attrs": {
        "text": "content",
        "classes": "font"
      },
      "doc": "Text the user can select and copy"
    },
    "Label": {
      "role": "text",
      "params": [
        "content"
      ],
      "attrs": {
        "text": "content",
        "target": "for"
      },
      "doc": "Label(\"Name:\") — a ContentControl caption for an input (Target:)"
    },
    "AccessText": {
      "role": "text",
      "params": [
        "content"
      ],
      "attrs": {
        "text": "content"
      }
    },
    "Run": {
      "role": "text",
      "params": [
        "content"
      ],
      "attrs": {
        "text": "content"
      }
    },
    "PathIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "attrs": {
        "data": "name"
      },
      "doc": "PathIcon(\"Settings\") — a geometry icon (FluentIcons names work)"
    },
    "SymbolIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "attrs": {
        "symbol": "name"
      },
      "doc": "FluentIcons.Avalonia SymbolIcon(symbol: \"Home\")"
    },
    "Image": {
      "role": "image",
      "params": [
        "name"
      ],
      "attrs": {
        "source": "name"
      },
      "doc": "Image(\"assets/images/photo-1.svg\") or Image(source:)"
    },
    "Ellipse": {
      "role": "shape",
      "defaults": {
        "shape": "ellipse"
      }
    },
    "Rectangle": {
      "role": "shape",
      "defaults": {
        "shape": "rectangle"
      }
    },
    "Path": {
      "role": "shape",
      "defaults": {
        "shape": "rectangle"
      }
    },
    "Button": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "variants": [
        "default",
        "accent",
        "transparent"
      ],
      "attrs": {
        "content": "label"
      },
      "doc": "Button(\"Save\", icon:) · classes: \"accent\" (Classes=\"accent\") for the accent button"
    },
    "RepeatButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "attrs": {
        "content": "label"
      },
      "doc": "Fires repeatedly while pressed"
    },
    "ToggleButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "attrs": {
        "content": "label",
        "isChecked": "selected",
        "checked": "selected"
      },
      "doc": "ToggleButton(\"Bold\", isChecked: true) — checked uses the accent fill"
    },
    "SplitButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default",
        "split": true
      },
      "attrs": {
        "content": "label"
      },
      "doc": "Primary part + chevron that opens a Flyout"
    },
    "ToggleSplitButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default",
        "split": true
      },
      "attrs": {
        "content": "label",
        "isChecked": "selected",
        "checked": "selected"
      },
      "doc": "SplitButton whose primary part toggles (isChecked:)"
    },
    "DropDownButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default",
        "dropdown": true
