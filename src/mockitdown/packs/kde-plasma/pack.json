  "attrs": {
    "placeholderText": "placeholder", "iconName": "icon", "explanation": "description",
    "showCloseButton": "closable", "highlighted": "emphasis", "formLabel": "label"
  },
  "modifiers": {
    "placeholderText": {"attr": "placeholder"},
    "highlighted": {"attr": "emphasis"},
    "flat": {"attr": "shape", "value": "flat"},
    "checked": {"attr": "selected"},
    "checkable": {"attr": "checkable"},
    "level": {"attr": "level"},
    "displayMode": {"attr": "variant"},
    "inlineMessageType": {"attr": "severity"},
    "formLabel": {"attr": "label"}
  },
  "elements": {
    "ApplicationWindow": {"role": "hstack", "defaults": {"alignment": "top"},
      "doc": "Kirigami.ApplicationWindow { GlobalDrawer { … } PageRow { Page… } } — drawer and page stack side by side, filling the window"},
    "MainWindow": {"role": "vstack", "defaults": {"alignment": "stretch"},
      "doc": "QMainWindow / KXmlGuiWindow: MenuBar, ToolBar, central widget and StatusBar stacked, filling the window"},
    "PageRow": {"role": "split",
      "doc": "Kirigami PageRow (pageStack): pages side by side as columns — the first ones 360 px wide, the last fills"},
    "Page": {"role": "navstack", "params": ["title"], "defaults": {"titleDisplayMode": "inline"},
      "doc": "Kirigami.Page(\"Title\") { … } — title on the left of the page header; .toolbar { Action… } for page actions"},
    "ScrollablePage": {"role": "navstack", "params": ["title"], "defaults": {"titleDisplayMode": "inline"},
      "doc": "Kirigami.ScrollablePage(\"Title\") { … } — a Page whose content scrolls"},
    "FormCardPage": {"role": "navstack", "params": ["title"], "defaults": {"titleDisplayMode": "inline"},
      "doc": "Kirigami Addons FormCardPage(\"Settings\") { FormHeader … FormCard { … } }"},
    "KCM": {"role": "navstack", "params": ["title"], "defaults": {"titleDisplayMode": "inline"},
      "doc": "A System Settings module page: KCM(\"Mouse\") { FormLayout { … } } · .toolbar { ToolbarItem(placement: .bottomBar) { Help / Defaults / Reset / Apply } }"},
    "ColumnLayout": {"role": "vstack", "defaults": {"alignment": "leading"}, "doc": "QtQuick.Layouts ColumnLayout(spacing: 6)"},
    "RowLayout": {"role": "hstack", "doc": "QtQuick.Layouts RowLayout(spacing: 6)"},
    "GridLayout": {"role": "grid", "doc": "GridLayout(columns: 3) { … }"},
    "FlexColumn": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Kirigami.FlexColumn — a centred column of limited width"},
    "ScrollView": {"role": "scroll", "params": ["axes"], "doc": "QQC2 ScrollView (static)"},
    "Frame": {"role": "card", "params": ["title"], "defaults": {"variant": "frame"}, "doc": "QQC2 Frame / QFrame: a bordered box"},
    "GroupBox": {"role": "card", "params": ["title"], "defaults": {"variant": "groupbox"}, "doc": "GroupBox(\"Title\") { … } — QGroupBox with its title above the frame"},
    "Splitter": {"role": "split", "doc": "QSplitter / SplitView: children side by side with a handle; columnWidths: [240, 600]"},
    "SplitView": {"role": "split", "doc": "QQC2 SplitView"},
    "DockWidget": {"role": "card", "params": ["title"], "defaults": {"variant": "dock"},
      "doc": "QDockWidget / Kate tool view: a titled panel (Dolphin Information, Kate Projects…)"},

    "Heading": {"role": "text", "params": ["content"], "defaults": {"level": 1},
      "doc": "Kirigami.Heading(\"Title\", level: 1…5) — 1.35×, 1.2×, 1.15×, 1.1×, 1× the default font; type: .primary is bold"},
    "SelectableLabel": {"role": "text", "params": ["content"], "doc": "Kirigami.SelectableLabel"},
    "UrlButton": {"role": "link", "params": ["label", "destination"], "doc": "Kirigami.UrlButton(\"kde.org\")"},
    "LinkButton": {"role": "link", "params": ["label", "destination"], "doc": "Kirigami.LinkButton(\"Learn more\")"},
    "Avatar": {"role": "avatar", "params": ["name"], "doc": "Kirigami.Avatar(\"Ana Diaz\", image:, size: .small|.large)"},
    "Chip": {"role": "chip", "params": ["label"], "defaults": {"checkmark": false}, "attrs": {"text": "label", "checked": "selected"}, "doc": "Kirigami.Chip(\"Tag\", closable: true, checked: true)"},
    "Separator": {"role": "divider", "doc": "Kirigami.Separator — a 1 px line in the frame colour"},

    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "normal"},
      "variants": ["normal", "flat", "highlighted", "default"],
      "attrs": {"text": "label", "flat": "shape", "checked": "selected"},
      "doc": "Button(\"Apply\", icon: \"dialog-ok-apply\") · highlighted: true for the default button · flat: true · checked: true"},
    "ToolButton": {"role": "button", "params": ["label"], "defaults": {"variant": "tool"},
      "attrs": {"text": "label", "checked": "selected"},
      "doc": "ToolButton(\"Split\", icon: \"view-split-left-right\") — flat until hovered; checked: true"},
    "Action": {"role": "button", "params": ["label"], "defaults": {"variant": "tool"},
      "attrs": {"text": "label", "checked": "selected"},
      "doc": "Kirigami.Action(\"Add\", icon: \"list-add\") — shown as a tool button in toolbars and page headers"},
    "ContextualHelpButton": {"role": "button", "params": ["label"], "defaults": {"variant": "tool", "icon": "help-contents", "iconOnly": true},
      "doc": "Kirigami.ContextualHelpButton — a (?) tool button"},
    "RoundButton": {"role": "button", "params": ["icon"], "defaults": {"variant": "round", "iconOnly": true}, "doc": "QQC2 RoundButton(icon:)"},
    "ActionButton": {"role": "fab", "params": ["icon"], "doc": "Kirigami floating action button (Plasma Mobile pages)"},
    "ToolBar": {"role": "toolbar", "doc": "ToolBar { ToolButton… } — the main window toolbar, merged with the title bar in Plasma 6"},
    "ActionToolBar": {"role": "toolbar", "defaults": {"variant": "actions"}, "doc": "Kirigami.ActionToolBar { Action… }"},
    "MenuBar": {"role": "toolbar", "defaults": {"variant": "menubar"}, "doc": "MenuBar { MenuBarItem(\"File\") … }"},
    "MenuBarItem": {"role": "menu", "params": ["label"], "defaults": {"caret": false, "variant": "menubar"}, "doc": "MenuBarItem(\"Edit\", open: true) { MenuItem… }"},
    "StatusBar": {"role": "toolbar", "defaults": {"variant": "statusbar"},
      "doc": "QStatusBar (Dolphin, Kate): small text on the left, zoom slider and free-space bar on the right"},
    "HamburgerMenu": {"role": "menu", "params": ["label"], "defaults": {"icon": "application-menu", "variant": "tool"},
      "doc": "The KHamburgerMenu button at the end of the toolbar (open: true shows the menu)"},

    "CheckBox": {"role": "checkbox", "params": ["label"], "attrs": {"text": "label", "checkState": "checked"},
      "doc": "CheckBox(\"Show hidden files\", checked: true | .indeterminate)"},
    "RadioButton": {"role": "radio", "params": ["label"], "attrs": {"text": "label"}, "doc": "RadioButton(\"Single-click\", checked: true)"},
    "ButtonGroup": {"role": "radiogroup", "params": ["label"], "doc": "ButtonGroup(items: [\"A\", \"B\"], selection: \"A\") — exclusive radio buttons"},
    "Switch": {"role": "toggle", "params": ["label"], "attrs": {"text": "label", "checked": "isOn"},
      "doc": "Switch(\"Enable\", checked: true) — the indicator sits before the text"},
    "ComboBox": {"role": "select", "params": ["label"], "attrs": {"model": "items", "currentText": "selection", "currentIndex": "selection"},
      "doc": "ComboBox(items: [\"Icons\", \"Details\"], selection: \"Icons\", open: true) — label: is the FormLayout label"},
    "TextField": {"role": "textfield", "params": ["placeholder"], "doc": "TextField(\"Placeholder\", text:, label:) — label: is the FormLayout label"},
    "ActionTextField": {"role": "textfield", "params": ["placeholder"], "defaults": {"clearButton": true}, "doc": "Kirigami.ActionTextField with inline actions"},
    "SearchField": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search", "placeholder": "Search…"}, "doc": "Kirigami.SearchField(text:)"},
    "PasswordField": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "password", "reveal": true}, "doc": "Kirigami.PasswordField(text: \"secret\")"},
    "TextArea": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline"}, "doc": "TextArea(text:, rows: 4)"},
    "SpinBox": {"role": "textfield", "params": ["value"], "defaults": {"kind": "number", "trailingIcon": "chevron.up.down"},
      "doc": "SpinBox(value: 5, suffix: \" px\") — up/down arrows on the right"},
