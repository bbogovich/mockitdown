{
  "id": "base",
  "name": "Wireframe",
  "framework": "Neutral wireframe (the portable core every pack extends)",
  "version": "1",
  "modules": ["Wireframe", "Mockitdown"],
  "device": "desktop",
  "chrome": {"phone": "none", "tablet": "none", "desktop": "none"},
  "tokens": {
    "light": {
      "bg": "#ffffff", "surface": "#ffffff", "surface-2": "#f4f5f7", "surface-3": "#e9ebef",
      "fg": "#1d2129", "fg-2": "#5b6270", "fg-3": "#8d93a0", "border": "#d5d9e0", "divider": "#e4e7ec",
      "accent": "#3b6fd8", "on-accent": "#ffffff", "accent-soft": "#e6eefc",
      "danger": "#d0342c", "warning": "#c77700", "success": "#2e8540", "info": "#2f6fdc",
      "field-bg": "#ffffff", "field-border": "#c4c9d2", "scrim": "rgb(15 18 24 / 0.36)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / 0.08)", "shadow-2": "0 4px 12px rgb(0 0 0 / 0.12)",
      "shadow-3": "0 12px 32px rgb(0 0 0 / 0.18)",
      "radius-s": "4px", "radius-m": "6px", "radius-l": "10px", "radius-xl": "16px", "radius-pill": "999px",
      "font": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "font-size": "14px", "line-height": "1.4", "icon-stroke": "1.75", "icon-size": "18px",
      "control-h": "34px", "gap": "8px", "pad": "12px",
      "chrome-bg": "#eceef1", "chrome-fg": "#1d2129",
      "fs-display": "40px", "fw-display": "700", "fs-largeTitle": "32px", "fw-largeTitle": "700",
      "fs-title": "26px", "fw-title": "700", "fs-title2": "22px", "fw-title2": "700",
      "fs-title3": "19px", "fw-title3": "600", "fs-headline": "15px", "fw-headline": "600",
      "fs-subheadline": "14px", "fw-subheadline": "400", "fs-body": "14px", "fw-body": "400",
      "fs-callout": "14px", "fw-callout": "400", "fs-footnote": "12px", "fw-footnote": "400",
      "fs-caption": "11px", "fw-caption": "400", "fs-caption2": "10px", "fw-caption2": "400",
      "fs-overline": "11px", "fw-overline": "600",
      "color-red": "#e5484d", "color-orange": "#f76b15", "color-yellow": "#f5c400", "color-green": "#30a46c",
      "color-mint": "#3dd6b5", "color-teal": "#12a594", "color-cyan": "#05a2c2", "color-blue": "#0090ff",
      "color-indigo": "#3e63dd", "color-purple": "#8e4ec6", "color-pink": "#d6409f", "color-brown": "#ad7f58",
      "color-gray": "#8b8d98",
      "chart-1": "#3b6fd8", "chart-2": "#30a46c", "chart-3": "#f76b15", "chart-4": "#8e4ec6",
      "chart-5": "#e5484d", "chart-6": "#12a594"
    },
    "dark": {
      "bg": "#16181d", "surface": "#1e2128", "surface-2": "#252932", "surface-3": "#2e333d",
      "fg": "#eceef2", "fg-2": "#a7adb9", "fg-3": "#757c8a", "border": "#3a404c", "divider": "#2f343e",
      "accent": "#6d9bf2", "on-accent": "#0b1220", "accent-soft": "#243552",
      "danger": "#f2665f", "warning": "#f0a43a", "success": "#4cc26e", "info": "#6d9bf2",
      "field-bg": "#1b1e24", "field-border": "#464c59", "scrim": "rgb(0 0 0 / 0.55)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / 0.5)", "shadow-2": "0 4px 12px rgb(0 0 0 / 0.5)",
      "shadow-3": "0 12px 32px rgb(0 0 0 / 0.6)", "chrome-bg": "#23262d", "chrome-fg": "#eceef2"
    }
  },
  "modifiers": {
    "variant": {"attr": "variant"},
    "size": {"attr": "size"},
    "severity": {"attr": "severity"},
    "state": {"attr": "state"},
    "selected": {"attr": "selected"},
    "disabled": {"attr": "disabled"},
    "badge": {"attr": "badge"},
    "elevation": {"attr": "elevation"},
    "density": {"attr": "density"},
    "expanded": {"attr": "expanded"},
    "open": {"attr": "open"},
    "color": {"attr": "color"},
    "buttonStyle": {"attr": "variant"},
    "listStyle": {"attr": "variant"},
    "pickerStyle": {"attr": "variant"},
    "toggleStyle": {"attr": "variant"},
    "textFieldStyle": {"attr": "variant"},
    "datePickerStyle": {"attr": "variant"},
    "tabViewStyle": {"attr": "variant"},
    "progressViewStyle": {"attr": "variant"},
    "gaugeStyle": {"attr": "variant"},
    "menuStyle": {"attr": "variant"},
    "formStyle": {"attr": "variant"},
    "groupBoxStyle": {"attr": "variant"},
    "navigationSplitViewStyle": {"attr": "variant"},
    "labelStyle": {"attr": "labelStyle"},
    "controlSize": {"attr": "size"},
    "buttonBorderShape": {"attr": "shape"}
  },
  "elements": {
    "VStack": {"role": "vstack", "doc": "Vertical stack. spacing:, alignment: .leading|.center|.trailing"},
    "HStack": {"role": "hstack", "doc": "Horizontal stack. spacing:, alignment: .top|.center|.bottom"},
    "ZStack": {"role": "zstack", "doc": "Overlapping layers. alignment:"},
    "LazyVStack": {"role": "vstack"},
    "LazyHStack": {"role": "hstack"},
    "Grid": {"role": "grid", "doc": "Grid of GridRow children, or columns: n"},
    "GridRow": {"role": "gridrow"},
    "LazyVGrid": {"role": "grid", "doc": "columns: [GridItem(.flexible()), …] or a count"},
    "LazyHGrid": {"role": "grid"},
    "ScrollView": {"role": "scroll", "params": ["axes"]},
    "Group": {"role": "group"},
    "Spacer": {"role": "spacer"},
    "Divider": {"role": "divider"},
    "Rectangle": {"role": "shape", "defaults": {"shape": "rectangle"}},
    "RoundedRectangle": {"role": "shape", "defaults": {"shape": "rounded"}},
    "Circle": {"role": "shape", "defaults": {"shape": "circle"}},
    "Capsule": {"role": "shape", "defaults": {"shape": "capsule"}},
    "Ellipse": {"role": "shape", "defaults": {"shape": "ellipse"}},
    "Color": {"role": "color", "params": ["color"]},

    "Text": {"role": "text", "params": ["content"], "doc": "Text with **bold**, *italic*, `code` Markdown"},
    "Label": {"role": "label", "params": ["title"], "doc": "Label(\"Inbox\", systemImage: \"tray\")"},
    "Image": {"role": "image", "params": ["name"], "doc": "Image(\"path.png\") or Image(systemName: \"star\")"},
    "AsyncImage": {"role": "image", "params": ["url"]},
    "Icon": {"role": "icon", "params": ["name"]},
    "Avatar": {"role": "avatar", "params": ["name"]},
    "Badge": {"role": "badge", "params": ["text"]},
    "Chip": {"role": "chip", "params": ["label"]},
    "Tag": {"role": "chip", "params": ["label"]},
    "Link": {"role": "link", "params": ["label", "destination"]},
    "ProgressView": {"role": "progress", "params": ["label"], "doc": "value: 0…1 (or total:); none = indeterminate"},
    "Gauge": {"role": "progress", "params": ["value"], "defaults": {"variant": "gauge"}},
    "Rating": {"role": "rating", "params": ["value"]},
    "Placeholder": {"role": "placeholder", "params": ["label"], "doc": "A labelled box for maps, charts, media"},
    "Chart": {"role": "chart", "doc": "kind: .bar|.line|.area|.pie|.donut, values: [..], labels: [..]"},

    "Button": {"role": "button", "params": ["label"], "doc": "Button(\"Save\", systemImage:) · .buttonStyle(…)"},
    "IconButton": {"role": "button", "params": ["icon"], "defaults": {"iconOnly": true}},
    "FloatingActionButton": {"role": "fab", "params": ["icon"]},
    "Toggle": {"role": "toggle", "params": ["label"], "doc": "Toggle(\"Wi-Fi\", isOn: true)"},
    "Checkbox": {"role": "checkbox", "params": ["label"]},
    "RadioButton": {"role": "radio", "params": ["label"]},
    "RadioGroup": {"role": "radiogroup", "params": ["label"]},
    "TextField": {"role": "textfield", "params": ["placeholder"], "doc": "TextField(\"Placeholder\", text: \"value\")"},
    "SecureField": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "password"}},
    "TextEditor": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline"}},
    "SearchField": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"}},
    "Picker": {"role": "select", "params": ["label"], "doc": "Picker(\"Size\", selection: \"M\") { Text(\"S\") … }"},
    "SegmentedControl": {"role": "segmented", "params": ["items"]},
    "Slider": {"role": "slider", "doc": "Slider(value: 0.4) or Slider(value: 30, in: 0...100)"},
    "Stepper": {"role": "stepper", "params": ["label"]},
    "DatePicker": {"role": "datepicker", "params": ["label"], "doc": "selection: \"2026-11-23\"; .datePickerStyle(.graphical)"},
    "Calendar": {"role": "calendar"},
    "Dropzone": {"role": "dropzone", "params": ["label"]},

    "NavigationStack": {"role": "navstack", "doc": "Content's .navigationTitle / .toolbar form the bar"},
    "NavigationView": {"role": "navstack"},
    "NavigationSplitView": {"role": "split", "doc": "{ sidebar } content: { … } detail: { … }"},
    "TabView": {"role": "tabs", "defaults": {"placement": "bottom"}, "doc": "Children with .tabItem { Label } or Tab(…)"},
    "Tab": {"role": "tab", "params": ["label"], "doc": "Tab(\"Home\", systemImage: \"house\") { … }"},
    "Tabs": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top"}},
    "AppBar": {"role": "appbar", "params": ["title"]},
    "Sidebar": {"role": "sidebar", "params": ["title"]},
    "NavItem": {"role": "navitem", "params": ["label"]},
    "Breadcrumb": {"role": "breadcrumb", "params": ["items"]},
    "Pagination": {"role": "pagination"},
    "Steps": {"role": "steps", "params": ["steps"]},

    "Card": {"role": "card", "params": ["title"]},
    "GroupBox": {"role": "card", "params": ["title"]},
    "Section": {"role": "section", "params": ["title"], "doc": "Section(\"Header\") { … } footer: { … }"},
    "List": {"role": "list", "doc": ".listStyle(.insetGrouped|.plain|.sidebar|…)"},
    "Row": {"role": "listitem", "params": ["title"], "doc": "title, subtitle:, detail:, systemImage:, chevron:"},
    "ListItem": {"role": "listitem", "params": ["title"]},
    "NavigationLink": {"role": "listitem", "params": ["title"], "defaults": {"chevron": true}},
    "LabeledContent": {"role": "labeled", "params": ["label", "value"]},
    "Form": {"role": "form"},
    "Table": {"role": "table", "doc": "columns: [\"Name\", …], rows: [[…], …] or TableRow children"},
    "TableRow": {"role": "tablerow"},
    "TableColumn": {"role": "tablecolumn", "params": ["title"]},
    "Toolbar": {"role": "toolbar"},
    "ToolbarItem": {"role": "toolbaritem", "doc": "ToolbarItem(placement: .topBarTrailing) { … }"},
    "ToolbarItemGroup": {"role": "toolbaritem"},
    "ControlGroup": {"role": "toolbar", "defaults": {"variant": "group"}},
    "DisclosureGroup": {"role": "accordion", "params": ["title"]},
    "Accordion": {"role": "accordion", "params": ["title"]},
    "Dialog": {"role": "dialog", "params": ["title"]},
    "Alert": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alert"}},
    "Sheet": {"role": "dialog", "params": ["title"], "defaults": {"variant": "sheet"}},
    "Menu": {"role": "menu", "params": ["label"]},
    "MenuItem": {"role": "menuitem", "params": ["label"]},
    "Tooltip": {"role": "tooltip", "params": ["text"]},
    "Toast": {"role": "toast", "params": ["message"]},
    "Banner": {"role": "alert", "params": ["title"]}
  }
}
