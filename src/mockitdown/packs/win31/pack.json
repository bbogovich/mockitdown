  "elements": {
    "Desktop": {
      "role": "zstack",
      "defaults": {
        "alignment": "topLeading"
      },
      "doc": "The teal desktop; place windows with .offset(x:y:) (top-left anchored)"
    },
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Overlapped window: navy caption, control-menu box, min/max arrows, sizing border. .variant(.inactive)"
    },
    "ApplicationWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Same as Window"
    },
    "MDIChildWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "child"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "MDI document window inside an MDIClient"
    },
    "MDIClient": {
      "role": "zstack",
      "defaults": {
        "alignment": "topLeading",
        "kind": "mdiclient"
      },
      "doc": "MDI workspace (Application Workspace colour); children placed with .offset"
    },
    "ProgramManager": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Program Manager"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Program Manager window: put a MenuBar and an MDIClient of ProgramGroups inside"
    },
    "ProgramGroup": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "child"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Program group child window: a grid of ProgramItems"
    },
    "ProgramItem": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "item",
        "icon": "app"
      },
      "doc": "ProgramItem(\"Notepad\", icon: \"doc\") — 32×32 icon over a caption; .selected()"
    },
    "ProgramGroupIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "group",
        "icon": "square.grid.2x2"
      },
      "doc": "A minimized program group at the bottom of Program Manager"
    },
    "DesktopIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "minimized",
        "icon": "app"
      },
      "doc": "A minimized application icon on the desktop"
    },
    "FileManager": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "File Manager"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "File Manager window: MenuBar, then DirectoryWindow children"
    },
    "DirectoryWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "child"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "DirectoryWindow(\"C:\\\\WINDOWS\\\\*.*\") { DriveBar; HStack { DirectoryTree; FileList } }"
    },
    "DriveBar": {
      "role": "toolbar",
      "defaults": {
        "variant": "drivebar"
      },
      "doc": "Row of Drive buttons, then the volume label Static"
    },
    "Drive": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "drive",
        "kind": "hard"
      },
      "variants": [
        "drive"
      ],
      "doc": "Drive(\"c\", kind: .floppy|.hard|.network|.cdrom|.ram).selected()"
    },
    "DirectoryTree": {
      "role": "tree",
      "defaults": {
        "variant": "directory"
      },
      "doc": "DirectoryTree { Directory(\"c:\\\\\") { Directory(\"windows\").selected() } }"
    },
    "Directory": {
      "role": "treeitem",
      "params": [
        "label"
      ],
      "defaults": {
        "folder": true
      },
      "doc": "Directory(\"windows\", expanded:) — folder icon; the selected one shows the open folder"
    },
    "FileList": {
      "role": "list",
      "defaults": {
        "variant": "files"
      },
      "doc": "FileList { FileItem(\"win.ini\") … } — the right pane of a directory window"
    },
    "FileItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "document",
        "icon": "doc"
      },
      "doc": "FileItem(\"win.com\", kind: .program|.document|.file|.folder, detail: \"50,904\")"
    },
    "Notepad": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Notepad - (Untitled)"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Notepad window: MenuBar + MultiLineEdit"
    },
    "Write": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Write - (Untitled)"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Windows Write window"
    },
    "Cardfile": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Cardfile - (Untitled)"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Cardfile window: MenuBar, a status Static, then a CardStack of IndexCards"
    },
    "CardStack": {
      "role": "zstack",
      "defaults": {
        "alignment": "topLeading",
        "kind": "cards"
      },
      "doc": "Overlapping IndexCards, back to front; offset each with .offset(x:y:)"
    },
    "IndexCard": {
      "role": "stickynote",
      "params": [
        "title",
        "text"
      ],
      "defaults": {
        "variant": "card",
        "color": "white"
      },
      "doc": "IndexCard(\"Brown, Ana\", \"555-0134\") — white card with the index line"
    },
    "Calculator": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Calculator"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Calculator window: an Edit display and a grid of CalcKeys"
    },
    "CalcKey": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "calc"
      },
      "doc": "A Calculator key; .foregroundStyle(.red) for C/CE like the original"
    },
    "Clock": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Clock"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Clock window: ClockFace inside"
    },
    "ClockFace": {
      "role": "shape",
      "defaults": {
        "shape": "circle",
        "kind": "clock"
      },
      "variants": [
        "analog",
        "digital"
      ],
      "doc": "Analog clock face at 10:10 (size with .frame)"
    },
    "ControlPanel": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "kind": "window",
        "variant": "active",
        "title": "Control Panel"
      },
      "variants": [
        "active",
        "inactive",
        "maximized",
        "child"
      ],
      "doc": "Control Panel window: a grid of ProgramItems (Color, Fonts, Ports, …)"
    },
    "MSDOSPrompt": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "variant": "terminal",
        "kind": "dos"
      },
      "doc": "Full-screen-ish MS-DOS Prompt; lines starting with \"C:\\\\>\" are commands"
    },
    "MenuBar": {
      "role": "toolbar",
      "defaults": {
        "variant": "menubar"
      },
      "doc": "MenuBar { Menu(\"File\") { MenuItem… } } — first letters are underlined as mnemonics"
    },
    "Menu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "menubar",
        "caret": false
      },
      "doc": "Menu(\"File\", open: true) { MenuItem(\"Open...\", shortcut: \"Ctrl+O\") }"
    },
    "PopupMenu": {
      "role": "menu",
      "doc": "A free-standing drop-down menu (open)"
    },
    "SystemMenu": {
      "role": "menu",
      "doc": "The control menu (Restore, Move, Size, Minimize, Maximize, Close, Switch To…)"
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "MenuItem(\"Save As...\", shortcut:, checked:, disabled:)"
    },
    "MenuSeparator": {
      "role": "divider"
    },
    "MENUITEM": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "Resource-script spelling of MenuItem"
    },
    "POPUP": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "menubar",
        "caret": false
      },
      "doc": "Resource-script spelling of Menu"
    },
    "Button": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "push"
      },
      "variants": [
        "push",
        "default"
      ],
      "doc": "PUSHBUTTON; .variant(.default) is the DEFPUSHBUTTON with the heavy outline; .state(.focused) draws the dotted focus rectangle"
    },
    "PushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "push"
      },
      "variants": [
        "push",
        "default"
      ],
      "doc": "BS_PUSHBUTTON"
    },
    "DefPushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "variants": [
        "push",
        "default"
      ],
