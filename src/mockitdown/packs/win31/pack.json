        "label"
      ]
    },
    "GroupBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "groupbox"
      },
      "doc": "GroupBox(\"Orientation\") { RadioButton… } — a black frame with the caption breaking the top line"
    },
    "GROUPBOX": {
      "role": "card",
