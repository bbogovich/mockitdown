    {
      "name": "Inbox",
      "x": 480,
      "y": 0,
      "options": {
        "device": "fit"
      },
      "code": "// The inbox, with its folders\nlet folders = [\"Alpha\", \"Beta\", \"Gamma\"]\n\nVStack(spacing: 12) {\n  Text(\"Inbox\").font(.title)\n  List {\n    Card {\n      Text(\"Quarterly report\")\n      Button(\"Open\") {}.id(\"open\")\n    }\n    ForEach(folders) { name in\n      Text(name)\n    }\n  }\n}\n",
      "notes": "the walking-skeleton sample"
    }
  ],
  "view": {
    "zoom": 1,
    "x": 0,
    "y": 0,
    "active": "Inbox"
  },
  "x-host": {
    "window": "1280x800"
  }
