{
  "project": "mockitdown",
  "kind": "prototype",
  "forge": "none",
  "docs": {
    "branch": "docs",
    "worktree": "../mockitdown.docs",
    "tiers": [
      "definition",
      "specification",
      "implementation"
    ]
  },
  "tiers": {
    "definition": {
      "repository": "../mockitdown.docs",
      "source": "definition/",
      "version": "definition/VERSION",
      "docs": "docs/",
      "docsPrefix": "definition/"
    },
    "specification": {
      "repository": "../mockitdown.docs",
      "source": "specification/",
      "version": "specification/VERSION",
      "docs": "docs/",
      "docsPrefix": "specification/"
    },
    "implementation": {
      "repository": "."
    }
  },
  "spec": "../mockitdown.docs/docs/specification",
  "review": {
    "preset": "prototype"
  },
  "health": {
    "audit_every": 10,
    "thresholds": {
      "large_file_limits": {
        "shared/packs/*/pack.css": 2000
      }
    }
  },
  "labels": [
    {
      "name": "refactor",
      "description": "Behaviour-preserving change, usually filed by an auditor"
    }
  ],
  "implementation": {
    "kind": "library",
    "language": "python",
    "platforms": [
      "windows",
      "macos",
      "linux"
    ],
    "framework": null,
    "targets": [
      "cli"
    ],
    "dependencies": [
      "Markdown (optional extra)",
      "pymdown-extensions (optional extra)"
    ],
    "template": "python-cli",
    "profiles": [
      "impl-common",
      "impl-headless",
      "impl-library"
    ],
    "build": ".venv/bin/python -m pip install -e 'python[markdown]'",
    "test": "cd python && ../.venv/bin/python -m unittest discover -s tests -t .",
    "site": {
      "branch": "docs",
      "worktree": "../mockitdown.docs"
    }
  }
}
