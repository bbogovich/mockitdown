          "template": {
            "clauses": [
              [
                "G1",
                "TODO \u2014 the problem or goal, one sentence"
              ],
              [
                "C1",
                "TODO \u2014 one capability per clause"
              ],
              [
                "AC1",
                "TODO \u2014 an acceptance criterion: what is observably true when done"
              ]
            ],
            "prose": "**Problem.** TODO\n\n**Change.** TODO\n"
          }
        },
        "design": {
          "dir": "design",
          "file": "design.md",
          "heading": "#### {id} \u2014 {title}",
