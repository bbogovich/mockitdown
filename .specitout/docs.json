          "file": "element.md",
          "heading": "#### {id} \u2014 {title}",
          "template": {
            "clauses": [
              [
                "P1",
                "provides: TODO \u2014 an interface this element offers"
              ],
              [
                "U1",
                "uses A-XXX-n \u2014 TODO"
              ],
              [
                "K1",
                "TODO \u2014 a constraint, RFC 2119 keyword"
              ]
