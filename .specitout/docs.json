              ],
              [
                "R1",
                "rel: \u2192 M-XXX-n (0..*) \u2014 TODO"
              ],
              [
                "I1",
                "TODO \u2014 an invariant, RFC 2119 keyword"
              ]
            ],
            "prose": "TODO \u2014 what this entity represents.\n"
          },
          "render": "clauses"
        },
        "decisions": {
          "dir": "decisions",
          "file": "decision.md",
          "heading": "#### {id} \u2014 {title}",
          "template": {
            "clauses": [
              [
                "D1",
                "TODO \u2014 the decision, one sentence"
              ],
              [
                "O1",
                "rejected: TODO \u2014 an alternative and why not"
