    "H3": "title",
    "H4": "title2",
    "H5": "title3",
    "H6": "headline",
    "Auto": "title3",
    "Small": "footnote",
    "Large": "callout",
    "Medium": "body"
  },
  "icons": {
    "sap-icon://product-switch": "square.grid.3x3",
