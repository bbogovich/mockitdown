  "modifiers": {
    "type": {
      "attr": "variant"
    },
    "buttonType": {
      "attr": "variant"
    },
    "design": {
      "attr": "variant"
    },
    "layout": {
      "attr": "variant"
    },
    "inverted": {
      "attr": "variant",
      "value": "inverted"
    },
    "valueState": {
      "attr": "state"
    },
    "highlight": {
      "attr": "status"
    },
    "valueColor": {
      "attr": "color"
    },
    "colorScheme": {
      "attr": "color"
    },
    "backgroundColor": {
      "attr": "color"
    },
    "indicator": {
      "attr": "kind"
    },
    "frameType": {
      "attr": "size"
    },
    "displaySize": {
      "attr": "size"
    },
    "displayShape": {
      "attr": "shape"
    },
    "titleStyle": {
      "attr": "level"
    },
    "level": {
      "attr": "level"
    },
    "hAlign": {
      "attr": "alignment"
    },
    "count": {
      "attr": "badge"
    },
    "counter": {
      "attr": "badge"
    },
    "pressed": {
      "attr": "isOn"
    },
    "emphasized": {
      "attr": "emphasis"
    },
    "contentDensity": {
      "attr": "density"
    }
  },
  "elements": {
    "App": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "sap.m.App: the root container"
    },
    "Shell": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "sap.m.Shell: letterboxed app root"
    },
    "Page": {
      "role": "navstack",
      "params": [
        "title"
      ],
      "defaults": {
        "titleDisplayMode": "inline"
      },
      "doc": "sap.m.Page: header Bar with title (start-aligned in Horizon), content; back: true shows the nav button"
    },
    "ScrollContainer": {
      "role": "scroll",
      "params": [
        "axes"
      ],
      "doc": "sap.m.ScrollContainer"
    },
    "VBox": {
      "role": "vstack",
      "defaults": {
        "alignment": "leading"
      },
      "doc": "sap.m.VBox (FlexBox, column)"
    },
    "HBox": {
      "role": "hstack",
      "doc": "sap.m.HBox (FlexBox, row)"
    },
    "FlexBox": {
      "role": "hstack",
      "doc": "sap.m.FlexBox; wrap: true wraps"
    },
    "Bar": {
      "role": "toolbar",
      "doc": "sap.m.Bar: left/middle/right content; use ToolbarSpacer between"
    },
    "Toolbar": {
      "role": "toolbar",
      "doc": "sap.m.Toolbar"
    },
    "OverflowToolbar": {
      "role": "toolbar",
      "doc": "sap.m.OverflowToolbar: header toolbar of tables and lists"
    },
    "ToolbarSpacer": {
      "role": "spacer",
      "doc": "sap.m.ToolbarSpacer: pushes the following content to the end"
    },
    "ToolbarSeparator": {
      "role": "divider",
      "doc": "sap.m.ToolbarSeparator"
    },
    "Title": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "style": "H5"
      },
      "doc": "sap.m.Title; level: .H1 … .H6 (or .titleStyle(.H3)) sets the size"
    },
    "Label": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "sap.m.Label: field caption in sapContent_LabelColor"
    },
    "Text": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "sap.m.Text"
    },
    "FormattedText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "sap.m.FormattedText (inline **bold**, *italic*, `code`, [link](…))"
    },
    "ExpandableText": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "sap.m.ExpandableText"
    },
    "Link": {
      "role": "link",
      "params": [
        "text",
        "href"
      ],
      "attrs": {
        "destination": "href"
      },
      "doc": "sap.m.Link"
    },
    "Image": {
      "role": "image",
      "params": [
        "src"
      ],
      "doc": "sap.m.Image(src)"
    },
    "Icon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "doc": "sap.ui.core.Icon(\"sap-icon://home\")"
    },
    "Item": {
      "role": "text",
      "params": [
        "text"
      ],
      "doc": "sap.ui.core.Item: an option of Select / ComboBox / SegmentedButton"
    },
    "Button": {
      "role": "button",
      "params": [
        "text"
      ],
      "variants": [
        "Default",
        "Emphasized",
        "Transparent",
        "Ghost",
        "Accept",
        "Reject",
        "Attention",
        "Negative",
        "Critical",
        "Success",
        "Neutral",
        "Back",
        "Up",
        "Unstyled"
      ],
      "doc": "sap.m.Button; .type(.Emphasized) etc.; icon: \"sap-icon://add\""
    },
    "OverflowToolbarButton": {
      "role": "button",
      "params": [
        "icon"
      ],
      "defaults": {
        "iconOnly": true,
        "variant": "Transparent"
      },
      "doc": "sap.m.OverflowToolbarButton: icon-only transparent button"
    },
    "ToggleButton": {
      "role": "toggle",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "button"
      },
      "doc": "sap.m.ToggleButton; .pressed() shows the pressed state"
    },
    "MenuButton": {
      "role": "menu",
      "params": [
        "label"
      ],
      "variants": [
        "Default",
        "Emphasized",
        "Transparent",
        "Ghost"
      ],
      "doc": "sap.m.MenuButton { MenuItem(…) }; open: true shows the menu"
    },
    "Menu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "doc": "sap.m.Menu (standalone without a label)"
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "text"
      ],
      "doc": "sap.m.MenuItem(text, icon:)"
    },
    "ActionSheet": {
      "role": "menu",
      "doc": "sap.m.ActionSheet: a menu of buttons"
    },
    "SegmentedButton": {
      "role": "segmented",
      "params": [
        "items"
      ],
      "doc": "sap.m.SegmentedButton(items: [...], selection:) or SegmentedButtonItem children"
    },
    "SegmentedButtonItem": {
      "role": "button",
      "params": [
        "text"
      ],
      "doc": "sap.m.SegmentedButtonItem"
    },
    "Input": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "sap.m.Input(placeholder, value:, label:); .valueState(.Error), error: \"text\" for the value state message"
    },
    "MaskInput": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "sap.m.MaskInput"
    },
    "SearchField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "search"
      },
      "doc": "sap.m.SearchField (magnifier at the end)"
    },
    "TextArea": {
      "role": "textfield",
      "params": [
        "value"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "doc": "sap.m.TextArea(value, rows:)"
    },
