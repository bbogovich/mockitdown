  "elements": {
    "MainWindow": {"role": "vstack", "defaults": {"spacing": 0, "alignment": "stretch"},
                   "doc": "QMainWindow: stack MenuBar, ToolBar, the central area (DockWidgets + central widget in an HStack/Splitter) and StatusBar"},
    "CentralWidget": {"role": "vstack", "defaults": {"spacing": 6, "alignment": "stretch"},
                      "doc": "The main window's central widget; give it .frame(maxWidth: .infinity, maxHeight: .infinity)"},
    "Widget": {"role": "vstack", "defaults": {"alignment": "leading"}, "doc": "QWidget: a plain container (vertical)"},
    "Frame": {"role": "vstack", "defaults": {"variant": "styledPanel", "alignment": "stretch"},
              "variants": ["styledPanel", "box", "panel", "winPanel", "hLine", "vLine", "noFrame"],
              "attrs": {"frameShape": "variant", "frameShadow": "emphasis"},
              "doc": "QFrame(frameShape: .box|.panel|.styledPanel|.hLine|.vLine|.noFrame, frameShadow: .sunken|.raised|.plain)"},
    "VBoxLayout": {"role": "vstack", "defaults": {"spacing": 6, "alignment": "stretch"}, "doc": "QVBoxLayout: children top to bottom"},
    "HBoxLayout": {"role": "hstack", "defaults": {"spacing": 6}, "doc": "QHBoxLayout: children left to right"},
    "GridLayout": {"role": "grid", "doc": "QGridLayout(columns: n) or GridRow children"},
    "FormLayout": {"role": "form", "defaults": {"variant": "formLayout"},
                   "variants": ["formLayout", "leadingLabels"],
                   "doc": "QFormLayout { FormRow(\"Name:\") { LineEdit() } } — labels right-aligned in the first column"},
    "FormRow": {"role": "labeled", "params": ["label"], "doc": "QFormLayout::addRow(label, field): FormRow(\"Name:\") { LineEdit() }"},
    "StackedWidget": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "QStackedWidget: holds the current page only"},
    "StackedLayout": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "Splitter": {"role": "hstack", "defaults": {"spacing": 0}, "doc": "QSplitter(orientation: .horizontal|.vertical) — panes separated by a handle; size panes with .frame(width:)"},
    "ScrollArea": {"role": "scroll", "params": ["axes"], "doc": "QScrollArea with Fusion scroll bars"},
    "GroupBox": {"role": "card", "params": ["title"],
                 "variants": ["flat"],
                 "attrs": {"checkable": "emphasis", "checked": "selected", "flat": "shape"},
                 "doc": "QGroupBox(\"Title\", checkable: true, checked: true) { … } — bold title above a rounded frame"},
    "TabWidget": {"role": "tabs", "defaults": {"placement": "top", "variant": "tabWidget"},
                  "variants": ["tabWidget", "documentMode"],
                  "attrs": {"tabsClosable": "emphasis", "tabPosition": "placement", "currentIndex": "selection"},
                  "doc": "QTabWidget(selection:) { Tab(\"General\") { … } } — tabsClosable:, documentMode via .variant(.documentMode)"},
    "TabBar": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top", "variant": "tabBar"},
               "attrs": {"tabsClosable": "emphasis", "currentIndex": "selection"},
               "doc": "QTabBar(items: [..], selection:)"},
    "DockWidget": {"role": "card", "params": ["title"], "defaults": {"variant": "dock"},
                   "doc": "QDockWidget(\"Title\") { … } — title bar with float and close buttons"},
    "ToolBox": {"role": "vstack", "defaults": {"spacing": 0, "alignment": "stretch"},
                "doc": "QToolBox { ToolBoxItem(\"Page\", expanded: true) { … } }"},
    "ToolBoxItem": {"role": "accordion", "params": ["title"], "doc": "One QToolBox page: tab button + (expanded) contents"},
    "MdiArea": {"role": "canvas", "doc": "QMdiArea: place MdiSubWindow children with .position(x:y:)"},
    "MdiSubWindow": {"role": "card", "params": ["title"], "defaults": {"variant": "mdi"}, "doc": "QMdiSubWindow(\"Title\") { … }"},

    "MenuBar": {"role": "toolbar", "defaults": {"variant": "menuBar"}, "doc": "QMenuBar { Menu(\"&File\") { Action… } }"},
    "Menu": {"role": "menu", "params": ["label"], "defaults": {"caret": false},
             "doc": "QMenu: in a MenuBar a title (open: true shows it); without a label a standalone popup / context menu"},
    "Action": {"role": "menuitem", "params": ["label"],
               "doc": "QAction(\"&Open…\", icon:, shortcut: \"Ctrl+O\", checked:) — children make a submenu"},
    "Separator": {"role": "divider", "doc": "addSeparator() in menus and tool bars"},
    "ToolBar": {"role": "toolbar", "defaults": {"variant": "toolBar"}, "doc": "QToolBar { ToolButton(icon:) … Separator() }"},
    "ToolButton": {"role": "button", "params": ["label"], "defaults": {"variant": "toolButton"},
                   "attrs": {"toolButtonStyle": "labelStyle", "checked": "selected", "popupMode": "dropdown"},
                   "doc": "QToolButton(\"Save\", icon: \"document-save\", toolButtonStyle: .textUnderIcon|.textBesideIcon|.iconOnly, checked:, popupMode:)"},
    "StatusBar": {"role": "toolbar", "defaults": {"variant": "statusBar"},
                  "doc": "QStatusBar { Label(\"Ready\"); Spacer(); Label(\"Ln 1, Col 1\") } — size grip at the right"},

    "PushButton": {"role": "button", "params": ["label"],
                   "variants": ["default", "flat"],
                   "attrs": {"default": "emphasis", "isDefault": "emphasis", "checked": "selected", "flat": "shape", "menu": "dropdown"},
                   "doc": "QPushButton(\"OK\", default: true, icon:, checked:, flat:, menu:)"},
    "CommandLinkButton": {"role": "button", "params": ["label"], "defaults": {"variant": "commandLink", "icon": "arrow.right"},
                          "doc": "QCommandLinkButton(\"Install now\")"},
    "RadioButton": {"role": "radio", "params": ["label"], "doc": "QRadioButton(\"Option\", checked: true)"},
    "CheckBox": {"role": "checkbox", "params": ["label"], "doc": "QCheckBox(\"Option\", checked: true|.indeterminate)"},
    "ButtonGroup": {"role": "radiogroup", "params": ["label"], "doc": "Exclusive group of RadioButtons: items:, selection:"},
    "DialogButtonBox": {"role": "hstack", "defaults": {"spacing": 6, "variant": "buttonBox"},
                        "doc": "QDialogButtonBox { PushButton(\"OK\", default: true); PushButton(\"Cancel\") } — right-aligned"},

    "ComboBox": {"role": "select", "params": ["label"], "attrs": {"editable": "emphasis"},
                 "doc": "QComboBox(items: [..], currentText:, editable:)"},
    "FontComboBox": {"role": "select", "params": ["label"], "defaults": {"selection": "Segoe UI"}, "doc": "QFontComboBox(currentText:)"},
    "LineEdit": {"role": "textfield", "params": ["text"],
                 "attrs": {"echoMode": "kind", "readOnly": "emphasis"},
                 "doc": "QLineEdit(\"text\", placeholderText:, echoMode: .password, clearButtonEnabled:)"},
    "TextEdit": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline", "rows": 6},
                 "attrs": {"plainText": "text", "html": "text", "markdown": "text"},
                 "doc": "QTextEdit(\"rich text\", rows:) — rich text editor"},
    "PlainTextEdit": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline", "rows": 6},
                      "attrs": {"plainText": "text"}, "doc": "QPlainTextEdit(plainText:)"},
    "TextBrowser": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline", "rows": 6},
                    "attrs": {"html": "text", "markdown": "text"}, "doc": "QTextBrowser(html:) — read-only rich text"},
    "SpinBox": {"role": "textfield", "params": ["value"], "defaults": {"kind": "spin"},
                "doc": "QSpinBox(value: 3, prefix:, suffix: \" px\") — up/down buttons at the right"},
    "DoubleSpinBox": {"role": "textfield", "params": ["value"], "defaults": {"kind": "spin"}, "doc": "QDoubleSpinBox(value: 1.50, suffix:)"},
    "DateEdit": {"role": "datepicker", "params": ["date"], "defaults": {"format": "numeric"},
                 "attrs": {"calendarPopup": "emphasis", "displayFormat": "format"},
                 "doc": "QDateEdit(date: \"2026-11-23\", calendarPopup: true)"},
    "TimeEdit": {"role": "datepicker", "params": ["time"], "defaults": {"kind": "time"},
                 "attrs": {"time": "value"}, "doc": "QTimeEdit(time: \"14:30\")"},
    "DateTimeEdit": {"role": "datepicker", "params": ["dateTime"], "defaults": {"format": "numeric", "kind": "datetime"},
                     "attrs": {"dateTime": "value", "calendarPopup": "emphasis", "displayFormat": "format"},
                     "doc": "QDateTimeEdit(dateTime: \"2026-11-23 14:30\")"},
    "KeySequenceEdit": {"role": "textfield", "params": ["keySequence"], "attrs": {"keySequence": "text"},
                        "doc": "QKeySequenceEdit(keySequence: \"Ctrl+Shift+S\")"},
    "CalendarWidget": {"role": "calendar", "defaults": {"firstWeekday": 1},
                       "doc": "QCalendarWidget(selectedDate: \"2026-11-23\") — highlight-coloured navigation bar"},
    "Slider": {"role": "slider", "params": ["value"],
               "attrs": {"minimum": "min", "maximum": "max", "tickPosition": "ticks", "tickInterval": "steps"},
               "doc": "QSlider(value: 40, minimum: 0, maximum: 100, tickPosition: .ticksBelow)"},
    "Dial": {"role": "progress", "params": ["value"], "defaults": {"kind": "circular"},
             "attrs": {"maximum": "max", "notchesVisible": "emphasis"}, "doc": "QDial(value: 40, maximum: 100)"},
    "ScrollBar": {"role": "slider", "params": ["value"], "defaults": {"orientation": "horizontal"},
                  "attrs": {"minimum": "min", "maximum": "max"}, "doc": "QScrollBar(value: 30, orientation: .horizontal)"},
    "ProgressBar": {"role": "progress", "params": ["value"], "defaults": {"showValue": true},
                    "attrs": {"textVisible": "showValue", "maximum": "max"},
                    "doc": "QProgressBar(value: 64) — percentage in the bar; no value = busy"},
    "LCDNumber": {"role": "text", "params": ["content"], "defaults": {"variant": "outline"},
                  "variants": ["outline", "filled", "flat"],
                  "attrs": {"value": "content", "intValue": "content", "segmentStyle": "variant"},
                  "doc": "QLCDNumber(\"128.4\", segmentStyle: .filled)"},
    "Label": {"role": "label", "params": ["title"], "doc": "QLabel(\"Text\") (also icon:)"},

    "ListWidget": {"role": "list", "doc": "QListWidget { ListWidgetItem(\"Item\", icon:) … } — select with .selected()"},
    "ListView": {"role": "list", "doc": "QListView { ListWidgetItem… }"},
    "ListWidgetItem": {"role": "listitem", "params": ["title"], "doc": "ListWidgetItem(\"Text\", icon:, checked:)"},
    "TreeWidget": {"role": "tree", "doc": "QTreeWidget { HeaderView([\"Name\", \"Size\"]); TreeWidgetItem(\"src\") { … } }"},
    "TreeView": {"role": "tree", "doc": "QTreeView { HeaderView([…]); TreeWidgetItem… }"},
    "TreeWidgetItem": {"role": "treeitem", "params": ["label"],
                       "doc": "TreeWidgetItem(\"Name\", icon:, expanded:) { Text(\"col 2\") … TreeWidgetItem(…) } — Text children are extra columns"},
    "HeaderView": {"role": "segmented", "params": ["items"], "attrs": {"sections": "items", "sortIndicatorSection": "selection"},
                   "doc": "QHeaderView([\"Name\", \"Size\"], selection: sorted section)"},
    "TableWidget": {"role": "table", "defaults": {"variant": "verticalHeader"},
                    "variants": ["verticalHeader", "noVerticalHeader"],
                    "attrs": {"horizontalHeaderLabels": "columns", "alternatingRowColors": "emphasis"},
                    "doc": "QTableWidget(columns: [..], rows: [[..]], selection: [row], alternatingRowColors:) — row numbers on the left"},
    "TableView": {"role": "table", "defaults": {"variant": "verticalHeader"},
                  "variants": ["verticalHeader", "noVerticalHeader"],
                  "attrs": {"alternatingRowColors": "emphasis"},
                  "doc": "QTableView(columns:, rows:, selection:, sortColumn:) — .variant(.noVerticalHeader) hides row numbers"},

    "Dialog": {"role": "dialog", "params": ["title"], "defaults": {"closable": true},
               "doc": "QDialog(\"Title\") { … } actions: { DialogButtonBox… } — a window with its own title bar"},
    "MessageBox": {"role": "dialog", "params": ["title"], "defaults": {"variant": "messageBox", "closable": true},
                   "attrs": {"text": "message", "icon": "kind", "standardButtons": "buttons", "defaultButton": "primary"},
                   "doc": "QMessageBox(\"Title\", text:, icon: .warning|.information|.critical|.question, buttons: [..], primary:) { informative text }"},
    "FileDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "fileDialog", "closable": true}, "doc": "QFileDialog window (compose its contents)"},
    "ColorDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "colorDialog", "closable": true}, "doc": "QColorDialog window"},
    "FontDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "fontDialog", "closable": true}, "doc": "QFontDialog window"},
    "InputDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "inputDialog", "closable": true}, "doc": "QInputDialog window"},
    "ProgressDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "progressDialog", "closable": true}, "doc": "QProgressDialog window"},
    "Wizard": {"role": "dialog", "params": ["title"], "defaults": {"variant": "wizard", "closable": true}, "doc": "QWizard window holding one WizardPage"},
    "WizardPage": {"role": "card", "params": ["title"], "defaults": {"variant": "wizardPage"},
                   "doc": "QWizardPage(\"Title\", subtitle:) { … } — white header band"},
    "BasicColors": {"role": "swatches", "defaults": {"variant": "basicColors"}, "doc": "QColorDialog basic-colour grid: colors: [..], selection:"},
    "ToolTip": {"role": "tooltip", "params": ["text"], "doc": "QToolTip shown over its child"},
    "RubberBand": {"role": "marquee", "doc": "QRubberBand: a selection rectangle (size with .frame, place with .position)"},
    "ChartView": {"role": "chart", "doc": "QChartView(kind: .bar|.line|.pie|…, series:, labels:) — Qt Charts light/dark themes"},
    "SizeGrip": {"role": "spacer", "defaults": {"variant": "sizeGrip"}, "doc": "QSizeGrip"}
  }
}
