    "QuickTime": "play",
    "Speech": "mic",
    "Classic": "clock",
    "CDs": "circle",
    "ColorSync": "sparkles",
    "Internet": "globe",
    "Screen Effects": "moon"
  },
  "modifiers": {
    "inactive": {
      "attr": "state",
      "value": "inactive"
    },
    "running": {
      "attr": "state",
      "value": "running"
    },
    "highlighted": {
      "attr": "state",
      "value": "hover"
    },
    "defaultButton": {
      "attr": "variant",
      "value": "default"
    },
    "bezelStyle": {
      "attr": "variant"
    },
    "windowStyle": {
      "attr": "variant"
    },
    "controlSize": {
      "attr": "size"
    }
  },
  "elements": {
    "Desktop": {
      "role": "canvas",
      "doc": "The Aqua desktop (blue wave). Put a MenuBar first, then windows, icons and the Dock placed with .position(x:y:)"
    },
    "MenuBar": {
      "role": "toolbar",
      "doc": "The translucent menu bar: SystemMenu(), AppMenu(\"Finder\"), MenuTitle(\"File\") …, Spacer(), MenuExtra/Text(clock)"
    },
    "SystemMenu": {
      "role": "menu",
      "defaults": {
        "icon": "circle",
        "caret": false
      },
      "doc": "The system menu at the far left of the menu bar (drawn as a neutral blue gel orb); open: true shows its items"
    },
    "AppMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "caret": false
      },
      "doc": "The application menu: the frontmost application's name in bold"
    },
    "MenuTitle": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "caret": false
      },
      "doc": "A menu bar title; MenuTitle(\"File\", open: true) { MenuItem(…) } pulls its menu down"
    },
    "MenuExtra": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "A menu extra (status item) at the right of the menu bar: MenuExtra(icon: \"speaker\") or MenuExtra(\"Mon 9:41 AM\")"
    },
    "Menu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "doc": "A menu; with no label it is a standalone (open) translucent menu"
    },
    "ContextMenu": {
      "role": "menu",
      "doc": "A contextual menu drawn open in place: ContextMenu { MenuItem(…) }"
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "A menu item: shortcut: \"⌘N\", checked:, icon:, .disabled(), .highlighted() for the blue gel item under the pointer"
    },
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "document"
      },
      "variants": [
        "document",
        "metal",
        "utility",
        "plain"
      ],
      "doc": "An Aqua window: pinstriped body, title bar with the red/yellow/green gel buttons. .inactive() greys the buttons and title"
    },
    "DocumentWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "document"
      },
      "doc": "A document window (pinstriped, white content area)"
    },
    "MetalWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "metal"
      },
      "doc": "A brushed-metal (textured) window, as in the media and camera applications"
    },
    "Panel": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "utility"
      },
      "doc": "A utility panel (Fonts, Colors, Inspector): small title bar and small gel buttons"
    },
    "UtilityWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "utility"
      },
      "doc": "A utility window (NSPanel with the utility style)"
    },
    "Drawer": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "drawer"
      },
      "doc": "A drawer sliding out of a window side (side: .trailing default, .leading); put it next to the Window in an HStack(spacing: 0)"
    },
    "Sheet": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "sheet"
      },
      "doc": "A document-modal sheet sliding down from the title bar of the window drawn by the window chrome; buttons: [...], primary:"
    },
    "Alert": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "app"
      },
      "doc": "An application-modal alert: application icon at the left, bold message, small informative text, buttons at the right with the pulsing default button"
    },
    "AlertSheet": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "sheet",
        "icon": "app"
      },
      "doc": "An alert presented as a sheet (NSBeginAlertSheet): icon, message and buttons sliding from the title bar"
    },
    "Toolbar": {
      "role": "toolbar",
      "doc": "A window toolbar (NSToolbar): ToolbarButton items with large icons and labels below; the white toolbar toggle lozenge is drawn at the top right"
    },
    "ToolbarButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "toolbar"
      },
      "doc": "A toolbar item: ToolbarButton(\"Home\", icon: \"house\")"
    },
    "Button": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "push"
      },
      "variants": [
        "push",
        "default",
        "bevel",
        "round",
        "help",
        "metal",
        "toolbar",
        "recessed"
      ],
      "doc": "A push button: the clear gel lozenge. .variant(.default) is the pulsing blue default button"
    },
    "PushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "push"
      },
      "doc": "A push button (NSRoundedBezelStyle)"
    },
    "DefaultButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "default"
      },
      "doc": "The default button: blue gel, slowly pulsing; Return activates it"
    },
    "BevelButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "bevel"
      },
      "doc": "A square bevel button (NSRegularSquareBezelStyle) for icons and image wells"
    },
    "RoundButton": {
      "role": "button",
      "params": [
        "icon"
      ],
      "defaults": {
        "variant": "round"
      },
      "doc": "A round gel button (NSCircularBezelStyle); on a MetalWindow the transport buttons of a media player"
    },
    "HelpButton": {
      "role": "button",
      "defaults": {
        "variant": "help",
        "label": "?"
      },
      "doc": "The round help button with the question mark"
    },
    "CheckBox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "An Aqua check box: clear gel square, blue gel with the check mark when on; checked: true | .mixed"
    },
    "RadioButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "An Aqua radio button: clear gel bead, blue with a dark dot when selected"
    },
    "RadioGroup": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "A radio matrix: RadioGroup(\"Show:\", items: [...], selection:)"
    },
    "Matrix": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "NSMatrix of radio buttons (Interface Builder name)"
    },
    "PopUpButton": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "A pop-up button: clear gel lozenge with the blue cap holding the double arrows; items:, selection:, open:"
    },
    "PullDownButton": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "pulldown"
      },
      "doc": "A pull-down button: a gel lozenge with a single down arrow; open: true shows its menu"
    },
    "ComboBox": {
      "role": "select",
      "params": [
        "label"
      ],
      "defaults": {
        "kind": "combo"
      },
      "doc": "A combo box: a text field with a blue gel arrow button at the right"
    },
    "TextField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "A text field with the inset frame; .state(.focused) draws the blue focus ring"
    },
