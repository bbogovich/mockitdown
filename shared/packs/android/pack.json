    "PermanentDrawerSheet": {"role": "sidebar", "defaults": {"variant": "drawer"}, "doc": "a permanent drawer sheet"},
    "NavigationDrawerItem": {"role": "navitem", "params": ["label"], "doc": "label, icon:, selected:, badge: (shown as trailing text)"},
    "TabRow": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top", "variant": "primary"}, "doc": "TabRow(selectedTabIndex: 0) { Tab(\"Photos\", icon:) … } or TabRow([\"A\", \"B\"])"},
    "PrimaryTabRow": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top", "variant": "primary"}, "doc": "PrimaryTabRow(selectedTabIndex:) { Tab(…) } — content-width indicator, primary colour"},
    "SecondaryTabRow": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top", "variant": "secondary"}, "doc": "SecondaryTabRow(selectedTabIndex:) — full-width 2dp indicator, on-surface text"},
