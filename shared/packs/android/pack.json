    "ShortNavigationBar": {"role": "tabs", "defaults": {"placement": "bottom", "variant": "short"}, "doc": "M3 Expressive ShortNavigationBar (64dp); same items as NavigationBar"},
    "NavigationBarItem": {"role": "tab", "params": ["label"], "doc": "label, icon:, selected:, badge: (number, or true for a dot)"},
    "ShortNavigationBarItem": {"role": "tab", "params": ["label"], "doc": "label, icon:, selected:, badge:"},
    "NavigationRail": {"role": "sidebar", "defaults": {"variant": "rail"}, "doc": "NavigationRail(header: { FloatingActionButton(\"edit\", inline: true) }) { NavigationRailItem(…) }"},
    "WideNavigationRail": {"role": "sidebar", "defaults": {"variant": "rail"}, "doc": "M3 Expressive WideNavigationRail (collapsed)"},
    "NavigationRailItem": {"role": "navitem", "params": ["label"], "doc": "label, icon:, selected:, badge:"},
    "ModalNavigationDrawer": {"role": "dialog", "defaults": {"variant": "drawer"}, "doc": "an open modal drawer over the screen: ModalNavigationDrawer { Text(\"Mail\"); NavigationDrawerItem(…) }"},
    "ModalDrawerSheet": {"role": "dialog", "defaults": {"variant": "drawer"}, "doc": "the sheet of an open ModalNavigationDrawer (same rendering)"},
