    "Scaffold": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Scaffold { TopAppBar(…); content; NavigationBar { … } } — fills the screen; FABs float over it"},
    "Surface": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Surface(color:, tonalElevation:) { … } — a plain M3 surface; .elevation(1…5) adds tonal elevation"},
    "Column": {"role": "vstack", "defaults": {"alignment": "leading"}, "doc": "Compose Column (vertical layout); spacing:, alignment:"},
    "Box": {"role": "zstack", "doc": "Compose Box: overlapping children; alignment:"},
    "LazyColumn": {"role": "scroll", "doc": "LazyColumn { … } — a vertically scrolling column"},
    "LazyRow": {"role": "scroll", "defaults": {"axes": "horizontal"}, "doc": "LazyRow { … } — a horizontally scrolling row"},
    "LazyVerticalGrid": {"role": "grid", "params": ["columns"], "doc": "LazyVerticalGrid(columns: 3, spacing:) { … }"},
    "FlowRow": {"role": "hstack", "defaults": {"wrap": true, "spacing": 8}, "doc": "FlowRow { … } — wraps its children (chips)"},

    "TopAppBar": {"role": "appbar", "params": ["title"], "defaults": {"variant": "small"}, "attrs": {"navigationIcon": "navigation"}, "doc": "TopAppBar(title: \"Inbox\", navigationIcon: { IconButton(\"menu\") }, actions: { IconButton(\"search\") }) — 64dp small bar"},
