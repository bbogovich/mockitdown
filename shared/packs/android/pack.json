    "MediumTopAppBar": {"role": "appbar", "params": ["title"], "defaults": {"variant": "medium"}, "attrs": {"navigationIcon": "navigation"}, "doc": "MediumTopAppBar: 112dp, headlineSmall title below the icons"},
    "LargeTopAppBar": {"role": "appbar", "params": ["title"], "defaults": {"variant": "large"}, "attrs": {"navigationIcon": "navigation"}, "doc": "LargeTopAppBar: 152dp, headlineMedium title below the icons"},
    "MediumFlexibleTopAppBar": {"role": "appbar", "params": ["title"], "defaults": {"variant": "medium"}, "attrs": {"navigationIcon": "navigation"}, "doc": "M3 Expressive MediumFlexibleTopAppBar(title:, subtitle:)"},
