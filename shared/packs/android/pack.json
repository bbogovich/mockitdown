    "BottomAppBar": {"role": "toolbar", "doc": "BottomAppBar { IconButton(…) …; Spacer(); FloatingActionButton(\"add\", inline: true) }"},
    "HorizontalFloatingToolbar": {"role": "toolbar", "defaults": {"variant": "floating"}, "doc": "M3 Expressive floating toolbar: a pill of IconButtons"},
