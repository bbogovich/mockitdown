{
  "id": "base",
  "name": "Wireframe",
  "framework": "Neutral wireframe (the portable core every pack extends)",
  "version": "1",
  "modules": [
    "Wireframe",
    "Mockitdown"
  ],
  "device": "desktop",
  "chrome": {
    "phone": "none",
    "tablet": "none",
    "desktop": "none"
  },
  "tokens": {
    "light": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surface-2": "#f4f5f7",
      "surface-3": "#e9ebef",
      "fg": "#1d2129",
      "fg-2": "#5b6270",
      "fg-3": "#8d93a0",
      "border": "#d5d9e0",
      "divider": "#e4e7ec",
      "accent": "#3b6fd8",
      "on-accent": "#ffffff",
      "accent-soft": "#e6eefc",
      "danger": "#d0342c",
      "warning": "#c77700",
      "success": "#2e8540",
      "info": "#2f6fdc",
      "field-bg": "#ffffff",
      "field-border": "#c4c9d2",
      "scrim": "rgb(15 18 24 / 0.36)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / 0.08)",
      "shadow-2": "0 4px 12px rgb(0 0 0 / 0.12)",
      "shadow-3": "0 12px 32px rgb(0 0 0 / 0.18)",
      "radius-s": "4px",
      "radius-m": "6px",
      "radius-l": "10px",
      "radius-xl": "16px",
      "radius-pill": "999px",
      "font": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
      "font-size": "14px",
      "line-height": "1.4",
      "icon-stroke": "1.75",
      "icon-size": "18px",
      "control-h": "34px",
      "gap": "8px",
      "pad": "12px",
      "chrome-bg": "#eceef1",
      "chrome-fg": "#1d2129",
      "fs-display": "40px",
      "fw-display": "700",
      "fs-largeTitle": "32px",
      "fw-largeTitle": "700",
      "fs-title": "26px",
      "fw-title": "700",
      "fs-title2": "22px",
      "fw-title2": "700",
      "fs-title3": "19px",
      "fw-title3": "600",
      "fs-headline": "15px",
      "fw-headline": "600",
      "fs-subheadline": "14px",
      "fw-subheadline": "400",
      "fs-body": "14px",
      "fw-body": "400",
      "fs-callout": "14px",
      "fw-callout": "400",
      "fs-footnote": "12px",
      "fw-footnote": "400",
      "fs-caption": "11px",
      "fw-caption": "400",
      "fs-caption2": "10px",
      "fw-caption2": "400",
      "fs-overline": "11px",
      "fw-overline": "600",
      "color-red": "#e5484d",
      "color-orange": "#f76b15",
      "color-yellow": "#f5c400",
      "color-green": "#30a46c",
      "color-mint": "#3dd6b5",
      "color-teal": "#12a594",
      "color-cyan": "#05a2c2",
      "color-blue": "#0090ff",
      "color-indigo": "#3e63dd",
      "color-purple": "#8e4ec6",
      "color-pink": "#d6409f",
      "color-brown": "#ad7f58",
      "color-gray": "#8b8d98",
      "chart-1": "#3b6fd8",
      "chart-2": "#30a46c",
      "chart-3": "#f76b15",
      "chart-4": "#8e4ec6",
      "chart-5": "#e5484d",
      "chart-6": "#12a594",
      "callout": "#e8590c",
      "on-callout": "#ffffff",
      "marquee": "#2f6fdc",
      "note": "#ffe066",
      "code-bg": "#f6f8fa",
      "code-fg": "#24292f",
      "code-kw": "#cf222e",
      "code-str": "#0a3069",
      "code-num": "#0550ae",
      "code-comment": "#6e7781",
      "code-fn": "#8250df",
      "code-type": "#953800",
      "term-bg": "#1e1e1e",
      "term-fg": "#d4d4d4",
      "term-prompt": "#4ec9b0",
      "grid-line": "#e1e4e8",
      "map-land": "#eef0e6",
      "map-water": "#b9d7ee",
      "map-park": "#cfe6c5",
      "map-road": "#ffffff"
    },
    "dark": {
      "bg": "#16181d",
      "surface": "#1e2128",
      "surface-2": "#252932",
      "surface-3": "#2e333d",
      "fg": "#eceef2",
      "fg-2": "#a7adb9",
      "fg-3": "#757c8a",
      "border": "#3a404c",
      "divider": "#2f343e",
      "accent": "#6d9bf2",
      "on-accent": "#0b1220",
      "accent-soft": "#243552",
      "danger": "#f2665f",
      "warning": "#f0a43a",
      "success": "#4cc26e",
      "info": "#6d9bf2",
      "field-bg": "#1b1e24",
      "field-border": "#464c59",
      "scrim": "rgb(0 0 0 / 0.55)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / 0.5)",
      "shadow-2": "0 4px 12px rgb(0 0 0 / 0.5)",
      "shadow-3": "0 12px 32px rgb(0 0 0 / 0.6)",
      "chrome-bg": "#23262d",
      "chrome-fg": "#eceef2",
      "code-bg": "#161b22",
      "code-fg": "#e6edf3",
      "code-kw": "#ff7b72",
      "code-str": "#a5d6ff",
      "code-num": "#79c0ff",
      "code-comment": "#8b949e",
      "code-fn": "#d2a8ff",
      "code-type": "#ffa657",
      "grid-line": "#30363d",
      "map-land": "#2a2e33",
      "map-water": "#1f3a52",
      "map-park": "#2b3d2c",
      "map-road": "#3a3f46"
    }
  },
  "modifiers": {
    "variant": {
      "attr": "variant"
    },
    "size": {
      "attr": "size"
    },
    "severity": {
      "attr": "severity"
    },
    "state": {
      "attr": "state"
    },
    "selected": {
      "attr": "selected"
    },
    "disabled": {
      "attr": "disabled"
    },
    "badge": {
      "attr": "badge"
    },
    "elevation": {
      "attr": "elevation"
    },
    "density": {
      "attr": "density"
    },
    "expanded": {
      "attr": "expanded"
    },
    "open": {
      "attr": "open"
    },
    "color": {
      "attr": "color"
    },
    "buttonStyle": {
      "attr": "variant"
    },
    "listStyle": {
      "attr": "variant"
    },
    "pickerStyle": {
      "attr": "variant"
    },
    "toggleStyle": {
      "attr": "variant"
    },
    "textFieldStyle": {
      "attr": "variant"
    },
    "datePickerStyle": {
      "attr": "variant"
    },
    "tabViewStyle": {
      "attr": "variant"
    },
    "progressViewStyle": {
      "attr": "variant"
    },
    "gaugeStyle": {
      "attr": "variant"
    },
    "menuStyle": {
      "attr": "variant"
    },
    "formStyle": {
      "attr": "variant"
    },
    "groupBoxStyle": {
      "attr": "variant"
    },
    "navigationSplitViewStyle": {
      "attr": "variant"
    },
    "labelStyle": {
      "attr": "labelStyle"
    },
    "controlSize": {
      "attr": "size"
    },
    "buttonBorderShape": {
      "attr": "shape"
    }
  },
  "elements": {
    "VStack": {
      "role": "vstack",
      "doc": "Vertical stack. spacing:, alignment: .leading|.center|.trailing"
    },
    "HStack": {
      "role": "hstack",
      "doc": "Horizontal stack. spacing:, alignment: .top|.center|.bottom"
    },
    "ZStack": {
      "role": "zstack",
      "doc": "Overlapping layers. alignment:"
    },
    "LazyVStack": {
      "role": "vstack"
    },
    "LazyHStack": {
      "role": "hstack"
    },
    "Grid": {
      "role": "grid",
      "doc": "Grid of GridRow children, or columns: n"
    },
    "GridRow": {
      "role": "gridrow"
    },
    "LazyVGrid": {
      "role": "grid",
      "doc": "columns: [GridItem(.flexible()), …] or a count"
    },
    "LazyHGrid": {
      "role": "grid"
    },
    "ScrollView": {
      "role": "scroll",
      "params": [
        "axes"
      ]
    },
    "Group": {
      "role": "group"
    },
    "Spacer": {
      "role": "spacer"
    },
    "Divider": {
      "role": "divider"
    },
    "Rectangle": {
      "role": "shape",
      "defaults": {
        "shape": "rectangle"
      }
    },
    "RoundedRectangle": {
      "role": "shape",
      "defaults": {
        "shape": "rounded"
      }
    },
    "Circle": {
      "role": "shape",
      "defaults": {
        "shape": "circle"
      }
    },
    "Capsule": {
      "role": "shape",
      "defaults": {
        "shape": "capsule"
      }
    },
    "Ellipse": {
      "role": "shape",
      "defaults": {
        "shape": "ellipse"
      }
    },
    "Color": {
      "role": "color",
      "params": [
        "color"
      ]
    },
    "Text": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Text with **bold**, *italic*, `code` Markdown"
    },
    "Label": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "Label(\"Inbox\", systemImage: \"tray\")"
    },
    "Image": {
      "role": "image",
      "params": [
        "name"
      ],
      "doc": "Image(\"path.png\") or Image(systemName: \"star\")"
    },
    "AsyncImage": {
      "role": "image",
      "params": [
        "url"
      ]
    },
    "Icon": {
      "role": "icon",
      "params": [
        "name"
      ]
    },
    "Avatar": {
      "role": "avatar",
      "params": [
        "name"
      ]
    },
    "Badge": {
      "role": "badge",
      "params": [
        "text"
      ]
    },
    "Chip": {
      "role": "chip",
      "params": [
        "label"
      ]
    },
    "Tag": {
      "role": "chip",
      "params": [
        "label"
      ]
    },
    "Link": {
      "role": "link",
      "params": [
        "label",
        "destination"
      ]
    },
    "ProgressView": {
      "role": "progress",
      "params": [
        "label"
      ],
      "doc": "value: 0…1 (or total:); none = indeterminate"
    },
    "Gauge": {
      "role": "progress",
      "params": [
        "value"
      ],
      "defaults": {
        "variant": "gauge"
      }
    },
    "Rating": {
      "role": "rating",
      "params": [
        "value"
      ]
    },
    "Placeholder": {
      "role": "placeholder",
      "params": [
        "label"
      ],
      "doc": "A labelled box for maps, charts, media"
    },
    "Chart": {
      "role": "chart",
      "doc": "kind: .bar|.line|.area|.pie|.donut|.scatter|.bubble|.radar|.heatmap|.funnel|.treemap|.gauge|.candlestick|.combo|.sparkline; values:/series:/labels:/points:/matrix:",
      "sample": "Chart(values: [42, 58, 35, 64], labels: [\"Q1\", \"Q2\", \"Q3\", \"Q4\"])"
    },
    "Button": {
      "role": "button",
      "params": [
        "label"
      ],
      "doc": "Button(\"Save\", systemImage:) · .buttonStyle(…)"
    },
    "IconButton": {
      "role": "button",
      "params": [
        "icon"
      ],
      "defaults": {
        "iconOnly": true
      }
    },
    "FloatingActionButton": {
      "role": "fab",
      "params": [
        "icon"
      ]
    },
    "Toggle": {
      "role": "toggle",
      "params": [
        "label"
      ],
      "doc": "Toggle(\"Wi-Fi\", isOn: true)"
    },
    "Checkbox": {
      "role": "checkbox",
      "params": [
        "label"
      ]
    },
    "RadioButton": {
      "role": "radio",
      "params": [
        "label"
      ]
    },
    "RadioGroup": {
      "role": "radiogroup",
      "params": [
        "label"
      ]
    },
    "TextField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "doc": "TextField(\"Placeholder\", text: \"value\")"
    },
    "SecureField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "password"
      }
    },
    "TextEditor": {
      "role": "textfield",
      "params": [
        "text"
      ],
      "defaults": {
        "kind": "multiline"
      }
    },
    "SearchField": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "search"
      }
    },
    "Picker": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "Picker(\"Size\", selection: \"M\") { Text(\"S\") … }",
      "sample": "Picker(\"Size\", selection: \"Medium\") { Text(\"Small\"); Text(\"Medium\"); Text(\"Large\") }"
    },
    "SegmentedControl": {
      "role": "segmented",
      "params": [
        "items"
      ]
    },
    "Slider": {
      "role": "slider",
      "doc": "Slider(value: 0.4) or Slider(value: 30, in: 0...100)"
    },
    "Stepper": {
      "role": "stepper",
      "params": [
        "label"
      ]
    },
    "DatePicker": {
      "role": "datepicker",
      "params": [
        "label"
      ],
      "doc": "selection: \"2026-11-23\"; .datePickerStyle(.graphical)",
      "sample": "DatePicker(\"Starts\", selection: \"2026-11-23\")"
    },
    "Calendar": {
      "role": "calendar"
    },
    "Dropzone": {
      "role": "dropzone",
      "params": [
        "label"
      ]
    },
    "NavigationStack": {
      "role": "navstack",
      "doc": "Content's .navigationTitle / .toolbar form the bar"
    },
    "NavigationView": {
      "role": "navstack"
    },
    "NavigationSplitView": {
      "role": "split",
      "doc": "{ sidebar } content: { … } detail: { … }",
      "sample": "NavigationSplitView {\n  List {\n    Label(\"Inbox\", systemImage: \"tray\")\n    Label(\"Sent\", systemImage: \"paperplane\")\n    Label(\"Archive\", systemImage: \"archivebox\")\n  }.navigationTitle(\"Mail\")\n} detail: {\n  Text(\"Select a message\")\n}"
    },
    "TabView": {
      "role": "tabs",
      "defaults": {
        "placement": "bottom"
      },
      "doc": "Children with .tabItem { Label } or Tab(…)"
    },
    "Tab": {
      "role": "tab",
      "params": [
        "label"
      ],
      "doc": "Tab(\"Home\", systemImage: \"house\") { … }",
      "sample": "TabView {\n  Tab(\"Home\", systemImage: \"house\") { Text(\"Welcome home\") }\n  Tab(\"Search\", systemImage: \"magnifyingglass\") { Text(\"Search the library\") }\n  Tab(\"Profile\", systemImage: \"person\") { Text(\"Your profile\") }\n}"
    },
    "Tabs": {
      "role": "tabs",
      "params": [
        "items"
      ],
      "defaults": {
        "placement": "top"
      }
    },
    "AppBar": {
      "role": "appbar",
      "params": [
        "title"
      ]
    },
    "Sidebar": {
      "role": "sidebar",
      "params": [
        "title"
      ]
    },
    "NavItem": {
      "role": "navitem",
      "params": [
        "label"
      ]
    },
    "Breadcrumb": {
      "role": "breadcrumb",
      "params": [
        "items"
      ]
    },
    "Pagination": {
      "role": "pagination"
    },
    "Steps": {
      "role": "steps",
      "params": [
        "steps"
      ]
    },
    "Card": {
      "role": "card",
      "params": [
        "title"
      ]
    },
    "GroupBox": {
      "role": "card",
      "params": [
        "title"
      ]
    },
    "Section": {
      "role": "section",
      "params": [
        "title"
      ],
      "doc": "Section(\"Header\") { … } footer: { … }"
    },
    "List": {
      "role": "list",
      "doc": ".listStyle(.insetGrouped|.plain|.sidebar|…)"
    },
    "Row": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "doc": "title, subtitle:, detail:, systemImage:, chevron:"
    },
    "ListItem": {
      "role": "listitem",
      "params": [
        "title"
      ]
    },
    "NavigationLink": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "defaults": {
        "chevron": true
      }
    },
    "LabeledContent": {
      "role": "labeled",
      "params": [
        "label",
        "value"
      ]
    },
    "Form": {
      "role": "form"
    },
    "Table": {
      "role": "table",
      "doc": "columns: [\"Name\", …], rows: [[…], …] or TableRow children"
    },
    "TableRow": {
      "role": "tablerow"
    },
    "TableColumn": {
      "role": "tablecolumn",
      "params": [
        "title"
      ]
    },
    "Toolbar": {
      "role": "toolbar"
    },
    "ToolbarItem": {
      "role": "toolbaritem",
      "doc": "ToolbarItem(placement: .topBarTrailing) { … }"
    },
    "ToolbarItemGroup": {
      "role": "toolbaritem"
    },
    "ControlGroup": {
      "role": "toolbar",
      "defaults": {
        "variant": "group"
      }
    },
    "DisclosureGroup": {
      "role": "accordion",
      "params": [
        "title"
      ]
    },
    "Accordion": {
      "role": "accordion",
      "params": [
        "title"
      ]
    },
    "Dialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "sample": "Dialog(\"Rename file\", message: \"Enter a new name for the report.\", actions: { Button(\"Cancel\"); Button(\"Rename\") }) { TextField(\"Name\", text: \"Quarterly report\") }"
    },
    "Alert": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert"
      },
      "sample": "Alert(\"Delete this draft?\", message: \"The draft and its attachments will be removed permanently.\", actions: { Button(\"Cancel\", role: .cancel); Button(\"Delete\", role: .destructive) })"
    },
    "Sheet": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "sheet"
      },
      "sample": "Sheet(\"New reminder\", message: \"It is added to your Today list.\", actions: { Button(\"Cancel\"); Button(\"Add\") }) {\n  TextField(\"Title\", text: \"Call the dentist\")\n  Toggle(\"Remind me on a day\", isOn: true)\n}"
    },
    "Menu": {
      "role": "menu",
      "params": [
        "label"
      ]
    },
    "MenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ]
    },
    "Tooltip": {
      "role": "tooltip",
      "params": [
        "text"
      ],
      "sample": "Tooltip(\"Share a link to this page\") { Button(\"Share\", systemImage: \"square.and.arrow.up\") }"
    },
    "Toast": {
      "role": "toast",
      "params": [
        "message"
      ],
      "sample": "Toast(\"Message sent\", description: \"Your reply reached 3 people.\", action: \"Undo\", systemImage: \"checkmark.circle\")"
    },
    "Banner": {
      "role": "alert",
      "params": [
        "title"
      ]
    },
    "Spreadsheet": {
      "role": "spreadsheet",
      "doc": "rows: [[…]], selection: \"B2:C4\", active:, formula:, sheets: [..], highlight: [\"B3\": .yellow]"
    },
    "StickyNote": {
      "role": "stickynote",
      "params": [
        "text"
      ],
      "doc": "StickyNote(\"Call Ana\", color: .yellow, rotation: -2, author:)"
    },
    "Board": {
      "role": "board",
      "doc": "Kanban board of BoardColumn children"
    },
    "BoardColumn": {
      "role": "boardcolumn",
      "params": [
        "title"
      ],
      "doc": "BoardColumn(\"To do\", count:, color:) { KanbanCard(…) }"
    },
    "KanbanCard": {
      "role": "kanbancard",
      "params": [
        "title"
      ],
      "doc": "title, description:, tags: [..], assignees: [..], due:, comments:, priority:"
    },
    "CodeEditor": {
      "role": "code",
      "params": [
        "code"
      ],
      "doc": "CodeEditor(\"…\", language: \"swift\", lineNumbers:, highlight: [3], tabs: [..])"
    },
    "CodeBlock": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "lineNumbers": false
      }
    },
    "Terminal": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "variant": "terminal"
      },
      "doc": "lines starting with \"$ \" are commands"
    },
    "MessageBubble": {
      "role": "message",
      "params": [
        "text"
      ],
      "doc": "MessageBubble(\"Hi\", from: .me|.them, author:, time:, status:, reactions: [..])",
      "sample": "MessageBubble(\"Running ten minutes late because the train stopped outside the station, so please start the meeting without me.\", author: \"Ana Lima\", time: \"09:41\")"
    },
    "Comment": {
      "role": "message",
      "params": [
        "text"
      ],
      "defaults": {
        "variant": "comment"
      },
      "doc": "author:, time:, avatar:"
    },
    "Tree": {
      "role": "tree",
      "doc": "Tree { TreeItem(\"src\") { TreeItem(\"main.swift\") } }"
    },
    "TreeItem": {
      "role": "treeitem",
      "params": [
        "label"
      ],
      "doc": "label, systemImage:, folder:, expanded:, selected:, detail:"
    },
    "Timeline": {
      "role": "timeline"
    },
    "TimelineItem": {
      "role": "timelineitem",
      "params": [
        "title"
      ],
      "doc": "title, time:, description:, systemImage:, status:"
    },
    "Gantt": {
      "role": "gantt",
      "doc": "scale: [\"W1\",…], tasks: [(\"Design\", 0, 2, 0.6), …], today:"
    },
    "Schedule": {
      "role": "schedule",
      "doc": "days: [..], startHour:, endHour:, events: [(\"Standup\", \"Mon\", 9, 9.5, .blue)], now:"
    },
    "Kbd": {
      "role": "kbd",
      "params": [
        "keys"
      ],
      "doc": "Kbd([\"⌘\", \"K\"]) or Kbd(\"Esc\")"
    },
    "Skeleton": {
      "role": "skeleton",
      "doc": "lines:, avatar:, image:, shape: .circle|.rectangle|.text"
    },
    "ColorSwatches": {
      "role": "swatches",
      "doc": "colors: [.red, \"#0af\", …], selection:"
    },
    "Canvas": {
      "role": "canvas",
      "doc": "free-form area; place children with .position(x:y:); grid: .dots|.lines"
    },
    "Whiteboard": {
      "role": "canvas",
      "defaults": {
        "grid": "dots"
      }
    },
    "VideoPlayer": {
      "role": "media",
      "params": [
        "image"
      ],
      "doc": "poster image, progress: 0…1, time:, duration:, playing:"
    },
    "EmptyState": {
      "role": "emptystate",
      "params": [
        "title"
      ],
      "doc": "title, systemImage:, description: { actions }"
    },
    "Stat": {
      "role": "stat",
      "params": [
        "label",
        "value"
      ],
      "doc": "Stat(\"Revenue\", \"$48k\", change: \"+12%\", trend: [..], systemImage:)"
    },
    "Map": {
      "role": "map",
      "doc": "pins: [(x%, y%, \"label\")], route:, showsUserLocation:, height:"
    },
    "Callout": {
      "role": "callout",
      "params": [
        "number",
        "text"
      ],
      "doc": "a numbered annotation; place with .position(x:y:)"
    },
    "Pointer": {
      "role": "pointer",
      "params": [
        "kind"
      ],
      "doc": "Pointer(.arrow|.hand|.ibeam|.grab|.crosshair|.touch); place with .position"
    },
    "SelectionRect": {
      "role": "marquee",
      "doc": "a drag-selection rectangle; size with .frame, place with .position"
    },
    "BarChart": {
      "role": "chart",
      "defaults": {
        "kind": "bar"
      },
      "sample": "BarChart(values: [42, 58, 35, 64], labels: [\"Q1\", \"Q2\", \"Q3\", \"Q4\"], title: \"Orders\")"
    },
    "LineChart": {
      "role": "chart",
      "defaults": {
        "kind": "line"
      },
      "sample": "LineChart(values: [18, 22, 19, 27, 25, 31], labels: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\"], title: \"Revenue\")"
    },
    "AreaChart": {
      "role": "chart",
      "defaults": {
        "kind": "area"
      },
      "sample": "AreaChart(values: [12, 18, 15, 24, 21, 30], labels: [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\"], title: \"Active users\")"
    },
    "PieChart": {
      "role": "chart",
      "defaults": {
        "kind": "pie"
      },
      "sample": "PieChart(values: [55, 25, 20], labels: [\"Desktop\", \"Mobile\", \"Tablet\"])"
    },
    "DonutChart": {
      "role": "chart",
      "defaults": {
        "kind": "donut"
      },
      "sample": "DonutChart(values: [45, 30, 25], labels: [\"Direct\", \"Search\", \"Social\"])"
    },
    "ScatterChart": {
      "role": "chart",
      "defaults": {
        "kind": "scatter"
      },
      "sample": "ScatterChart(points: [[1, 3], [2, 5], [3, 4], [4, 7], [5, 6], [6, 9], [7, 8]], xLabel: \"Hours\", yLabel: \"Score\")"
    },
    "BubbleChart": {
      "role": "chart",
      "defaults": {
        "kind": "bubble"
      },
      "sample": "BubbleChart(points: [[1, 3, 4], [2, 6, 9], [4, 4, 2], [5, 8, 6], [6, 5, 3]], xLabel: \"Price\", yLabel: \"Rating\")"
    },
    "RadarChart": {
      "role": "chart",
      "defaults": {
        "kind": "radar"
      },
      "sample": "RadarChart(values: [4, 3, 5, 2, 4], labels: [\"Speed\", \"Power\", \"Range\", \"Cost\", \"Comfort\"])"
    },
    "Heatmap": {
      "role": "chart",
      "defaults": {
        "kind": "heatmap"
      },
      "sample": "Heatmap(matrix: [[1, 4, 2, 5, 3], [3, 6, 4, 2, 5], [5, 2, 7, 3, 1]], labels: [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\"], yLabels: [\"Morning\", \"Noon\", \"Evening\"])"
    },
    "FunnelChart": {
      "role": "chart",
      "defaults": {
        "kind": "funnel"
      },
      "sample": "FunnelChart(values: [1200, 640, 310, 120], labels: [\"Visits\", \"Sign-ups\", \"Trials\", \"Purchases\"])"
    },
    "Treemap": {
      "role": "chart",
      "defaults": {
        "kind": "treemap"
      },
      "sample": "Treemap(values: [48, 26, 14, 8, 4], labels: [\"Photos\", \"Video\", \"Mail\", \"Apps\", \"Other\"])"
    },
    "GaugeChart": {
      "role": "chart",
      "defaults": {
        "kind": "gauge"
      },
      "sample": "GaugeChart(value: 72, unit: \"%\")"
    },
    "CandlestickChart": {
      "role": "chart",
      "defaults": {
        "kind": "candlestick"
      },
      "sample": "CandlestickChart(points: [[20, 26, 18, 24], [24, 28, 22, 23], [23, 25, 19, 21], [21, 27, 20, 26], [26, 30, 25, 29]], labels: [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\"])"
    },
    "Histogram": {
      "role": "chart",
      "defaults": {
        "kind": "histogram"
      },
      "sample": "Histogram(values: [2, 6, 11, 14, 9, 4], labels: [\"0\", \"10\", \"20\", \"30\", \"40\", \"50\"], xLabel: \"Minutes\")"
    },
    "ComboChart": {
      "role": "chart",
      "defaults": {
        "kind": "combo"
      },
      "sample": "ComboChart(values: [[40, 52, 48, 61], [45, 50, 55, 60]], labels: [\"Q1\", \"Q2\", \"Q3\", \"Q4\"], seriesNames: [\"Revenue\", \"Target\"])"
    },
    "Sparkline": {
      "role": "chart",
      "params": [
        "values"
      ],
      "defaults": {
        "kind": "sparkline"
      },
      "sample": "Sparkline([3, 5, 4, 6, 5, 8, 7, 9])"
    }
  }
}
