      "window-shadow": "0 0 0 0.5px rgb(0 0 0 / 0.18), 0 22px 56px rgb(0 0 0 / 0.22), 0 4px 12px rgb(0 0 0 / 0.08)"
    },
    "dark": {
      "bg": "#000000", "surface": "#1c1c1e", "surface-2": "#1c1c1e", "surface-3": "#3a3a3c",
      "fg": "#ffffff", "fg-2": "rgb(235 235 245 / 0.6)", "fg-3": "rgb(235 235 245 / 0.3)", "fg-4": "rgb(235 235 245 / 0.16)",
      "border": "#38383a", "divider": "rgb(84 84 88 / 0.65)",
      "accent": "#0a84ff", "on-accent": "#ffffff", "accent-soft": "rgb(10 132 255 / 0.22)",
      "danger": "#ff453a", "warning": "#ff9f0a", "success": "#30d158", "info": "#0a84ff",
      "field-bg": "#1c1c1e", "field-border": "rgb(84 84 88 / 0.65)", "scrim": "rgb(0 0 0 / 0.48)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / 0.4), 0 3px 8px rgb(0 0 0 / 0.3)",
      "shadow-2": "0 4px 16px rgb(0 0 0 / 0.5)",
      "shadow-3": "0 10px 40px rgb(0 0 0 / 0.6)",
      "chrome-bg": "#1e1e1e", "chrome-fg": "#ffffff",
      "color-red": "#ff453a", "color-orange": "#ff9f0a", "color-yellow": "#ffd60a", "color-green": "#30d158",
      "color-mint": "#63e6e2", "color-teal": "#40c8e0", "color-cyan": "#64d2ff", "color-blue": "#0a84ff",
      "color-indigo": "#5e5ce6", "color-purple": "#bf5af2", "color-pink": "#ff375f", "color-brown": "#ac8e68",
      "color-gray": "#8e8e93",
      "chart-1": "#0a84ff", "chart-2": "#30d158", "chart-3": "#ff9f0a", "chart-4": "#bf5af2",
      "chart-5": "#ff375f", "chart-6": "#64d2ff",

      "grouped-bg": "#000000", "cell-bg": "#1c1c1e", "cell-pressed": "#3a3a3c",
      "fill": "rgb(120 120 128 / 0.36)", "fill-2": "rgb(120 120 128 / 0.32)",
      "fill-3": "rgb(118 118 128 / 0.24)", "fill-4": "rgb(118 118 128 / 0.18)",
      "separator": "rgb(84 84 88 / 0.6)", "chevron": "rgb(235 235 245 / 0.3)",
      "switch-on": "#30d158", "switch-off": "rgb(120 120 128 / 0.32)", "segment-sel": "#636366",
      "glass-bg": "rgb(44 44 46 / 0.66)", "glass-strong": "rgb(40 40 42 / 0.86)",
      "glass-edge": "rgb(255 255 255 / 0.14)", "glass-line": "rgb(255 255 255 / 0.08)",
      "glass-shadow": "0 8px 24px rgb(0 0 0 / 0.45), 0 1px 3px rgb(0 0 0 / 0.4)",
      "bar-bg": "rgb(22 22 23 / 0.8)",
      "alert-bg": "rgb(44 44 46 / 0.92)", "alert-line": "rgb(84 84 88 / 0.65)",
      "menu-bg": "rgb(40 40 42 / 0.9)",
      "sidebar-bg": "rgb(38 38 40 / 0.78)", "sidebar-sel": "rgb(255 255 255 / 0.1)",
      "mac-window": "#1e1e1e", "mac-control": "rgb(255 255 255 / 0.1)", "mac-control-line": "rgb(255 255 255 / 0.08)",
      "mac-row-alt": "rgb(255 255 255 / 0.04)", "mac-toolbar": "#1e1e1e",
      "avatar-top": "#6e7380", "avatar-bottom": "#4f535c",
      "map-land": "#2b2d30", "map-park": "#28392a", "map-water": "#1d3346", "map-road": "#45474c",
      "video-bg": "#000000", "tab-sel": "rgb(118 118 128 / 0.26)",
      "sheet-grouped-bg": "#1c1c1e", "sheet-cell-bg": "#2c2c2e",
      "wallpaper": "linear-gradient(155deg, #16224d 0%, #253a85 38%, #4b2f7c 70%, #6b2550 100%)",
      "window-shadow": "0 0 0 0.5px rgb(255 255 255 / 0.16), 0 22px 56px rgb(0 0 0 / 0.55), 0 4px 12px rgb(0 0 0 / 0.3)"
    }
  },
  "fonts": {
    "extraLargeTitle": "largeTitle",
    "extraLargeTitle2": "title",
    "largeTitle2": "title"
  },
  "icons": {
    "antenna.radiowaves.left.and.right": "cellularbars",
    "personalhotspot": "link",
    "dot.radiowaves.left.and.right": "speaker",
    "hourglass": "clock",
    "accessibility": "person.circle",
    "faceid": "person.crop.circle",
    "touchid": "key",
    "hand.raised": "shield",
    "hand.raised.fill": "shield",
    "figure.walk": "person",
    "figure.run": "person",
    "flame": "bolt",
    "flame.fill": "bolt",
    "bed.double": "moon",
    "bed.double.fill": "moon",
    "drop": "circle",
    "drop.fill": "circle.fill",
    "textformat.size": "sun",
    "sun.max": "sun",
    "speaker.wave.3": "speaker",
    "speaker.wave.3.fill": "speaker",
    "bell.badge": "bell",
    "bell.badge.fill": "bell",
    "note.text": "doc",
    "doc.text.magnifyingglass": "doc",
    "xmark.bin": "trash",
    "tray.and.arrow.down": "tray",
    "paintbrush": "sparkles",
    "paintbrush.fill": "sparkles",
    "apple.logo": "app",
    "applelogo": "app",
    "rectangle.stack": "square.stack",
    "doc.on.clipboard": "doc.on.doc",
    "photo.on.rectangle.angled": "photo",
    "sos": "exclamationmark.circle",
    "iphone": "phone",
    "macbook": "app",
    "creditcard.fill": "creditcard",
    "wallet.pass": "creditcard",
    "envelope.open": "envelope",
    "chart.bar.xaxis": "chart.bar",
    "list.bullet.rectangle": "list.bullet",
    "arrow.uturn.backward": "arrowshape.turn.up.left",
    "arrowshape.turn.up.right": "arrow.right",
    "magnifyingglass": "search"
  },
  "modifiers": {
    "tableStyle": {"attr": "variant"},
    "tag": {"attr": "tag"},
    "controlGroupStyle": {"attr": "variant"},
    "disclosureGroupStyle": {"attr": "variant"},
    "labeledContentStyle": {"attr": "variant"},
    "indexViewStyle": {"attr": "indexViewStyle"},
    "headerProminence": {"attr": "emphasis"},
    "listSectionSpacing": {"attr": "sectionSpacing"},
    "contentMargins": {"attr": "contentMargins"},
    "symbolEffect": {"attr": "symbolEffect"},
    "tabBarMinimizeBehavior": {"attr": "tabBarMinimizeBehavior"},
    "toolbarTitleDisplayMode": {"attr": "titleDisplayMode"},
    "navigationSplitViewColumnWidth": {"attr": "columnWidth"},
    "presentationBackground": {"attr": "presentationBackground"},
    "presentationCornerRadius": {"attr": "presentationCornerRadius"},
    "scrollEdgeEffectStyle": {"attr": "scrollEdgeEffectStyle"},
    "backgroundExtensionEffect": {"attr": "backgroundExtensionEffect"},
    "searchToolbarBehavior": {"attr": "searchToolbarBehavior"},
    "chartLegend": {"attr": "chartLegend"},
    "chartXAxis": {"attr": "chartXAxis"},
    "chartYAxis": {"attr": "chartYAxis"},
    "mapStyle": {"attr": "mapStyle"}
  },
  "elements": {
    "Text": {"role": "text", "params": ["content"], "doc": "Text(\"Hello\") with **bold**, *italic*, `code`; .font(.headline) etc."},
    "Label": {"role": "label", "params": ["title"], "doc": "Label(\"Inbox\", systemImage: \"tray\"); .labelStyle(.iconOnly|.titleOnly|.titleAndIcon)"},
    "Image": {"role": "image", "params": ["name"], "doc": "Image(\"asset.png\") or Image(systemName: \"star.fill\")"},
    "AsyncImage": {"role": "image", "params": ["url"], "doc": "AsyncImage(url: \"photo.jpg\")"},
    "Link": {"role": "link", "params": ["label", "destination"], "doc": "Link(\"Privacy Policy\", destination: url) — accent text"},
    "ShareLink": {"role": "button", "params": ["label"], "defaults": {"label": "Share", "systemImage": "square.and.arrow.up"}, "doc": "ShareLink(item: url) — share-sheet button"},
    "HelpLink": {"role": "button", "defaults": {"systemImage": "questionmark", "iconOnly": true, "variant": "help"}, "doc": "macOS round help (?) button"},
    "SettingsLink": {"role": "button", "params": ["label"], "defaults": {"label": "Settings…"}, "doc": "macOS button that opens the Settings window"},

    "Button": {"role": "button", "params": ["label"], "variants": ["automatic", "borderless", "plain", "bordered", "borderedProminent", "glass", "glassProminent", "link", "accessoryBar", "accessoryBarAction", "card"], "doc": "Button(\"Save\", systemImage:, role: .destructive|.cancel) · .buttonStyle(.bordered|.borderedProminent|.glass|.glassProminent) · .controlSize(.small|.large)", "sample": "Button(\"Share\", systemImage: \"square.and.arrow.up\")"},
    "EditButton": {"role": "button", "params": ["label"], "defaults": {"label": "Edit"}, "doc": "Toggles a list's edit mode — plain accent text"},
    "PasteButton": {"role": "button", "params": ["label"], "defaults": {"label": "Paste", "systemImage": "doc.on.clipboard", "variant": "bordered"}, "doc": "System paste button (bordered capsule)"},
    "RenameButton": {"role": "button", "params": ["label"], "defaults": {"label": "Rename", "systemImage": "pencil"}, "doc": "Triggers a rename action"},
    "SignInWithAppleButton": {"role": "button", "params": ["label"], "defaults": {"label": "Sign in with Apple", "variant": "signInWithApple"}, "doc": "AuthenticationServices button — black capsule (white in dark)"},
    "PhotosPicker": {"role": "button", "params": ["label"], "defaults": {"label": "Select Photos", "systemImage": "photo"}, "doc": "PhotosPicker(\"Select Photos\", selection:) — opens the photo picker"},
    "Toggle": {"role": "toggle", "params": ["label"], "variants": ["automatic", "switch", "button", "checkbox"], "doc": "Toggle(\"Wi-Fi\", isOn: true) — 51×31 green switch; .toggleStyle(.button|.checkbox)", "sample": "Toggle(\"Wi-Fi\", isOn: true)"},
    "Picker": {"role": "select", "params": ["label"], "defaults": {"variant": "menu"}, "variants": ["automatic", "menu", "segmented", "inline", "radioGroup", "wheel", "navigationLink", "palette"], "doc": "Picker(\"Sort\", selection: \"Date\") { Text(\"Date\") … } · .pickerStyle(.segmented|.inline|.navigationLink)", "sample": "Picker(\"Flavor\", selection: \"Vanilla\") { Text(\"Chocolate\"); Text(\"Vanilla\"); Text(\"Strawberry\") }"},
    "TextField": {"role": "textfield", "params": ["placeholder"], "variants": ["automatic", "plain", "roundedBorder"], "doc": "TextField(\"Email\", text: $email); plain in a Form, .textFieldStyle(.roundedBorder) elsewhere; axis: .vertical"},
    "SecureField": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "password"}, "variants": ["automatic", "plain", "roundedBorder"], "doc": "SecureField(\"Password\", text: $password)"},
    "TextEditor": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline"}, "doc": "TextEditor(text: $notes) — multi-line editor"},
    "Slider": {"role": "slider", "doc": "Slider(value: 0.4) { Text(\"Volume\") } minimumValueLabel: { Image(systemName: \"speaker\") } …"},
    "Stepper": {"role": "stepper", "params": ["label"], "doc": "Stepper(\"Guests\", value: 2) — −/+ capsule"},
    "DatePicker": {"role": "datepicker", "params": ["label"], "defaults": {"variant": "automatic"}, "variants": ["automatic", "compact", "graphical", "wheel", "field", "stepperField"], "doc": "DatePicker(\"Starts\", selection: \"2026-11-23\") — compact grey capsule; .datePickerStyle(.graphical) for the calendar", "sample": "DatePicker(\"Starts\", selection: \"2026-11-23\")"},
    "MultiDatePicker": {"role": "calendar", "params": ["label"], "doc": "MultiDatePicker(\"Dates\", selection:) — calendar with several marked days (events:)"},
    "ColorPicker": {"role": "labeled", "params": ["label"], "doc": "ColorPicker(\"Tint\", selection: .blue) — label with the rainbow colour well"},
    "Gauge": {"role": "progress", "params": ["value"], "defaults": {"variant": "automatic"}, "variants": ["automatic", "accessoryCircular", "accessoryCircularCapacity", "accessoryLinear", "accessoryLinearCapacity", "linearCapacity"], "doc": "Gauge(value: 0.7, label: { Text(\"BPM\") }, currentValueLabel: { Text(\"72\") }) · .gaugeStyle(…)", "sample": "Gauge(value: 0.72, label: \"Battery\", currentValueLabel: \"72%\", minimumValueLabel: \"0\", maximumValueLabel: \"100\")"},
    "ProgressView": {"role": "progress", "params": ["label"], "variants": ["automatic", "linear", "circular"], "doc": "ProgressView() spinner, or ProgressView(\"Uploading\", value: 0.4)"},

    "List": {"role": "list", "defaults": {"variant": "insetGrouped"}, "variants": ["automatic", "insetGrouped", "grouped", "inset", "plain", "sidebar", "bordered"], "doc": "List { Section(\"…\") { … } } — inset-grouped by default; .listStyle(.plain|.sidebar|.grouped)", "sample": "List(selection: \"Inbox\") {\n  Section(\"Favourites\") {\n    Label(\"Inbox\", systemImage: \"tray\")\n    Label(\"Drafts\", systemImage: \"doc\")\n  }\n  Section(\"Folders\") {\n    Label(\"Archive\", systemImage: \"archivebox\")\n    Label(\"Projects\", systemImage: \"folder\")\n  }\n}"},
    "Form": {"role": "form", "defaults": {"variant": "automatic"}, "variants": ["automatic", "grouped", "columns"], "doc": "Form { Section { TextField … Toggle … } } — automatic: inset-grouped rows on iPhone and iPad, columns on the Mac · .formStyle(.grouped|.columns)", "sample": "Form {\n  Section(\"Account\") {\n    TextField(\"Name\", text: \"Ana Lima\")\n    Toggle(\"Notifications\", isOn: true)\n  }\n  Section(\"Display\") {\n    Picker(\"Appearance\", selection: \"Automatic\") { Text(\"Light\"); Text(\"Dark\"); Text(\"Automatic\") }\n    Stepper(\"Font size\", value: 17)\n  }\n}"},
    "Section": {"role": "section", "params": ["title"], "doc": "Section(\"Header\") { … } footer: { Text(\"…\") }"},
    "TabSection": {"role": "section", "params": ["title"], "doc": "A group of Tabs (sidebar-adaptable TabView)"},
    "LabeledContent": {"role": "labeled", "params": ["label", "value"], "doc": "LabeledContent(\"Version\", value: \"26.1\") — label + secondary value"},
    "NavigationLink": {"role": "listitem", "params": ["title"], "defaults": {"chevron": true}, "doc": "NavigationLink(\"General\", systemImage: \"gear\", iconColor: .gray) — row with chevron"},
    "Row": {"role": "listitem", "params": ["title"], "doc": "Generic row: title, subtitle:, detail:, systemImage:, iconColor:, chevron:"},
    "DisclosureGroup": {"role": "accordion", "params": ["title"], "doc": "DisclosureGroup(\"Advanced\", isExpanded: true) { … }"},
    "OutlineGroup": {"role": "accordion", "params": ["title"], "doc": "Hierarchical rows; written here as a DisclosureGroup-like node: OutlineGroup(\"Folder\", isExpanded: true) { … }"},
    "GroupBox": {"role": "card", "params": ["title"], "doc": "GroupBox(\"Activity\") { … } — rounded secondary-background box"},
    "Card": {"role": "card", "params": ["title"], "doc": "Not SwiftUI: a rounded content tile like GroupBox"},
    "ControlGroup": {"role": "toolbar", "params": ["label"], "defaults": {"variant": "automatic"}, "variants": ["automatic", "navigation", "palette", "compactMenu", "menu"], "doc": "ControlGroup { Button … } — joined capsule of buttons", "sample": "ControlGroup { Button(\"Back\", systemImage: \"backward.fill\"); Button(\"Play\", systemImage: \"play.fill\"); Button(\"Forward\", systemImage: \"forward.fill\") }"},
    "Table": {"role": "table", "variants": ["automatic", "inset", "bordered"], "doc": "Table(columns: [\"Name\", \"Size\"], rows: [[…]]) or TableColumn / TableRow children — macOS/iPadOS table"},
    "TableColumn": {"role": "tablecolumn", "params": ["title"], "doc": "TableColumn(\"Name\")"},
    "TableRow": {"role": "tablerow", "doc": "TableRow { Text(…) … }"},

    "NavigationStack": {"role": "navstack", "doc": "NavigationStack { … .navigationTitle(\"Title\") .toolbar { … } } · back: \"Settings\" shows the glass back button"},
    "NavigationView": {"role": "navstack", "doc": "Deprecated alias of NavigationStack"},
    "NavigationSplitView": {"role": "split", "variants": ["automatic", "balanced", "prominentDetail"], "doc": "NavigationSplitView { sidebar } content: { … } detail: { … } — or unlabelled children (first sidebar, last detail); each column's .navigationTitle is its title", "sample": "NavigationSplitView {\n  List {\n    Label(\"Inbox\", systemImage: \"tray\")\n    Label(\"Sent\", systemImage: \"paperplane\")\n    Label(\"Archive\", systemImage: \"archivebox\")\n  }.navigationTitle(\"Mail\")\n} detail: {\n  Text(\"Select a message\")\n}"},
    "TabView": {"role": "tabs", "defaults": {"placement": "bottom"}, "variants": ["automatic", "page", "sidebarAdaptable", "tabBarOnly"], "doc": "TabView { Tab(\"Home\", systemImage: \"house\") { … } } — floating Liquid Glass tab bar · .tabViewStyle(.page) dots · .sidebarAdaptable sidebar on iPad and Mac", "sample": "TabView {\n  Tab(\"Home\", systemImage: \"house\") { Text(\"Welcome home\") }\n  Tab(\"Library\", systemImage: \"books.vertical\") { Text(\"Your library\") }\n  Tab(\"Search\", systemImage: \"magnifyingglass\") { Text(\"Search\") }\n}"},
    "Tab": {"role": "tab", "params": ["label"], "doc": "Tab(\"Search\", systemImage: \"magnifyingglass\") { … } · .badge(3) — one tab of a TabView; alone, one tab bar item", "sample": "TabView {\n  Tab(\"Home\", systemImage: \"house\") { Text(\"Welcome home\") }\n  Tab(\"Search\", systemImage: \"magnifyingglass\") { Text(\"Search the library\") }\n  Tab(\"Profile\", systemImage: \"person\") { Text(\"Your profile\") }\n}"},
    "ToolbarItem": {"role": "toolbaritem", "doc": "ToolbarItem(placement: .topBarTrailing|.topBarLeading|.principal|.bottomBar) { … }"},
    "ToolbarItemGroup": {"role": "toolbaritem", "doc": "ToolbarItemGroup(placement: .bottomBar) { … }"},
    "ToolbarSpacer": {"role": "spacer", "doc": "iOS 26: separates toolbar glass groups (.fixed / .flexible)"},
    "Toolbar": {"role": "toolbar", "doc": "Not SwiftUI: an inline bar of controls"},
    "Menu": {"role": "menu", "params": ["label"], "doc": "Menu(\"Sort\", systemImage:) { Button … } · open: true shows the glass menu"},
    "CommandMenu": {"role": "menu", "params": ["label"], "doc": "CommandMenu(\"Format\") { Button(\"Bold\").keyboardShortcut(\"b\"); Divider(); Toggle(\"Show Ruler\", isOn: true) } inside .commands { … } — a menu of the macOS menu bar (render option menubar), added before Window; .open() draws it open", "sample": "CommandMenu(\"Format\") { Button(\"Bold\").keyboardShortcut(\"b\"); Divider(); Toggle(\"Show Ruler\", isOn: true) }"},
    "CommandGroup": {"role": "group", "doc": "CommandGroup(replacing:|before:|after: .newItem|.saveItem|.pasteboard|…) { Button … } inside .commands { … } — edits a standard menu of the macOS menu bar at that placement", "sample": "CommandGroup(after: .newItem) { Button(\"New Folder\").keyboardShortcut(\"n\", modifiers: [.shift, .command]) }"},
    "Inspector": {"role": "card", "params": ["title"], "doc": "Inline inspector panel content (prefer the .inspector modifier)"},

    "Alert": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alert"}, "doc": "Alert(\"Delete?\", message: \"…\") { Button(\"Cancel\", role: .cancel); Button(\"Delete\", role: .destructive) } — iOS 26 glass card; the Button children (or actions:) are capsule actions, side by side for two, stacked for more · prefer .alert(…)", "sample": "Alert(\"Delete this photo?\", message: \"It will be removed from all your devices.\", actions: { Button(\"Cancel\", role: .cancel); Button(\"Delete\", role: .destructive) })"},
    "ConfirmationDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "action-sheet"}, "doc": "ConfirmationDialog(\"Discard?\", message: \"…\") { Button(\"Discard\", role: .destructive); Button(\"Cancel\", role: .cancel) } — action sheet on iPhone, alert-style on iPad and Mac · prefer .confirmationDialog(…)", "sample": "ConfirmationDialog(\"Discard your changes?\", message: \"Your edits to this note have not been saved.\", actions: { Button(\"Discard Changes\", role: .destructive); Button(\"Keep Editing\"); Button(\"Cancel\", role: .cancel) })"},
    "ActionSheet": {"role": "dialog", "params": ["title"], "defaults": {"variant": "action-sheet"}, "doc": "Deprecated action sheet"},
    "Sheet": {"role": "dialog", "params": ["title"], "defaults": {"variant": "sheet"}, "doc": "Bottom sheet; prefer .sheet(isPresented:) { … }", "sample": "Sheet(\"New event\", actions: { Button(\"Cancel\"); Button(\"Add\") }) {\n  TextField(\"Title\", text: \"Team lunch\")\n  DatePicker(\"Starts\", selection: \"2026-11-23\")\n}"},
    "Popover": {"role": "dialog", "params": ["title"], "defaults": {"variant": "popover"}, "doc": "Popover(\"Filters\") { … } — glass bubble with an arrow; alone it points at a placeholder button · prefer .popover(isPresented:)", "sample": "Popover(\"Filters\") { Toggle(\"Unread only\", isOn: true); Toggle(\"Flagged\", isOn: false) }"},
    "TipView": {"role": "alert", "params": ["title"], "defaults": {"closable": true, "systemImage": "lightbulb"}, "doc": "TipKit tip: TipView(\"Favorites\", message: \"Tap the star…\")"},
    "ContentUnavailableView": {"role": "dialog", "params": ["title"], "defaults": {"inline": true, "variant": "unavailable"}, "doc": "ContentUnavailableView(\"No Mail\", systemImage: \"tray\", description: Text(\"…\")) { actions } "},

    "Map": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "mappin"}, "doc": "MapKit map placeholder (streets, park, water, pin)"},
    "VideoPlayer": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "play"}, "doc": "AVKit video placeholder with play button"},
    "WebView": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "globe"}, "doc": "iOS 26 SwiftUI WebView placeholder"},
    "SceneView": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "cube"}, "doc": "SceneKit / RealityKit view placeholder"},
    "RealityView": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "cube"}, "doc": "RealityKit view placeholder"},
    "SpriteView": {"role": "placeholder", "params": ["label"], "defaults": {"systemImage": "sparkles"}, "doc": "SpriteKit scene placeholder"},
    "Canvas": {"role": "placeholder", "params": ["label"], "doc": "Canvas drawing placeholder"},
    "Chart": {"role": "chart", "variants": ["bar", "line", "area", "pie", "donut", "sparkline"], "doc": "Swift Charts: Chart(kind: .bar|.line|.area|.pie|.donut, values: [..], labels: [..]) or series: [[..], [..]]"},
    "BarMark": {"role": "chart", "defaults": {"kind": "bar"}, "doc": "A bar chart: BarMark(values: [..], labels: [..])"},
    "LineMark": {"role": "chart", "defaults": {"kind": "line"}, "doc": "A line chart: LineMark(values: [..], labels: [..])"},
    "AreaMark": {"role": "chart", "defaults": {"kind": "area"}, "doc": "An area chart: AreaMark(values: [..], labels: [..])"},
    "SectorMark": {"role": "chart", "defaults": {"kind": "donut"}, "doc": "A donut chart: SectorMark(values: [..], labels: [..])"},
    "PointMark": {"role": "chart", "defaults": {"kind": "line"}, "doc": "A point/line chart: PointMark(values: [..])"},

    "ScrollView": {"role": "scroll", "params": ["axes"], "doc": "ScrollView { … } or ScrollView(.horizontal) { … }"},
    "ScrollViewReader": {"role": "group", "doc": "Transparent container"},
    "GeometryReader": {"role": "vstack", "doc": "Transparent container (stacked)"},
    "ViewThatFits": {"role": "group", "doc": "Renders all candidates; keep one child"},
    "TimelineView": {"role": "group", "doc": "Transparent container"},
    "AnyView": {"role": "group", "doc": "Type-erased wrapper"},
    "EmptyView": {"role": "group", "doc": "Renders nothing"},
    "WindowGroup": {"role": "group", "doc": "Scene wrapper, accepted so App code pastes"},
    "GlassEffectContainer": {"role": "hstack", "doc": "iOS 26: groups glass shapes; renders as an HStack"},
    "HSplitView": {"role": "hstack", "doc": "macOS horizontal split"},
    "VSplitView": {"role": "vstack", "doc": "macOS vertical split"},
    "UnevenRoundedRectangle": {"role": "shape", "defaults": {"shape": "rounded"}},
    "ContainerRelativeShape": {"role": "shape", "defaults": {"shape": "rounded"}},
    "ConcentricRectangle": {"role": "shape", "defaults": {"shape": "rounded"}, "doc": "iOS 26 concentric shape"}
