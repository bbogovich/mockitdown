      "avatar-top": "#a5abb8", "avatar-bottom": "#858994",
      "map-land": "#efebe3", "map-park": "#cfe8c4", "map-water": "#a9d3f5", "map-road": "#ffffff",
      "video-bg": "#000000", "tab-sel": "rgb(116 116 128 / 0.12)",
