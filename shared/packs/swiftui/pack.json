      "bar-bg": "rgb(249 249 249 / 0.82)",
      "alert-bg": "rgb(242 242 242 / 0.9)", "alert-line": "rgb(60 60 67 / 0.29)",
      "menu-bg": "rgb(247 247 247 / 0.86)",
      "sidebar-bg": "rgb(246 246 248 / 0.8)", "sidebar-sel": "rgb(0 0 0 / 0.08)",
      "mac-window": "#ffffff", "mac-control": "#ffffff", "mac-control-line": "rgb(0 0 0 / 0.12)",
