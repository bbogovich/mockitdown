      "attrs": {
        "variant": "severity"
      },
      "doc": "FormControl.Validation(\"…\", variant: .error|.success)"
    },
    "TextInput": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "attrs": {
        "leadingVisual": "systemImage",
        "trailingVisual": "trailingIcon",
        "value": "text",
        "validationStatus": "error",
        "trailingAction": "trailingIcon",
        "type": "kind"
      },
      "doc": "TextInput(\"Find a file…\", value:, leadingVisual: \"search\", size: .small|.medium|.large)"
    },
    "TextInputWithTokens": {
      "role": "select",
      "params": [
        "placeholder"
      ],
      "doc": "TextInputWithTokens(\"Add topics\", selection: [\"react\", \"css\"])"
    },
    "Textarea": {
      "role": "textfield",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "attrs": {
        "value": "text"
      },
      "doc": "Textarea(\"Leave a comment\", value:, rows: 5)"
    },
    "Select": {
      "role": "select",
      "params": [
        "placeholder"
      ],
      "doc": "Native select: Select(selection: \"main\") { SelectOption(\"main\") }"
    },
    "SelectOption": {
      "role": "text",
      "params": [
        "content"
      ]
    },
    "Checkbox": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "Checkbox(\"Require review\", checked: true)"
    },
    "CheckboxGroup": {
      "role": "vstack",
      "defaults": {
        "spacing": 8,
        "alignment": "leading"
      }
    },
    "Radio": {
      "role": "radio",
      "params": [
        "label"
      ]
    },
    "RadioGroup": {
      "role": "radiogroup",
      "params": [
        "label"
      ]
    },
    "Autocomplete": {
      "role": "select",
      "params": [
        "placeholder"
      ],
      "defaults": {
        "variant": "autocomplete"
      },
      "attrs": {
        "text": "selection",
        "value": "selection"
      },
      "doc": "Autocomplete(\"Search users\", text: \"mo\", open: true) { AutocompleteItem(\"mona\") }"
    },
    "AutocompleteItem": {
      "role": "label",
      "params": [
        "title"
      ],
      "attrs": {
        "leadingVisual": "systemImage"
      }
    },
    "DataTable": {
      "role": "table",
      "doc": "DataTable(columns: […], rows: [[…]]) — bordered Primer table; title: and footer:"
    },
    "Table": {
      "role": "table"
    },
    "TableContainer": {
      "role": "vstack",
      "defaults": {
        "spacing": 8,
        "alignment": "stretch"
      }
    },
    "TableTitle": {
      "role": "text",
      "params": [
        "content"
      ]
    },
    "TableSubtitle": {
      "role": "text",
      "params": [
        "content"
      ]
    },
    "CodeView": {
      "role": "code",
      "params": [
        "code"
      ],
      "doc": "Blob view: CodeView(\"…\", language: \"ts\", highlight: [4], title: \"src/app.ts\")"
    },
    "BlobView": {
      "role": "code",
      "params": [
        "code"
      ]
    },
    "Snippet": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "lineNumbers": false
      },
      "doc": "Clipboard-copy snippet (markdown code block)"
    },
    "DiffFile": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "diff"
      },
      "doc": "File in a diff: DiffFile(\"src/app.ts\", subtitle: \"+12 −3\") { DiffHunk(…); DiffLine(…) } action: { … }"
    },
    "DiffHunk": {
      "role": "hstack",
      "defaults": {
        "spacing": 0,
        "variant": "hunk"
      },
      "doc": "@@ hunk header row: DiffHunk { DiffNumber(\"\"); DiffNumber(\"\"); DiffCode(\"@@ -10,6 +10,8 @@\") }"
    },
    "DiffLine": {
      "role": "hstack",
      "defaults": {
        "spacing": 0,
        "variant": "context"
      },
      "variants": [
        "context",
        "addition",
        "deletion"
      ],
      "doc": "One diff row: DiffLine(variant: .addition) { DiffNumber(\"\"); DiffNumber(\"14\"); DiffCode(\"+ …\") }"
    },
    "DiffNumber": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Line-number gutter cell of a DiffLine"
    },
    "DiffCode": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Code cell of a DiffLine (monospace, keeps spaces)"
    },
    "Terminal": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "variant": "terminal"
      }
    },
    "TimelineComment": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "comment"
      },
      "doc": "Issue/PR comment box: TimelineComment(\"**mona** commented 2 days ago\", avatar: \"Mona\") { body } action: { … }"
    },
    "CommentBox": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "comment"
      }
    }
  }
}
