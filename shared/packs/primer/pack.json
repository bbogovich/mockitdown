  "modifiers": {
    "scheme": {
      "attr": "variant"
    },
    "direction": {
      "attr": "placement"
    },
    "status": {
      "attr": "variant"
    }
  },
  "elements": {
    "Box": {
      "role": "vstack",
      "doc": "Generic container (Box): style it with modifiers; children stack vertically"
    },
    "Stack": {
      "role": "vstack",
      "defaults": {
        "spacing": 16,
        "alignment": "stretch"
      },
      "doc": "Stack (vertical, gap normal); use StackHorizontal or HStack for a row"
    },
    "StackHorizontal": {
      "role": "hstack",
      "defaults": {
        "spacing": 8
      },
      "doc": "Stack with direction=\"horizontal\""
    },
    "StackItem": {
      "role": "vstack",
      "doc": "Stack.Item"
    },
    "PageLayout": {
      "role": "vstack",
      "defaults": {
        "spacing": 0,
        "alignment": "stretch"
      },
      "doc": "PageLayout { PageLayoutHeader; PageLayoutContentRow { PageLayoutPane; PageLayoutContent } }"
    },
    "PageLayoutHeader": {
      "role": "vstack",
      "defaults": {
        "spacing": 8,
        "alignment": "stretch"
      },
      "doc": "PageLayout.Header"
    },
    "PageLayoutContentRow": {
      "role": "hstack",
      "defaults": {
        "spacing": 0,
        "alignment": "top"
      },
      "doc": "Row holding the pane and the content (pane on either side)"
    },
    "PageLayoutContent": {
      "role": "vstack",
      "defaults": {
        "spacing": 16,
        "alignment": "stretch"
      },
      "doc": "PageLayout.Content"
    },
    "PageLayoutPane": {
      "role": "vstack",
      "defaults": {
        "spacing": 8,
        "alignment": "stretch"
      },
      "doc": "PageLayout.Pane (296px side column); divider: true draws the line"
    },
    "PageLayoutFooter": {
      "role": "vstack",
      "defaults": {
        "spacing": 8,
        "alignment": "stretch"
      },
      "doc": "PageLayout.Footer"
