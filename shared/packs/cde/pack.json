  "fonts": {
    "user": "body",
    "system": "body",
    "systemBold": "headline",
    "large": "title3",
    "title": "title2",
    "caption": "caption"
  },
  "icons": {
    "Dtfile": "folder",
    "Dtpad": "square.and.pencil",
    "Dtterm": "app",
    "Dtmail": "envelope",
    "Dtcm": "calendar",
    "Dtclock": "clock",
    "Dtprint": "printer",
    "Dtstyle": "slider.horizontal.3",
    "Dthelp": "questionmark.circle",
    "Dtappmgr": "square.grid.2x2",
    "Dttrash": "trash",
    "Dtlock": "lock",
    "Dtexit": "power",
    "Dtbusy": "circle.fill",
    "folder": "folder",
    "file": "doc",
    "error": "xmark.circle",
    "warning": "exclamationmark.triangle",
    "information": "info.circle",
    "question": "questionmark.circle",
    "working": "clock",
    "Dtcolor": "palette",
    "Dtfont": "doc.text",
    "Dtbackdrop": "photo",
    "Dtkeyboard": "keyboard",
    "Dtmouse": "location",
    "Dtbeep": "speaker",
    "Dtscreen": "app",
    "Dtwindow": "square.stack",
    "Dtstartup": "power"
  },
  "attrs": {
    "labelString": "label"
  },
  "modifiers": {
    "showAsDefault": {
      "attr": "variant",
      "value": "default"
    },
    "sensitive": {
      "attr": "sensitive"
    },
    "set": {
      "attr": "checked"
    }
  },
  "elements": {
    "Workspace": {
      "role": "zstack",
      "defaults": {
        "alignment": "topLeading"
      },
      "doc": "The workspace backdrop; place windows with .padding and the FrontPanel with .frame(maxHeight: .infinity, alignment: .bottom)"
    },
    "DtWindow": {
      "role": "card",
      "params": [
        "title"
      ],
      "variants": [
        "active",
        "inactive"
      ],
      "doc": "A dtwm-framed window inside a Workspace (resize border, window-menu button, minimise/maximise); .variant(.inactive)"
    },
    "XmMainWindow": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "Main window: menu bar, work area, message line"
    },
    "XmForm": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 8
      },
      "doc": "Form container"
    },
    "XmRowColumn": {
      "role": "vstack",
      "defaults": {
        "alignment": "leading",
        "spacing": 6
      },
      "doc": "Row/column container (use HStack for XmHORIZONTAL)"
    },
    "XmPanedWindow": {
      "role": "vstack",
      "defaults": {
        "alignment": "stretch",
        "spacing": 0
      },
      "doc": "Panes separated by sashes"
    },
    "XmScrolledWindow": {
      "role": "scroll",
      "doc": "Scrolling region"
    },
    "XmDrawingArea": {
      "role": "canvas",
      "doc": "Free-form drawing area"
    },
    "XmFrame": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "frame"
      },
      "doc": "Etched-in frame with a title on its top edge"
    },
    "XmMenuBar": {
      "role": "toolbar",
      "defaults": {
        "variant": "menubar"
      },
      "doc": "Raised menu bar holding XmCascadeButtons / XmPulldownMenus"
    },
    "XmCascadeButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "cascade"
      },
      "doc": "A menu-bar title; the first letter is the mnemonic; .selected() arms it"
    },
    "XmPulldownMenu": {
      "role": "menu",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "cascade",
        "caret": false
      },
      "doc": "XmPulldownMenu(\"File\", open: true) { MenuItem(\"Open...\") … }"
    },
    "XmPopupMenu": {
      "role": "menu",
      "doc": "A pop-up menu (no trigger)"
    },
    "XmMenuItem": {
      "role": "menuitem",
      "params": [
        "label"
      ],
      "doc": "A push-button gadget in a menu: shortcut:, checked:, .selected() (armed)"
    },
    "XmPushButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "variants": [
        "default"
      ],
      "doc": "Push button with a 2px bevel; .showAsDefault() adds the default ring"
    },
    "XmArrowButton": {
      "role": "button",
      "params": [
        "direction"
      ],
      "defaults": {
        "variant": "arrow"
      },
      "doc": "Arrow button"
    },
    "XmToggleButton": {
      "role": "checkbox",
      "params": [
        "label"
      ],
      "doc": "N-of-many toggle: square indicator, filled with the select colour when set"
    },
    "XmRadioButton": {
      "role": "radio",
      "params": [
        "label"
      ],
      "doc": "One-of-many toggle: diamond indicator"
    },
    "XmRadioBox": {
      "role": "radiogroup",
      "params": [
        "label"
      ],
      "doc": "Radio box from items:/selection: (diamond indicators)"
    },
    "XmLabel": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Label"
    },
    "XmSeparator": {
      "role": "divider",
      "doc": "Etched separator"
    },
    "XmTextField": {
      "role": "textfield",
      "params": [
        "label"
      ],
      "doc": "Single-line text field (sunken, light text background)"
    },
    "XmText": {
      "role": "textfield",
      "params": [
        "label"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "doc": "Multi-line text"
    },
    "XmScrolledText": {
      "role": "textfield",
      "params": [
        "label"
      ],
      "defaults": {
        "kind": "multiline"
      },
      "doc": "Multi-line text in a scrolled window"
    },
    "XmScale": {
      "role": "slider",
      "params": [
        "label"
      ],
      "defaults": {
        "showValue": true
      },
      "doc": "Scale: sunken trough, raised slider with a centre groove, value shown"
    },
    "XmScrollBar": {
      "role": "slider",
      "params": [
        "value"
      ],
      "defaults": {
        "variant": "scrollbar"
      },
      "doc": "Scroll bar with arrow buttons"
    },
    "XmList": {
      "role": "list",
      "doc": "List; ListItem children, .selected() uses the select colour"
    },
    "XmScrolledList": {
      "role": "list",
      "defaults": {
        "variant": "scrolled"
      },
      "doc": "List with a vertical scroll bar"
    },
    "XmListItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
      "doc": "An item of an XmList"
    },
    "XmOptionMenu": {
      "role": "select",
      "params": [
        "label"
      ],
      "doc": "Option menu: raised button with the small raised-bar indicator"
    },
    "XmComboBox": {
      "role": "select",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "combo"
      },
      "doc": "Combo box: sunken text with an arrow button"
    },
    "DtComboBox": {
      "role": "select",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "combo"
      },
      "doc": "CDE combo box"
    },
    "DtSpinBox": {
      "role": "stepper",
      "params": [
        "label"
      ],
      "doc": "Spin box with up/down arrows"
    },
    "XmSpinBox": {
      "role": "stepper",
      "params": [
        "label"
      ],
      "doc": "Motif 2.1 spin box"
    },
    "XmNotebook": {
      "role": "tabs",
      "doc": "Motif 2.1 notebook (tabs)"
    },
    "XmMessageBox": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert"
      },
      "doc": "Message dialog: symbol on the left, message, separator, buttons"
    },
    "XmErrorDialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "error"
      },
      "doc": "Error dialog"
    },
    "XmWarningDialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "warning"
      },
      "doc": "Warning dialog"
    },
    "XmInformationDialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "information"
      },
      "doc": "Information dialog"
    },
    "XmQuestionDialog": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "alert",
        "icon": "question"
      },
      "doc": "Question dialog"
    },
    "XmDialogShell": {
      "role": "dialog",
      "params": [
        "title"
      ],
      "doc": "A dialog window"
    },
    "FrontPanel": {
      "role": "toolbar",
      "defaults": {
        "variant": "frontpanel"
      },
      "doc": "The CDE Front Panel along the bottom of the screen"
    },
    "FrontPanelControl": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "fpcontrol"
      },
      "doc": "A Front Panel control (icon:) with the subpanel arrow above it"
    },
    "FrontPanelIcon": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "fpplain"
      },
      "doc": "A Front Panel control without a subpanel (e.g. the clock)"
    },
    "WorkspaceSwitch": {
      "role": "grid",
      "defaults": {
        "columns": 2,
        "spacing": 3
      },
      "doc": "The workspace switch in the middle of the Front Panel"
    },
    "WorkspaceButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "workspace"
      },
      "doc": "A workspace button; .selected() for the current workspace; .color(.ws2) etc."
    },
    "SwitchControl": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "switchctl"
      },
      "doc": "Lock / Exit / busy-light controls beside the workspace buttons"
    },
    "DtIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "A File Manager / Application Manager icon: picture with its name below; .selected()"
    },
    "DtIconGrid": {
      "role": "hstack",
      "defaults": {
        "wrap": true,
        "spacing": 14,
        "alignment": "top"
      },
      "doc": "Icon view of a folder"
    },
    "DtIconButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "icontop"
      },
      "doc": "A button with its icon above the label (Style Manager)"
    },
    "DtTerm": {
      "role": "code",
      "params": [
        "code"
      ],
      "defaults": {
        "variant": "terminal"
      },
      "doc": "dtterm terminal emulator; lines starting with \"$ \" are commands"
    },
    "StatusLine": {
      "role": "toolbar",
      "defaults": {
        "variant": "status"
      },
      "doc": "Sunken message/status line at the bottom of a main window"
    }
  }
}