      "paper": "radial-gradient(ellipse 60% 40% at 18% 12%, rgb(255 255 255 / 0.045), transparent 70%), radial-gradient(ellipse 50% 35% at 82% 88%, rgb(255 255 255 / 0.04), transparent 70%), radial-gradient(ellipse 40% 30% at 70% 30%, rgb(255 255 255 / 0.025), transparent 70%)"
    }
  },
  "elements": {
    "Scribble": {
      "role": "skeleton",
      "defaults": {
        "lines": 3
      },
      "doc": "Squiggle lines standing in for body text: Scribble(lines: 4) · avatar:, image: add a crossed box"
    },
    "Squiggle": {
      "role": "skeleton",
      "defaults": {
        "lines": 1
      },
      "doc": "One squiggle line (a heading or label still to be written)"
    },
    "Lorem": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore."
      },
      "doc": "Filler copy in the handwriting font: Lorem() or Lorem(\"short custom filler\")"
    },
    "CrossedImage": {
      "role": "placeholder",
      "params": [
        "label"
      ],
      "doc": "A box with a big pencil X for an image still to come: CrossedImage(\"hero shot\", height: 180)"
    },
    "Annotation": {
      "role": "stickynote",
      "params": [
        "text"
      ],
      "variants": [
        "left",
        "right",
        "up",
        "down"
      ],
      "defaults": {
        "variant": "left"
      },
      "doc": "Handwritten margin note in the highlighter colour with an arrow: Annotation(\"tap to edit\", variant: .up); place with .position(x:y:)"
    },
    "Note": {
      "role": "stickynote",
      "params": [
        "text"
      ],
      "doc": "A taped paper note (slightly rotated): Note(\"ask legal\", title: \"TODO\", author: \"BB\", rotation: 2)"
    },
    "Arrow": {
      "role": "divider",
      "params": [
        "label"
      ],
      "variants": [
        "right",
        "left",
        "down",
        "up"
      ],
      "defaults": {
        "variant": "right"
      },
      "doc": "A pencil arrow between screens or boxes in a flow, optional label: Arrow(\"tap\"), Arrow(variant: .down)"
    },
    "Highlight": {
      "role": "text",
      "params": [
        "content"
      ],
      "doc": "Text swiped with the highlighter marker: Highlight(\"Free for 30 days\")"
    }
  }
}
