  "elements": {
    "Display": {
      "role": "card",
      "params": ["title"],
      "attrs": {"file": "title", "viewspec": "status", "location": "subtitle"},
      "doc": "The whole CRT display as the TV camera saw it: Display(file: \"<ARC>LIST,1\", viewspec: \"abm\") { … } header: { FeedbackLine(…) }"
    },
    "Screen": {
      "role": "card",
      "params": ["title"],
      "attrs": {"file": "title", "viewspec": "status", "location": "subtitle"},
      "doc": "Alias of Display"
    },
    "DisplayArea": {
      "role": "card",
      "params": ["title"],
      "defaults": {"variant": "area"},
      "attrs": {"file": "title", "viewspec": "status"},
      "variants": ["area", "bare"],
      "doc": "One display area (window) of a split screen, its file address in the top rule: DisplayArea(\"<ARC>PLAN,3\", viewspec: \"bm\") { … }"
    },
    "Window": {
      "role": "card",
      "params": ["title"],
      "defaults": {"variant": "area"},
      "attrs": {"file": "title", "viewspec": "status"},
      "variants": ["area", "bare"],
      "doc": "Alias of DisplayArea"
    },
    "SplitScreen": {
      "role": "split",
      "doc": "Display areas side by side (or stacked with orientation: .vertical), split by a single drawn line"
    },
    "FeedbackLine": {
      "role": "toolbar",
      "params": ["title"],
      "doc": "The command feedback line at the top of the screen: the command being composed, then the echo: FeedbackLine(\"INSERT STATEMENT\") { Echo(\"fresh bread\") }"
    },
    "CommandFeedback": {
      "role": "toolbar",
      "params": ["title"],
      "doc": "Alias of FeedbackLine"
    },
    "Echo": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "echo"},
      "doc": "Characters echoed as they are typed on the keyset, ending in the underline cursor: Echo(\"2b\")"
    },
    "CommandWord": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "command"},
      "doc": "One command word (verb or noun) as shown in the feedback line: CommandWord(\"JUMP\")"
    },
    "ViewSpec": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "viewspec"},
      "doc": "The current view-specification letters, shown dim: ViewSpec(\"abm\")"
    },
    "Register": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "register"},
      "doc": "A name register or status slot at the edge of the feedback line: Register(\"BUG 2c\")"
    },
    "SystemMessage": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "message"},
      "doc": "A short system reply in the feedback area, set in inverse: SystemMessage(\"FILE LOADED\")"
    },
    "StatementFile": {
      "role": "tree",
      "attrs": {"levels": "level", "lines": "density", "numbers": "labelStyle"},
      "doc": "A structured file of hierarchical statements, numbered 1, 1a, 1a1 … automatically · view specs: levels: 1…4, lines: 1 (first line only), numbers: false"
    },
    "Outline": {
      "role": "tree",
      "attrs": {"levels": "level", "lines": "density", "numbers": "labelStyle"},
      "doc": "Alias of StatementFile"
    },
    "Statement": {
      "role": "treeitem",
      "params": ["label"],
      "attrs": {"number": "detail", "text": "label"},
      "doc": "One statement; nest Statements for sub-statements. number: \"3b\" overrides the automatic number · .selected() intensifies it"
    },
    "StatementLink": {
      "role": "link",
      "params": ["label"],
      "defaults": {"variant": "statement"},
      "variants": ["statement", "file"],
      "doc": "A link to another statement, shown in parentheses: StatementLink(\"2b\") → (2b)"
    },
    "FileLink": {
      "role": "link",
      "params": ["label"],
      "defaults": {"variant": "file"},
      "variants": ["statement", "file"],
      "doc": "A link to a statement in another file, shown in parentheses: FileLink(\"ARC, PLAN, 3a\") → (ARC, PLAN, 3a)"
    },
    "Marker": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "marker"},
      "doc": "A named marker set on a character, shown as a small tag: Marker(\"m\")"
    },
    "Bug": {
      "role": "pointer",
      "defaults": {"kind": "bug"},
      "doc": "The tracking spot moved by the mouse: a short upward arrow · use inline in a statement, or .position(x:y:) in a ZStack/Drawing"
    },
    "PartnerBug": {
      "role": "pointer",
      "defaults": {"kind": "partner"},
      "doc": "A second user's tracking spot on a shared screen, drawn hollow"
    },
    "CommandButton": {
      "role": "button",
      "params": ["label"],
      "doc": "A command word set in brackets — there were no on-screen buttons; this stands for a keyset command: CommandButton(\"JUMP\")"
    },
    "Chord": {
      "role": "kbd",
      "params": ["keys"],
      "doc": "A five-key keyset chord as typed (keys pressed together): Chord([\"·\",\"█\",\"·\",\"█\",\"·\"]) or Chord(\"d\")"
    },
    "Drawing": {
      "role": "canvas",
      "doc": "A vector drawing area; place Strokes, Nodes and labels with .position(x:y:)"
    },
    "Stroke": {
      "role": "shape",
      "defaults": {"variant": "line"},
      "variants": ["line", "dashed"],
      "doc": "A drawn vector line: Stroke().frame(width: 120, height: 2).rotationEffect(.degrees(30)).position(x:y:)"
    },
    "Node": {
      "role": "text",
      "params": ["content"],
      "defaults": {"variant": "node"},
      "doc": "A boxed label in a diagram: Node(\"library\")"
    },
    "RouteMap": {
      "role": "map",
      "doc": "A line-drawn map with stops and the route between them: RouteMap(pins: [(20, 30, \"library\")], route: true)"
    },
    "VideoInset": {
      "role": "placeholder",
      "params": ["label"],
      "defaults": {"variant": "inset"},
      "variants": ["inset", "overlay"],
      "doc": "The television picture of a person mixed into the display: VideoInset(\"camera 2 — remote site\") · .variant(.overlay) superimposes it translucently"
    },
    "Heading": {
      "role": "text",
      "params": ["content"],
      "defaults": {"font": "title3"},
      "doc": "A larger line of text"
    },
    "Caption": {
      "role": "text",
      "params": ["content"],
      "defaults": {"font": "caption"},
      "doc": "Dim fine print"
    },
    "Rule": {
      "role": "divider",
      "params": ["label"],
      "doc": "A drawn horizontal line; Rule(\"label\") sets text into it"
    }
  }
}
