  "fonts": {
    "h1": "display", "h2": "display", "h3": "display", "h4": "largeTitle", "h5": "title", "h6": "title2",
    "subtitle1": "headline", "subtitle2": "subheadline", "body1": "body", "body2": "callout",
    "button": "subheadline", "caption": "caption", "overline": "overline"
  },
