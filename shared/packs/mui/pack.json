  },
  "modifiers": {
    "dense": {"attr": "density", "value": "compact"},
    "orientation": {"attr": "orientation"},
    "labelPlacement": {"attr": "placement"},
    "anchor": {"attr": "placement"},
    "disableElevation": {"attr": "elevation", "value": "0"},
    "square": {"attr": "shape", "value": "square"},
    "textColor": {"attr": "color"},
    "indicatorColor": {"attr": "color"}
  },
  "elements": {
    "Typography": {"role": "text", "params": ["content"], "defaults": {"variant": "body1"},
      "variants": ["h1", "h2", "h3", "h4", "h5", "h6", "subtitle1", "subtitle2", "body1", "body2", "button", "caption", "overline", "inherit"],
      "doc": "Typography(\"Title\", variant: \"h5\", color: \"text.secondary\")"},
    "AlertTitle": {"role": "text", "params": ["content"], "doc": "Bold first line inside an Alert"},
    "DialogTitle": {"role": "text", "params": ["content"], "doc": "Dialog heading (or use Dialog(title:))"},
    "DialogContentText": {"role": "text", "params": ["content"], "doc": "Secondary body text of a Dialog"},
    "FormLabel": {"role": "text", "params": ["content"], "doc": "Label of a RadioGroup / FormGroup"},
    "FormHelperText": {"role": "text", "params": ["content"], "doc": "Caption under a control; error: true"},
    "InputLabel": {"role": "text", "params": ["content"]},
    "ListSubheader": {"role": "text", "params": ["content"], "doc": "Section heading inside a List"},
    "TableCell": {"role": "text", "params": ["content"], "doc": "Cell inside TableRow"},
    "Step": {"role": "text", "params": ["label"], "doc": "Stepper { Step(\"Shipping\") … } (or steps: [..])"},
    "StepLabel": {"role": "text", "params": ["label"]},

    "Box": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Generic container (a column that stretches its children)"},
    "Stack": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Stack(spacing: 16) · orientation: .horizontal for direction=\"row\" (spacing in px)"},
    "Container": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Centered, max-width 1200 column with 24px gutters"},
    "FormControl": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "FormGroup": {"role": "vstack", "defaults": {"alignment": "leading"}, "doc": "Column of Checkbox / Switch controls; orientation: .horizontal for row"},
    "CardContent": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "16px-padded body of a Card"},
    "DialogContent": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "AccordionDetails": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "TabPanel": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "CardActions": {"role": "hstack", "doc": "Row of small buttons at the bottom of a Card"},
    "DialogActions": {"role": "hstack", "doc": "Right-aligned row of dialog buttons"},
    "AvatarGroup": {"role": "hstack", "doc": "AvatarGroup { Avatar(…) … } — overlapped avatars"},
    "Grid": {"role": "grid", "params": ["columns"], "doc": "Grid(spacing: 16) { Grid(size: 4) { … } } — 12-column grid, items span size:"},
    "ImageList": {"role": "grid", "params": ["columns"], "doc": "ImageList(columns: 3) { ImageListItem(\"photo.svg\") … }"},
    "Masonry": {"role": "grid", "params": ["columns"]},
    "ImageListItem": {"role": "image", "params": ["src"]},
    "CardMedia": {"role": "image", "params": ["src"], "doc": "CardMedia(\"photo.svg\") — 140px cover image (or Card(image:))"},
    "Collapse": {"role": "group"}, "Fade": {"role": "group"}, "Grow": {"role": "group"},
    "Slide": {"role": "group"}, "Zoom": {"role": "group"},

    "SvgIcon": {"role": "icon", "params": ["name"], "doc": "Material icon by name: SvgIcon(\"inbox\")"},
    "ListItemIcon": {"role": "icon", "params": ["name"], "doc": "Leading icon of a ListItem (56px column)"},
    "ListItemAvatar": {"role": "avatar", "params": ["name"], "doc": "Leading avatar of a ListItem"},
    "Avatar": {"role": "avatar", "params": ["name"], "variants": ["circular", "rounded", "square"],
      "doc": "Avatar(\"Remy Sharp\", image: \"…\") · variant: \"rounded\""},
    "Badge": {"role": "badge", "params": ["content"], "variants": ["standard", "dot"],
      "doc": "Badge(4, color: \"error\") { SvgIcon(\"mail\") } — or .badge(4) on IconButton/Tab/ListItem"},
    "Chip": {"role": "chip", "params": ["label"], "defaults": {"variant": "filled"}, "variants": ["filled", "outlined"],
      "doc": "Chip(\"Active\", color: \"success\", variant: \"outlined\", onDelete: true, icon:, avatar:)"},
    "Link": {"role": "link", "params": ["label", "href"], "variants": ["always", "hover", "none"]},
    "Rating": {"role": "rating", "params": ["value"], "doc": "Rating(value: 3.5, max: 5, size: \"small\")"},
    "Skeleton": {"role": "shape", "defaults": {"shape": "rectangle", "variant": "text"}, "variants": ["text", "rectangular", "rounded", "circular"],
      "doc": "Skeleton(variant: \"circular\").frame(width: 40, height: 40)"},
    "Divider": {"role": "divider", "variants": ["fullWidth", "inset", "middle"], "doc": "Divider(variant: \"inset\") · Divider(label: \"OR\")"},
    "Paper": {"role": "card", "defaults": {"elevation": 1}, "variants": ["elevation", "outlined"],
      "doc": "Paper(elevation: 3) { … } — surface with no padding; variant: \"outlined\""},
    "Card": {"role": "card", "params": ["title"], "defaults": {"elevation": 1}, "variants": ["elevation", "outlined"],
      "doc": "Card(title:, subheader:, avatar:, image:) { content } actions: { Button … } headerAction: { IconButton }"},
    "CardHeader": {"role": "card", "params": ["title"], "doc": "CardHeader(title:, subheader:, avatar:) action: { … }"},
    "TableContainer": {"role": "card", "defaults": {"elevation": 1}, "doc": "Paper around a Table"},
    "Placeholder": {"role": "placeholder", "params": ["label"]},

    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "text"},
      "variants": ["text", "outlined", "contained"],
      "doc": "Button(\"Save\", variant: \"contained\", color: \"secondary\", size: \"small\", startIcon: \"send\")"},
    "LoadingButton": {"role": "button", "params": ["label"], "defaults": {"variant": "contained", "loading": true},
      "variants": ["text", "outlined", "contained"], "doc": "Button with a progress spinner (Button loading:)"},
    "IconButton": {"role": "button", "params": ["icon"], "defaults": {"iconOnly": true},
      "doc": "IconButton(\"delete\", color: \"primary\", size: \"small\")"},
    "Fab": {"role": "fab", "params": ["icon"], "variants": ["circular", "extended"],
      "doc": "Fab(\"add\", color: \"primary\") · Fab(\"navigation\", label: \"Navigate\", variant: \"extended\") — floats bottom-right; inline: true to place it"},
    "SpeedDial": {"role": "fab", "params": ["icon"], "defaults": {"color": "primary"}},
    "ButtonGroup": {"role": "toolbar", "defaults": {"variant": "outlined"}, "variants": ["contained", "outlined", "text"],
      "doc": "ButtonGroup(variant: \"contained\") { Button(\"One\") … }"},
    "ToggleButton": {"role": "button", "params": ["label"], "doc": "ToggleButton(icon: \"format_bold\").selected()"},
    "ToggleButtonGroup": {"role": "segmented", "params": ["items"],
      "doc": "ToggleButtonGroup([\"Web\", \"Android\", \"iOS\"], value: \"Web\") — items may be [\"icon\": …] dicts"},
    "Checkbox": {"role": "checkbox", "params": ["label"], "doc": "Checkbox(\"Remember me\", checked: true, color:)"},
    "FormControlLabel": {"role": "checkbox", "params": ["label"], "doc": "Checkbox with a label (use Switch(label) for a switch)"},
    "Radio": {"role": "radio", "params": ["label"]},
    "RadioGroup": {"role": "radiogroup", "params": ["label"], "doc": "RadioGroup(\"Gender\", options: [..], value: \"Female\") · orientation: .horizontal for row"},
    "Switch": {"role": "toggle", "params": ["label"], "doc": "Switch(\"Wi-Fi\", checked: true) · labelPlacement: .start"},
    "Slider": {"role": "slider", "doc": "Slider(value: 30, min: 0, max: 100, color:) · value: [20, 37] for a range"},
    "TextField": {"role": "textfield", "params": ["label"], "defaults": {"variant": "outlined"},
      "variants": ["outlined", "filled", "standard"],
      "doc": "TextField(\"Email\", value: \"…\", helperText:, error: true, prefix: \"$\", size: \"small\", multiline via kind: .multiline)"},
    "OutlinedInput": {"role": "textfield", "params": ["placeholder"], "defaults": {"variant": "outlined"}},
    "FilledInput": {"role": "textfield", "params": ["placeholder"], "defaults": {"variant": "filled"}},
    "Input": {"role": "textfield", "params": ["placeholder"], "defaults": {"variant": "standard"}},
    "InputBase": {"role": "textfield", "params": ["placeholder"], "defaults": {"variant": "base"}},
    "TextareaAutosize": {"role": "textfield", "params": ["placeholder"], "defaults": {"variant": "outlined", "kind": "multiline"}},
    "Select": {"role": "select", "params": ["label"], "defaults": {"variant": "outlined"}, "variants": ["outlined", "filled", "standard"],
      "doc": "Select(\"Age\", options: [\"Ten\", \"Twenty\"], value: \"Twenty\", open: true)"},
    "NativeSelect": {"role": "select", "params": ["label"], "defaults": {"variant": "standard"}},
    "Autocomplete": {"role": "select", "params": ["label"], "defaults": {"variant": "outlined"},
      "doc": "Autocomplete(\"Movie\", value: \"Inception\") · value: [..] renders chips (multiple)"},
    "DatePicker": {"role": "datepicker", "params": ["label"], "defaults": {"variant": "outlined", "format": "numeric"},
      "doc": "MUI X DatePicker(\"Start date\", value: \"2026-11-23\")"},
    "TimePicker": {"role": "datepicker", "params": ["label"], "defaults": {"variant": "outlined", "kind": "time"}},
    "DateTimePicker": {"role": "datepicker", "params": ["label"], "defaults": {"variant": "outlined", "kind": "datetime", "format": "numeric"}},
