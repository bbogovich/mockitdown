    "RadioGroupItem": {"role": "radio", "params": ["label"]},
    "Switch": {"role": "toggle", "params": ["label"], "doc": "Switch(\"Airplane Mode\", isOn: true, description:)"},
    "Slider": {"role": "slider", "doc": "Slider(value: 50, in: 0...100) · value: [25, 75] for a range"},
    "Toggle": {"role": "toggle", "params": ["label"], "defaults": {"variant": "button"},
               "doc": "Pressable toggle button: Toggle(\"B\", isOn: true) or Toggle { Image(systemName:) }"},
    "ToggleGroup": {"role": "segmented", "params": ["items"],
                    "doc": "ToggleGroup(items: [\"B\", \"I\", \"U\"], selection: \"B\") or ToggleGroupItem children"},
    "ToggleGroupItem": {"role": "label", "params": ["title"], "doc": "ToggleGroupItem(\"Bold\") or (systemImage:)"},
    "InputOTP": {"role": "segmented", "params": ["items"],
                 "doc": "InputOTP(items: [\"1\", \"2\", \"\", …], selection: 2) — one slot per item, the selected one focused"},
    "DatePicker": {"role": "datepicker", "params": ["label"], "defaults": {"placeholder": "Pick a date"},
                   "doc": "Outline button with a calendar icon; selection: \"2026-11-23\""},
    "Calendar": {"role": "calendar", "doc": "Calendar(selection: \"2026-11-23\") · range: [start, end]"},
    "Form": {"role": "form"},
    "FormItem": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 8}},
    "FormLabel": {"role": "text", "params": ["content"]},
    "FormDescription": {"role": "text", "params": ["content"]},
    "FormMessage": {"role": "text", "params": ["content"]},
    "Field": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 8}, "doc": "Field { FieldLabel; Input; FieldDescription }"},
    "FieldSet": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 16}},
    "FieldGroup": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 24}},
    "FieldLabel": {"role": "text", "params": ["content"]},
    "FieldLegend": {"role": "text", "params": ["content"]},
    "FieldDescription": {"role": "text", "params": ["content"]},
    "FieldSeparator": {"role": "divider", "params": ["label"]},
    "InputGroup": {"role": "textfield", "params": ["placeholder"], "doc": "Input with leading icon (systemImage:) / prefix: / suffix:"},

    "Avatar": {"role": "avatar", "params": ["name"], "doc": "Avatar(\"Shad CN\", image: \"…\") — falls back to initials"},
    "AvatarFallback": {"role": "avatar", "params": ["name"]},
    "Alert": {"role": "alert", "params": ["title"], "defaults": {"variant": "default"},
