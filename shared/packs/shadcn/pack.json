    "AlertDialogAction": {"role": "button", "params": ["label"], "defaults": {"variant": "default", "label": "Continue"}},
    "AlertDialogCancel": {"role": "button", "params": ["label"], "defaults": {"variant": "outline", "label": "Cancel"}},
    "Dialog": {"role": "dialog", "params": ["title"], "defaults": {"closable": true},
