  "elements": {
    "Button": {"role": "button", "params": ["label"], "defaults": {"variant": "default"},
               "variants": ["default", "secondary", "destructive", "outline", "ghost", "link"],
               "doc": "Button(\"Save\", variant: .outline, size: .sm) · size default|sm|lg|icon · systemImage: lucide name"},
    "ButtonGroup": {"role": "toolbar", "defaults": {"variant": "group"}, "doc": "Joined outline buttons"},
    "Badge": {"role": "badge", "params": ["text"], "defaults": {"variant": "default"},
              "variants": ["default", "secondary", "destructive", "outline"], "doc": "Badge(\"New\", variant: .secondary)"},
    "Card": {"role": "card", "params": ["title"],
             "doc": "Card(\"Title\", description: \"…\") { content } footer: { … } action: { … }"},
    "CardHeader": {"role": "vstack", "defaults": {"alignment": "leading", "spacing": 6}, "doc": "Title + description column"},
    "CardTitle": {"role": "text", "params": ["content"], "doc": "Card title (leading-none font-semibold)"},
    "CardDescription": {"role": "text", "params": ["content"], "doc": "Muted card description"},
    "CardContent": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Card body"},
    "CardFooter": {"role": "hstack", "doc": "Card footer row"},
    "CardAction": {"role": "hstack", "doc": "Top-right header action"},

    "Label": {"role": "label", "params": ["title"], "doc": "Form label (text-sm font-medium)"},
    "Input": {"role": "textfield", "params": ["placeholder"],
              "doc": "Input(\"m@example.com\", label: \"Email\", text:, description:, type: .password)"},
    "Textarea": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "multiline"},
                 "doc": "Textarea(\"Type your message here.\", rows: 4)"},
    "Select": {"role": "select", "params": ["placeholder"],
               "doc": "Select(\"Theme\", selection: \"Dark\") { SelectItem(\"Light\") … } · open: true shows SelectContent"},
    "SelectItem": {"role": "menuitem", "params": ["label"]},
    "SelectGroup": {"role": "group"},
    "SelectLabel": {"role": "text", "params": ["content"]},
    "NativeSelect": {"role": "select", "params": ["placeholder"]},
    "Combobox": {"role": "select", "params": ["placeholder"], "defaults": {"trailingIcon": "chevrons-up-down"},
                 "doc": "Popover + Command pattern; trigger is an outline button with chevrons-up-down"},
    "Command": {"role": "menu", "doc": "Command { CommandInput(…); CommandGroup(\"Suggestions\") { CommandItem(…) } }"},
    "CommandDialog": {"role": "dialog", "defaults": {"variant": "command"}, "doc": "A Command palette in a modal"},
    "CommandInput": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"}},
    "CommandList": {"role": "group"},
    "CommandEmpty": {"role": "text", "params": ["content"]},
    "CommandGroup": {"role": "section", "params": ["title"], "doc": "CommandGroup(\"Settings\") { … } (heading:)"},
    "CommandItem": {"role": "menuitem", "params": ["label"], "doc": "CommandItem(\"Profile\", systemImage: \"user\", shortcut: \"⌘P\")"},
    "CommandSeparator": {"role": "divider"},
    "Checkbox": {"role": "checkbox", "params": ["label"], "doc": "Checkbox(\"Accept terms\", checked: true)"},
    "RadioGroup": {"role": "radiogroup", "params": ["label"],
