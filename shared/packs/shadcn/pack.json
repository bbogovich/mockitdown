    "Chart": {"role": "chart", "doc": "Chart(kind: .area|.bar|.line|.pie|.donut, values:, series:, labels:) — chart-1…5"},
    "ChartContainer": {"role": "chart"},

    "TypographyH1": {"role": "text", "params": ["content"], "defaults": {"style": "h1"}},
