              "doc": "Alert(\"Heads up!\", description: \"…\", systemImage: \"terminal\", variant: .destructive)"},
    "AlertTitle": {"role": "text", "params": ["content"]},
    "AlertDescription": {"role": "text", "params": ["content"]},
    "AlertDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alertDialog"},
