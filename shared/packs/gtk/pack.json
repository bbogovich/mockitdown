  "elements": {
    "ApplicationWindow": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0},
                          "doc": "Adw.ApplicationWindow — the window content; put a ToolbarView or a split view inside"},
    "Window": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Adw.Window / Gtk.Window"},
    "ToolbarView": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "variants": ["flat", "raised", "raisedBorder"],
                    "doc": "ToolbarView { HeaderBar(…); content; bottom bar } — content between the bars fills the space"},
    "HeaderBar": {"role": "appbar", "params": ["title"], "defaults": {"kind": "window"}, "variants": ["flat", "raised"],
                  "attrs": {"start": "leading", "end": "actions", "titleWidget": "center", "showEndTitleButtons": "kind",
                            "showTitleButtons": "kind"},
                  "doc": "HeaderBar(\"Title\", subtitle:, start: { … }, titleWidget: { ViewSwitcher }) { end widgets } — draws the window close button; showEndTitleButtons: false for inner panes"},
    "WindowTitle": {"role": "listitem", "params": ["title", "subtitle"], "doc": "WindowTitle(\"Document\", \"~/Notes\") — title + subtitle for a HeaderBar titleWidget"},
    "NavigationSplitView": {"role": "split", "doc": "NavigationSplitView { sidebar page } content: { content page }"},
    "OverlaySplitView": {"role": "split", "doc": "OverlaySplitView { sidebar } content: { … }"},
    "NavigationView": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Navigation stack — shows its (top) page"},
    "NavigationPage": {"role": "vstack", "params": ["title"], "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "NavigationPage(\"Title\") { ToolbarView { … } }"},
    "BreakpointBin": {"role": "group"},
    "Bin": {"role": "group", "doc": "A single-child container"},
    "Clamp": {"role": "vstack", "defaults": {"alignment": "stretch"}, "doc": "Clamp { … } — limits its child to 600 px (maximumSize:) and centres it"},
    "ClampScrollable": {"role": "vstack", "defaults": {"alignment": "stretch"}},
    "Box": {"role": "vstack", "defaults": {"alignment": "stretch"}, "variants": ["linked", "toolbar"],
            "doc": "Box(orientation: .horizontal, spacing: 6) { … } · .variant(.linked) joins buttons"},
    "CenterBox": {"role": "hstack", "doc": "start / center / end widgets in a row"},
    "WrapBox": {"role": "hstack", "defaults": {"wrap": true, "spacing": 6}, "doc": "Adw.WrapBox (1.7) — wraps children onto lines"},
    "ScrolledWindow": {"role": "scroll", "params": ["axes"], "doc": "Scrolling region (static)"},
    "Viewport": {"role": "group"},
    "FlowBox": {"role": "grid", "defaults": {"columns": 4}, "doc": "FlowBox(columns: 5) { FlowBoxChild … }"},
    "FlowBoxChild": {"role": "vstack"},
    "GridView": {"role": "grid", "defaults": {"columns": 5}, "doc": "GridView(columns: 6) { … } — Nautilus-style icon grid"},
    "Paned": {"role": "split", "doc": "Paned { start } content: { end }"},
    "Overlay": {"role": "zstack"},
    "Frame": {"role": "card", "params": ["title"], "doc": "Gtk.Frame — a bordered box"},
    "Separator": {"role": "divider"},
    "Revealer": {"role": "group"},
    "Stack": {"role": "tabs", "defaults": {"variant": "stack"}, "doc": "Stack(selection:) { StackPage(\"Name\") { … } } — shows the selected page"},
    "StackPage": {"role": "tab", "params": ["title"]},
    "StackSwitcher": {"role": "segmented", "params": ["items"], "doc": "StackSwitcher(items: [\"A\", \"B\"], selection: \"A\") — linked buttons"},

    "ViewStack": {"role": "tabs", "defaults": {"variant": "stack"}, "doc": "ViewStack(selection:) { ViewStackPage(\"Albums\", icon:) { … } } — the selected page only"},
    "ViewStackPage": {"role": "tab", "params": ["title"], "doc": "ViewStackPage(\"Albums\", icon: \"photo\", badge: 3) { … }"},
    "ViewSwitcher": {"role": "tabs", "defaults": {"variant": "switcher", "placement": "top"},
                     "doc": "ViewSwitcher(selection:) { ViewSwitcherItem(\"World\", icon:) … } — wide switcher for a HeaderBar titleWidget"},
    "ViewSwitcherBar": {"role": "tabs", "defaults": {"variant": "switcherBar", "placement": "bottom"},
                        "doc": "ViewSwitcherBar(selection:) { ViewSwitcherItem … } — the narrow/mobile bottom bar"},
    "ViewSwitcherItem": {"role": "tab", "params": ["title"]},
    "InlineViewSwitcher": {"role": "segmented", "params": ["items"], "doc": "Adw.InlineViewSwitcher (1.7) — items:, selection:"},
    "ToggleGroup": {"role": "segmented", "params": ["items"], "variants": ["flat", "round"], "doc": "Adw.ToggleGroup (1.7) — items:, selection:"},
    "TabView": {"role": "tabs", "defaults": {"variant": "tabview", "placement": "top"}, "doc": "TabView(selection:) { TabPage(\"notes.md\") { … } } — Adw tab bar + pages"},
    "TabBar": {"role": "tabs", "params": ["items"], "defaults": {"variant": "tabview", "placement": "top"}, "doc": "TabBar(items: [\"a.txt\", \"b.txt\"], selection:)"},
    "TabPage": {"role": "tab", "params": ["title"], "doc": "TabPage(\"Title\", icon:, badge:) { … }"},
    "Carousel": {"role": "scroll", "defaults": {"axes": "horizontal"}, "doc": "Carousel { pages } — horizontal pages"},
    "CarouselIndicatorDots": {"role": "pagination", "defaults": {"variant": "dots"}, "attrs": {"pages": "count", "position": "page"},
                              "doc": "CarouselIndicatorDots(pages: 4, position: 2)"},
    "CarouselIndicatorLines": {"role": "pagination", "defaults": {"variant": "lines"}, "attrs": {"pages": "count", "position": "page"}},

    "PreferencesWindow": {"role": "vstack", "defaults": {"alignment": "stretch", "spacing": 0}, "doc": "Preferences window (deprecated; use PreferencesDialog)"},
    "PreferencesDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "preferences"}, "doc": "PreferencesDialog(\"Preferences\") { PreferencesPage … }"},
    "PreferencesPage": {"role": "form", "params": ["title"], "doc": "PreferencesPage { PreferencesGroup … } — clamped, scrolling page of groups"},
    "PreferencesGroup": {"role": "section", "params": ["title"], "attrs": {"headerSuffix": "actions"},
                         "doc": "PreferencesGroup(\"Title\", description:) { rows } headerSuffix: { Button }"},
    "ActionRow": {"role": "listitem", "params": ["title"], "attrs": {"activatable": "chevron"},
                  "doc": "ActionRow(\"Title\", subtitle:, icon:, chevron: true) { suffix widgets }"},
    "SwitchRow": {"role": "toggle", "params": ["title"], "attrs": {"active": "isOn"}, "doc": "SwitchRow(\"Title\", subtitle:, active: true)"},
    "ComboRow": {"role": "listitem", "params": ["title"], "defaults": {"chevron": true},
                 "attrs": {"selected": "detail", "selection": "detail", "value": "detail"},
                 "doc": "ComboRow(\"Title\", subtitle:, selected: \"Current value\")"},
    "EntryRow": {"role": "textfield", "params": ["title"], "doc": "EntryRow(\"Title\", text:) — the title floats above the text"},
    "PasswordEntryRow": {"role": "textfield", "params": ["title"], "defaults": {"kind": "password", "reveal": true}, "doc": "PasswordEntryRow(\"Password\", text:)"},
    "SpinRow": {"role": "stepper", "params": ["title"], "doc": "SpinRow(\"Title\", value: 4)"},
    "ExpanderRow": {"role": "accordion", "params": ["title"], "doc": "ExpanderRow(\"Title\", subtitle:, expanded: true) { nested rows }"},
    "ButtonRow": {"role": "listitem", "params": ["title"], "variants": ["suggested", "destructive"],
                  "doc": "ButtonRow(\"Add Account\", icon:) · .variant(.suggested | .destructive) — 1.6"},
    "BoxedList": {"role": "list", "defaults": {"variant": "boxedList"}, "doc": "ListBox styled .boxed-list — rows in a rounded card"},
    "ListBox": {"role": "list", "variants": ["boxedList", "boxedListSeparate", "navigationSidebar", "richList", "plain"],
                "doc": "ListBox { rows } · .variant(.boxedList | .navigationSidebar | .richList)"},
    "ListBoxRow": {"role": "listitem", "params": ["title"]},
    "ListView": {"role": "list", "variants": ["richList", "navigationSidebar", "plain"]},
    "ColumnView": {"role": "table", "doc": "ColumnView(columns: [\"Name\", \"Size\"], rows: [[…]]) — Gtk.ColumnView data table"},
    "ColumnViewColumn": {"role": "tablecolumn", "params": ["title"]},
    "NavigationSidebar": {"role": "sidebar", "params": ["title"], "doc": "ListBox.navigation-sidebar — NavigationSidebar(selection:) { SidebarItem(\"Wi-Fi\", icon:) … }"},
    "SidebarItem": {"role": "navitem", "params": ["label"], "doc": "SidebarItem(\"Wi-Fi\", icon: \"network-wireless\", badge:) · .selected()"},
    "TreeExpander": {"role": "treeitem", "params": ["label"]},
    "TreeListView": {"role": "tree"},

    "Button": {"role": "button", "params": ["label"],
               "variants": ["suggested", "destructive", "flat", "raised", "pill", "circular", "osd", "opaque", "linked"],
               "doc": "Button(\"Save\", icon:) · .variant(.suggested | .destructive | .flat | .pill | .circular | .osd)"},
    "SplitButton": {"role": "button", "params": ["label"], "defaults": {"split": true}, "doc": "SplitButton(\"Open\") — button + dropdown arrow"},
    "MenuButton": {"role": "menu", "params": ["label"], "variants": ["flat", "suggested", "circular"],
                   "doc": "MenuButton(icon: \"open-menu\", open: true) { MenuItem … }"},
    "ToggleButton": {"role": "button", "params": ["label"], "attrs": {"active": "selected"}, "doc": "ToggleButton(\"Bold\", active: true)"},
    "LinkButton": {"role": "link", "params": ["label", "destination"], "doc": "LinkButton(\"Website\", uri:)"},
    "Switch": {"role": "toggle", "params": ["label"], "attrs": {"active": "isOn"}, "doc": "Switch(active: true)"},
    "CheckButton": {"role": "checkbox", "params": ["label"], "attrs": {"active": "checked", "inconsistent": "checked"},
                    "variants": ["selectionMode"], "doc": "CheckButton(\"Label\", active: true)"},
    "RadioButton": {"role": "radio", "params": ["label"], "attrs": {"active": "checked"}, "doc": "CheckButton in a group — RadioButton(\"Label\", active: true)"},
    "Entry": {"role": "textfield", "params": ["placeholder"], "doc": "Entry(\"Placeholder\", text:, icon:) · .state(.focused | .error)"},
    "SearchEntry": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "search"}, "doc": "SearchEntry(\"Search\", text:)"},
    "SearchBar": {"role": "toolbar", "defaults": {"variant": "searchbar"}, "doc": "SearchBar { SearchEntry(…) } — revealed under the HeaderBar"},
    "PasswordEntry": {"role": "textfield", "params": ["placeholder"], "defaults": {"kind": "password", "reveal": true}},
    "EditableLabel": {"role": "textfield", "params": ["text"]},
    "TextView": {"role": "textfield", "params": ["text"], "defaults": {"kind": "multiline"}, "doc": "TextView(text:, rows:) — multi-line text area"},
    "SourceView": {"role": "code", "params": ["code"], "doc": "GtkSourceView 5 — SourceView(\"…\", language: \"python\", lineNumbers:, highlight:)"},
    "SpinButton": {"role": "stepper", "params": ["label"], "doc": "SpinButton(value: 4)"},
    "DropDown": {"role": "select", "params": ["label"], "attrs": {"model": "items", "selected": "selection"},
                 "doc": "DropDown(model: [\"A\", \"B\"], selected: \"A\", open:)"},
    "Scale": {"role": "slider", "params": ["label"], "doc": "Scale(value: 40, in: 0...100, marks: …)"},
    "ProgressBar": {"role": "progress", "params": ["label"], "attrs": {"fraction": "value", "text": "currentValueLabel"},
                    "variants": ["osd"], "doc": "ProgressBar(fraction: 0.6, showText:) — none = pulsing"},
    "Spinner": {"role": "progress", "defaults": {"variant": "spinner"}, "doc": "Adw.Spinner — indeterminate"},
    "LevelBar": {"role": "progress", "params": ["label"], "defaults": {"variant": "levelbar"},
                 "doc": "LevelBar(value: 0.7) · .color(.warning | .error | .success) for the low/high offsets"},
    "Calendar": {"role": "calendar", "doc": "Calendar(selection: \"2026-11-24\", marked: […])"},
    "Label": {"role": "text", "params": ["content"], "attrs": {"label": "content"},
              "doc": "Label(\"Text\", style: .title1 | .title2 | .title3 | .title4 | .heading | .caption | .captionHeading | .largeTitle) · .class(\"dim-label\")"},
    "Picture": {"role": "image", "params": ["name"]},
    "Avatar": {"role": "avatar", "params": ["name"], "attrs": {"text": "name"}, "doc": "Avatar(\"Ana Lima\", size: .large, image:) — Adwaita gradient colours"},
    "ShortcutLabel": {"role": "kbd", "params": ["keys"], "doc": "ShortcutLabel([\"Ctrl\", \"S\"])"},
    "Banner": {"role": "alert", "params": ["title"], "defaults": {"showIcon": false},
               "doc": "Banner(\"Title\", actions: { Button(\"Restart\") }) — the strip under a HeaderBar"},
    "Toast": {"role": "toast", "params": ["title"], "attrs": {"buttonLabel": "action"},
              "doc": "Toast(\"‘Report.pdf’ moved to trash\", buttonLabel: \"Undo\") — floats at the bottom"},
    "ToastOverlay": {"role": "group", "doc": "Hosts toasts; put the content and a Toast inside"},
    "StatusPage": {"role": "emptystate", "params": ["title"], "doc": "StatusPage(\"No Results\", icon: \"system-search\", description:) { Button(…).variant(.pill) }"},
    "AboutDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "about"},
                    "attrs": {"applicationName": "title", "developerName": "message", "applicationIcon": "icon"},
                    "doc": "AboutDialog(applicationName:, developerName:, applicationIcon:) { rows }"},
    "AlertDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alert"},
                    "attrs": {"heading": "title", "body": "message", "responses": "buttons", "defaultResponse": "primary"},
                    "doc": "AlertDialog(\"Delete Notes?\", body:, responses: [\"Cancel\", \"Delete\"], defaultResponse: \"Delete\", destructive: \"Delete\")"},
    "MessageDialog": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alert"},
                      "attrs": {"heading": "title", "body": "message", "responses": "buttons", "defaultResponse": "primary"}},
    "Dialog": {"role": "dialog", "params": ["title"], "doc": "Adw.Dialog(\"Title\") { ToolbarView … }"},
    "BottomSheet": {"role": "dialog", "params": ["title"], "defaults": {"variant": "sheet"}, "doc": "Adw.BottomSheet (1.6)"},
    "Popover": {"role": "card", "params": ["title"], "defaults": {"variant": "popover"}, "doc": "A popover surface; place it with .overlay(alignment:)"},
    "PopoverMenu": {"role": "menu", "params": ["label"], "doc": "PopoverMenu { MenuItem … } — an open menu popover"},
    "MenuItem": {"role": "menuitem", "params": ["label"], "doc": "MenuItem(\"Preferences\", shortcut: \"Ctrl+,\", checked:)"},
    "ActionBar": {"role": "toolbar", "defaults": {"variant": "actionbar"}, "doc": "ActionBar { start … Spacer() … end } — bottom bar"},
    "PathBar": {"role": "breadcrumb", "params": ["items"], "doc": "Nautilus path bar: PathBar([\"Home\", \"Projects\"])"},
    "Statusbar": {"role": "toolbar", "defaults": {"variant": "statusbar"}},
    "ColorDialogButton": {"role": "swatches", "doc": "colors: [..], selection:"},
    "FontDialogButton": {"role": "button", "params": ["label"], "defaults": {"variant": "font"}}
  }
}
