  "elements": {
    "ConsoleFrame": {"role": "card", "params": ["title"], "attrs": {"sidebar": "header", "code": "status", "bars": "headerAction"}, "variants": ["standard", "open"], "doc": "Elbow-framed console: ConsoleFrame(\"ENVIRONMENTAL\", code: \"07-3341\", sidebar: { SidebarButton… }, bars: { Bar… }) { content } footer: { Bar… } · .color(.lavender) recolours the elbows"},
    "Frame": {"role": "card", "params": ["title"], "attrs": {"sidebar": "header", "code": "status", "bars": "headerAction"}, "variants": ["standard", "open"], "doc": "Alias of ConsoleFrame"},
    "Panel": {"role": "card", "params": ["title"], "attrs": {"code": "status"}, "doc": "A small bracket-framed panel: Panel(\"SENSOR GRID\", code: \"4417\") { content } · .color(.periwinkle)"},
    "Elbow": {"role": "shape", "defaults": {"shape": "elbow"}, "attrs": {"corner": "variant"}, "variants": ["topLeading", "topTrailing", "bottomLeading", "bottomTrailing"], "doc": "A standalone elbow: Elbow(corner: .bottomLeading).frame(width: 160, height: 60)"},
    "Bar": {"role": "shape", "defaults": {"shape": "bar"}, "variants": ["plain", "capLeading", "capTrailing", "pill", "thin"], "doc": "A horizontal colour bar segment that fills the row: Bar().color(.peach) · .variant(.capTrailing) rounds its end · .frame(width: 80) fixes it"},
    "SidebarButton": {"role": "button", "params": ["label"], "attrs": {"code": "badge"}, "doc": "A full-width side-bar block: SidebarButton(\"SENSORS\", code: \"03-1147\").color(.lavender) · .selected() lights it"},
    "Pill": {"role": "button", "params": ["label"], "defaults": {"variant": "pill"}, "attrs": {"code": "badge"}, "variants": ["pill", "leading", "trailing", "block"], "doc": "Pill button with a right-aligned label: Pill(\"ENGAGE\", code: \"22\").color(.peach)"},
    "ConsoleButton": {"role": "button", "params": ["label"], "defaults": {"variant": "pill"}, "attrs": {"code": "badge"}, "variants": ["pill", "leading", "trailing", "block"], "doc": "Alias of Pill"},
    "Button": {"role": "button", "params": ["label"], "attrs": {"code": "badge"}, "variants": ["pill", "leading", "trailing", "block", "primary", "secondary", "destructive", "plain"], "doc": "Button(\"ACKNOWLEDGE\") — a pill; variants by end shape, colours with .color(…)"},
    "Readout": {"role": "stat", "params": ["label", "value"], "attrs": {"unit": "caption"}, "doc": "Big numeric readout: Readout(\"CORE TEMP\", value: \"2417\", change: \"+0.4\", unit: \"KELVIN\").color(.tan)"},
    "DataGrid": {"role": "table", "doc": "Rows of coloured numbers: DataGrid(columns: [\"DECK\", \"O2\", \"TEMP\"], rows: […])"},
    "SensorTable": {"role": "table", "doc": "Alias of DataGrid"},
    "Meter": {"role": "progress", "params": ["label"], "defaults": {"variant": "segmented"}, "variants": ["segmented", "solid"], "doc": "Segmented bar meter: Meter(\"SHIELD HARMONICS\", value: 0.72, showValue: true).color(.periwinkle)"},
    "SegmentedBar": {"role": "progress", "params": ["value"], "defaults": {"variant": "segmented"}, "variants": ["segmented", "solid"], "doc": "Meter without a label: SegmentedBar(0.4)"},
    "Gauge": {"role": "progress", "params": ["value"], "defaults": {"variant": "segmented"}, "variants": ["segmented", "solid"], "doc": "Gauge(value: 0.6) { Text(\"LOAD\") } — drawn as a segmented bar"},
    "Alert": {"role": "alert", "params": ["title"], "defaults": {"severity": "error"}, "variants": ["redAlert", "standard"], "doc": "Alert banner (red by default): Alert(\"HULL BREACH\", message: \"DECK 07 SEALED\") · severity: .warning | .info"},
    "RedAlert": {"role": "alert", "params": ["title"], "defaults": {"severity": "error", "variant": "redAlert", "showIcon": false}, "doc": "The full red-alert banner with striped end caps: RedAlert(\"CONDITION RED\", message: \"ALL HANDS\")"},
    "StatusLight": {"role": "badge", "params": ["text"], "doc": "Small status pill: StatusLight(\"NOMINAL\").color(.blue)"},
    "Indicator": {"role": "badge", "params": ["text"], "doc": "Alias of StatusLight"},
    "SensorSweep": {"role": "map", "doc": "Sensor sweep display: rings, grid and a sweep beam; pins: [(x, y, \"CONTACT 1\")]"},
    "SensorGrid": {"role": "map", "defaults": {"variant": "grid"}, "doc": "Sensor grid display without the sweep beam"},
    "ConsoleLog": {"role": "code", "params": ["code"], "defaults": {"variant": "terminal"}, "doc": "Console log: ConsoleLog(\"$ status --all\\n> ALL SYSTEMS NOMINAL\", title: \"LOG 4417\")"},
    "Header": {"role": "text", "params": ["content"], "defaults": {"font": "largeTitle"}, "doc": "Large uppercase console heading"},
    "Caption": {"role": "text", "params": ["content"], "defaults": {"font": "caption"}, "doc": "Small dim caption"},
    "Cascade": {"role": "text", "params": ["content"], "doc": "A block of scrolling numbers, one row per line: Cascade(\"0447 1138 22\\n…\")"},
    "ConsoleTabs": {"role": "tabs", "params": ["items"], "defaults": {"placement": "top"}, "doc": "Pill tabs: ConsoleTabs([\"PRIMARY\", \"AUX\"], selection: \"PRIMARY\")"},
    "ConsoleToggle": {"role": "toggle", "params": ["label"], "doc": "Two-state block switch (same as Toggle)"},
    "ListItem": {"role": "listitem", "params": ["title"], "doc": "Console list row with a coloured lead block: ListItem(\"PORT NACELLE\", subtitle: \"…\", detail: \"98.2\")"},
    "Divider": {"role": "divider", "doc": "A thin colour rule"}
  }
}
