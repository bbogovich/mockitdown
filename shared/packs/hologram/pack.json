      "color-brown": "#c49a6c",
      "color-gray": "#6d8a96",
      "chart-1": "#4ff0ff",
      "chart-2": "#a8fff0",
      "chart-3": "#ffb347",
      "chart-4": "#6fa8ff",
      "chart-5": "#ff4d5e",
      "chart-6": "#2bbfcf",
      "note": "rgb(79 240 255 / 0.12)",
      "code-bg": "rgb(79 240 255 / 0.05)",
      "code-fg": "#c8fbff",
      "code-kw": "#4ff0ff",
      "code-str": "#a8fff0",
      "code-num": "#ffb347",
      "code-comment": "#4a95a3",
      "code-fn": "#7fdbe8",
      "code-type": "#6fa8ff",
      "term-bg": "rgb(79 240 255 / 0.04)",
      "term-fg": "#7fdbe8",
      "term-prompt": "#4ff0ff",
      "grid-line": "rgb(79 240 255 / 0.14)",
      "map-land": "transparent",
      "map-water": "transparent",
      "map-park": "transparent",
      "map-road": "rgb(79 240 255 / 0.38)"
    }
  },
  "elements": {
    "HUDFrame": {
      "role": "card",
      "params": [
        "title"
      ],
      "attrs": {
        "code": "status"
      },
      "variants": [
        "standard",
        "plain",
        "alert"
      ],
      "doc": "Chamfered panel with corner brackets: HUDFrame(\"FLIGHT\", subtitle: \"SYS 3\", code: \"A-04\") { … } footer: { … } · .variant(.alert) turns it amber"
    },
    "Panel": {
      "role": "card",
      "params": [
        "title"
      ],
      "attrs": {
        "code": "status"
      },
      "variants": [
        "standard",
        "plain",
        "alert"
      ],
      "doc": "Alias of HUDFrame"
    },
    "DataPanel": {
      "role": "card",
      "params": [
        "title"
      ],
      "defaults": {
        "variant": "data"
      },
      "attrs": {
        "code": "status"
      },
      "variants": [
        "data"
      ],
      "doc": "A small panel with a tab-like title strip: DataPanel(\"ATMOS\", code: \"03\") { LabeledContent… }"
    },
    "Reticle": {
      "role": "shape",
      "defaults": {
        "shape": "reticle"
      },
      "variants": [
        "standard",
        "lock"
      ],
      "doc": "Targeting circle with crosshair ticks; size it with .frame(width:height:) · .variant(.lock) adds the lock brackets"
    },
    "TargetLock": {
      "role": "shape",
      "defaults": {
        "shape": "reticle",
        "variant": "lock"
      },
      "doc": "Reticle with lock brackets, drawn amber"
    },
    "RadialGauge": {
      "role": "progress",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "radial",
        "showValue": true
      },
      "doc": "Arc gauge with a tick ring and the value in its centre: RadialGauge(\"THRUST\", value: 0.72)"
    },
    "Ring": {
      "role": "progress",
      "params": [
        "value"
      ],
      "defaults": {
        "variant": "ring"
      },
      "doc": "Segmented ring: Ring(0.4, label: \"SHIELD\", showValue: true)"
    },
    "SegmentBar": {
      "role": "progress",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "segmented",
        "showValue": true
      },
      "doc": "Segmented linear meter: SegmentBar(\"FUEL\", value: 0.6)"
    },
    "Scanner": {
      "role": "map",
      "variants": [
        "sweep",
        "grid"
      ],
      "doc": "Radar sweep: range rings, bearing lines and a sweep beam; pins: [(x, y, \"CONTACT\")] · .variant(.grid) without the beam"
    },
    "Alert": {
      "role": "alert",
      "params": [
        "title"
      ],
      "defaults": {
        "severity": "warning"
      },
      "variants": [
        "standard",
        "banner"
      ],
      "doc": "Chamfered warning strip, amber by default: Alert(\"PROXIMITY\", message: \"…\") · severity: .error is critical red, .info cyan"
    },
    "Critical": {
      "role": "alert",
      "params": [
        "title"
      ],
      "defaults": {
        "severity": "error",
        "variant": "banner"
      },
      "doc": "Full-width critical banner in red"
    },
    "Readout": {
      "role": "stat",
      "params": [
        "label",
        "value"
      ],
      "attrs": {
        "unit": "caption"
      },
      "doc": "Bracketed numeric readout: Readout(\"ALT\", value: \"12 480\", change: \"+120\", unit: \"M\")"
    },
    "HexBadge": {
      "role": "badge",
      "params": [
        "text"
      ],
      "defaults": {
        "variant": "hex"
      },
      "doc": "Hexagonal tag: HexBadge(\"A3\") · .color(.orange)"
    },
    "Telemetry": {
      "role": "chart",
      "defaults": {
        "kind": "line"
      },
      "doc": "Thin glowing line chart: Telemetry(series: [[…]], labels: […])"
    },
    "Waveform": {
      "role": "chart",
      "defaults": {
        "kind": "area"
      },
      "doc": "Filled trace: Waveform(values: […])"
    },
    "DataTable": {
      "role": "table",
      "defaults": {
        "variant": "bracket"
      },
      "doc": "Table of bracketed rows"
    },
    "HUDButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "variant": "outline"
      },
      "variants": [
        "outline",
        "solid",
        "ghost"
      ],
      "doc": "Chamfered outline button: HUDButton(\"ENGAGE\", variant: .solid)"
    },
    "Header": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "font": "title2"
      },
      "doc": "Panel heading in spaced capitals"
    },
    "Caption": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "font": "caption"
      },
      "doc": "Tiny spaced-capital label"
    },
    "Rule": {
      "role": "divider",
      "params": [
        "label"
      ],
      "doc": "A thin rule with tick marks; Rule(\"SECTOR 2\") sets a label into it"
    }
  }
}
