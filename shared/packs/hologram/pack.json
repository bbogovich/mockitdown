      "ho-fill": "rgb(79 240 255 / 0.05)",
      "ho-fill-2": "rgb(79 240 255 / 0.12)",
      "ho-fill-3": "rgb(79 240 255 / 0.22)",
      "ho-glow": "0 0 6px rgb(79 240 255 / 0.55)",
      "ho-text-glow": "0 0 6px rgb(79 240 255 / 0.45)",
      "ho-svg-glow": "drop-shadow(0 0 2px rgb(79 240 255 / 0.8))",
      "ho-amber": "#ffb347",
      "ho-red": "#ff4d5e",
