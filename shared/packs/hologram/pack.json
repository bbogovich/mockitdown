{
  "id": "hologram",
  "name": "Holographic HUD",
  "framework": "An original homage to the translucent cyan heads-up displays of modern science-fiction films",
  "version": "Projection build 1",
  "hidden": true,
  "modules": [
    "Hologram",
    "HUD",
    "HoloHUD"
