    "dark": {
      "bg": "#000000",
      "surface": "#000000",
      "surface-2": "#000000",
      "surface-3": "#555555",
      "fg": "#ffffff",
      "fg-2": "#ffffff",
      "fg-3": "#aaaaaa",
      "border": "#ffffff",
      "divider": "#ffffff",
      "accent": "#ffffff",
      "on-accent": "#000000",
