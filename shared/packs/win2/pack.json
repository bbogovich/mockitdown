      "code-num": "#ffffff",
      "code-comment": "#aaaaaa",
      "code-fn": "#ffffff",
      "code-type": "#ffffff",
      "grid-line": "#555555",
      "chart-1": "#55ffff",
      "chart-2": "#ffff55",
      "chart-3": "#55ff55",
      "chart-4": "#ff55ff",
      "chart-5": "#5555ff",
      "chart-6": "#ff5555",
      "desktop": "#000055",
      "frame": "#000000",
      "frame-line": "#ffffff",
      "caption-bg": "#00aaaa",
      "caption-fg": "#000000",
      "caption-inactive-bg": "#000000",
      "caption-inactive-fg": "#ffffff",
      "box-bg": "#000000",
      "box-fg": "#ffffff",
      "menu-bg": "#000000",
      "menu-fg": "#ffffff",
      "hilite-bg": "#ffffff",
      "hilite-fg": "#000000",
      "scroll-bg": "#555555",
      "button-bg": "#000000",
      "disabled-fg": "#555555",
      "icon-label-bg": "#000000"
