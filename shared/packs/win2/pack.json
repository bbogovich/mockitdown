{
  "id": "win2",
  "name": "Windows 2.x",
  "framework": "Microsoft Windows 2.0 / 2.1 (1987–88), EGA/VGA 16 colours",
  "version": "Windows 2.11",
  "modules": ["Windows2", "Win2", "MSDOSExecutive"],
  "device": "desktop",
  "chrome": {"desktop": "window", "wide": "window", "tablet": "window", "phone": "window"},
  "sizes": {"desktop": [640, 480], "wide": [800, 600], "tablet": [640, 350], "phone": [320, 200]},
  "tokens": {
