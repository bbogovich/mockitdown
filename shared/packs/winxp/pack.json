  "elements": {
    "Window": {
      "role": "card",
      "params": [
        "title"
      ],
      "variants": [
        "active",
        "inactive",
        "dialog",
        "tool"
      ],
      "doc": "A Luna window drawn inside a Desktop: blue title bar with min/max/close. Window(\"My Computer\", systemImage: \"computer\") { … } · .variant(.inactive | .dialog | .tool)"
    },
    "DialogBody": {
      "role": "vstack",
      "variants": [
        "help"
      ],
      "doc": "Root of a dialog screen: the frame's title bar keeps only Close (and ? with .variant(.help))."
    },
    "Desktop": {
      "role": "canvas",
      "doc": "The desktop with a sky-and-hill wallpaper; place windows and icons with .position(x:y:)"
    },
    "DesktopIcon": {
      "role": "label",
      "params": [
        "title"
      ],
      "doc": "DesktopIcon(\"My Computer\", systemImage: \"computer\") — 32 px icon over a white shadowed label; .selected()"
    },
    "Taskbar": {
      "role": "hstack",
      "doc": "The blue taskbar: StartButton, QuickLaunch, TaskbarButton…, Spacer, NotificationArea"
    },
    "StartButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "defaults": {
        "label": "start",
        "systemImage": "flag"
      },
      "doc": "The green Start button (.selected() while the menu is open)"
    },
    "QuickLaunch": {
      "role": "hstack",
      "doc": "Quick Launch toolbar: small IconButtons beside Start"
    },
    "TaskbarButton": {
      "role": "button",
      "params": [
        "label"
      ],
      "doc": "A window's taskbar button; .selected() for the active window"
    },
    "NotificationArea": {
      "role": "hstack",
      "doc": "The light-blue tray at the right of the taskbar: TrayIcon… Clock"
    },
    "SystemTray": {
      "role": "hstack",
      "doc": "Alias of NotificationArea"
    },
    "TrayIcon": {
      "role": "icon",
      "params": [
        "name"
      ],
      "doc": "A 16 px notification icon"
    },
    "Clock": {
      "role": "text",
      "params": [
        "content"
      ],
      "defaults": {
        "content": "10:42 AM"
      },
      "doc": "Taskbar clock"
    },
    "Balloon": {
      "role": "tooltip",
      "params": [
        "text"
      ],
      "defaults": {
        "placement": "top"
      },
      "doc": "Notification balloon pointing at its child: Balloon(\"Updates are ready\", message: \"…\") { TrayIcon(\"shield\") }"
    },
    "StartMenu": {
      "role": "card",
      "params": [
        "title"
      ],
      "doc": "Two-column Start menu: StartMenu(\"Alex\", avatar: \"Alex\") { StartMenuPrograms{…} StartMenuPlaces{…} } actions: { LogOffButton() TurnOffButton() }"
    },
    "StartMenuPrograms": {
      "role": "vstack",
      "doc": "The white left column of the Start menu (pinned and frequent programs)"
    },
    "StartMenuPlaces": {
      "role": "vstack",
      "doc": "The light-blue right column (My Documents, Control Panel, Help, Search, Run…)"
    },
    "StartMenuItem": {
      "role": "listitem",
      "params": [
        "title"
      ],
