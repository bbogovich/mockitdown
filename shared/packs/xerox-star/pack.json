{
  "id": "xerox-star",
  "name": "Xerox Star",
  "framework": "Xerox 8010 Information System “Star” (1981), 1-bit bitmapped display",
  "version": "ViewPoint precursor, Star 1981",
  "modules": ["XeroxStar", "Star8010", "Xerox"],
  "device": "desktop",
  "chrome": {"desktop": "window", "wide": "window", "tablet": "window", "phone": "window"},
  "sizes": {"desktop": [1024, 808], "wide": [1024, 808], "tablet": [800, 600]},
  "tokens": {
    "light": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surface-2": "#ffffff",
      "surface-3": "#ffffff",
      "fg": "#000000",
      "fg-2": "#000000",
      "fg-3": "#000000",
      "border": "#000000",
      "divider": "#000000",
      "accent": "#000000",
      "on-accent": "#ffffff",
      "accent-soft": "#000000",
      "danger": "#000000",
      "warning": "#000000",
      "success": "#000000",
      "info": "#000000",
      "field-bg": "#ffffff",
      "field-border": "#000000",
      "scrim": "transparent",
      "shadow-1": "none",
      "shadow-2": "none",
      "shadow-3": "none",
      "radius-s": "0px",
      "radius-m": "0px",
      "radius-l": "0px",
      "radius-xl": "0px",
      "radius-pill": "999px",
      "font": "Helvetica, Arial, sans-serif",
      "font-mono": "\"Courier New\", Courier, monospace",
      "font-size": "13px",
      "line-height": "1.3",
      "icon-stroke": "1.6",
      "icon-size": "16px",
      "control-h": "22px",
      "gap": "8px",
      "pad": "10px",
      "chrome-bg": "#000000",
      "chrome-fg": "#ffffff",
      "fs-display": "30px", "fw-display": "700",
      "fs-largeTitle": "24px", "fw-largeTitle": "700",
      "fs-title": "20px", "fw-title": "700",
      "fs-title2": "17px", "fw-title2": "700",
      "fs-title3": "15px", "fw-title3": "700",
      "fs-headline": "13px", "fw-headline": "700",
      "fs-subheadline": "13px", "fw-subheadline": "400",
      "fs-body": "13px", "fw-body": "400",
      "fs-callout": "13px", "fw-callout": "400",
      "fs-footnote": "11px", "fw-footnote": "400",
      "fs-caption": "10px", "fw-caption": "400",
      "fs-caption2": "9px", "fw-caption2": "400",
      "fs-overline": "10px", "fw-overline": "700",
      "color-red": "#000000",
      "color-orange": "#000000",
      "color-yellow": "#ffffff",
      "color-green": "#000000",
      "color-mint": "#ffffff",
      "color-teal": "#000000",
      "color-cyan": "#ffffff",
      "color-blue": "#000000",
      "color-indigo": "#000000",
      "color-purple": "#000000",
      "color-pink": "#ffffff",
      "color-brown": "#000000",
      "color-gray": "#808080",
      "chart-1": "#000000",
      "chart-2": "#7a7a7a",
      "chart-3": "#c4c4c4",
      "chart-4": "#3d3d3d",
      "chart-5": "#a0a0a0",
      "chart-6": "#e2e2e2",
      "code-bg": "#ffffff",
      "code-fg": "#000000",
      "code-kw": "#000000",
      "code-str": "#000000",
      "code-num": "#000000",
      "code-comment": "#000000",
      "code-fn": "#000000",
      "code-type": "#000000",
      "term-bg": "#ffffff",
      "term-fg": "#000000",
      "term-prompt": "#000000",
      "grid-line": "#000000",
      "note": "#ffffff",
      "ink": "#000000",
      "paper": "#ffffff",
      "desktop": "conic-gradient(from 90deg at 1px 1px, #ffffff 25%, #000000 0 50%, #ffffff 0) 0 0 / 3px 3px",
      "document-font": "Georgia, \"Times New Roman\", Times, serif"
    },
    "dark": {
      "bg": "#000000",
      "surface": "#000000",
      "surface-2": "#000000",
      "surface-3": "#000000",
      "fg": "#ffffff",
      "fg-2": "#ffffff",
      "fg-3": "#ffffff",
      "border": "#ffffff",
      "divider": "#ffffff",
      "accent": "#ffffff",
      "on-accent": "#000000",
      "accent-soft": "#ffffff",
      "danger": "#ffffff",
      "warning": "#ffffff",
      "success": "#ffffff",
      "info": "#ffffff",
      "field-bg": "#000000",
      "field-border": "#ffffff",
      "chrome-bg": "#ffffff",
      "chrome-fg": "#000000",
      "chart-1": "#ffffff",
      "chart-2": "#8a8a8a",
      "chart-3": "#4a4a4a",
      "chart-4": "#c8c8c8",
      "chart-5": "#6a6a6a",
      "chart-6": "#2a2a2a",
      "color-red": "#ffffff",
      "color-orange": "#ffffff",
      "color-yellow": "#000000",
      "color-green": "#ffffff",
      "color-mint": "#000000",
      "color-teal": "#ffffff",
      "color-cyan": "#000000",
      "color-blue": "#ffffff",
      "color-indigo": "#ffffff",
      "color-purple": "#ffffff",
      "color-pink": "#000000",
      "color-brown": "#ffffff",
      "code-bg": "#000000",
      "code-fg": "#ffffff",
      "code-kw": "#ffffff",
      "code-str": "#ffffff",
      "code-num": "#ffffff",
      "code-comment": "#ffffff",
      "code-fn": "#ffffff",
      "code-type": "#ffffff",
      "term-bg": "#000000",
      "term-fg": "#ffffff",
      "term-prompt": "#ffffff",
      "grid-line": "#ffffff",
      "ink": "#ffffff",
      "paper": "#000000",
      "desktop": "conic-gradient(from 90deg at 1px 1px, #000000 25%, #ffffff 0 50%, #000000 0) 0 0 / 3px 3px"
    }
  },
  "fonts": {
    "classic": "body",
    "modern": "body",
    "heading": "title2",
    "title": "title",
    "caption": "caption"
  },
  "icons": {
    "Document": "doc",
    "Folder": "folder",
    "Printer": "printer",
    "InBasket": "tray",
    "OutBasket": "tray.full",
    "FileDrawer": "archivebox",
    "Directory": "book",
    "Calculator": "number",
    "Record": "square.grid.3x3",
    "Graphics": "chart.bar",
    "Mail": "envelope",
    "User": "person"
  },
  "modifiers": {
    "highlighted": {"attr": "selected"}
  },
  "elements": {
    "Desktop": {"role": "zstack", "defaults": {"alignment": "topLeading"}, "doc": "The grey (stippled) desktop; place icons and windows inside"},
    "IconColumn": {"role": "vstack", "defaults": {"spacing": 18, "alignment": "center"}, "doc": "A column of desktop icons"},
    "IconRow": {"role": "hstack", "defaults": {"spacing": 22, "alignment": "top"}, "doc": "A row of desktop icons"},
    "DesktopIcon": {"role": "label", "params": ["title"], "variants": ["document", "folder", "printer", "inbasket", "outbasket", "filedrawer", "directory", "calculator"], "doc": "A pictogram with its name, e.g. DesktopIcon(\"Report\", icon: \"Document\"); .selected() shows it in reverse video"},
    "StarWindow": {"role": "card", "params": ["title"], "doc": "Window: black header strip with the name and command buttons (headerAction: { WindowCommand(…) })"},
    "Window": {"role": "card", "params": ["title"], "doc": "Alias of StarWindow"},
    "WindowCommand": {"role": "button", "params": ["label"], "defaults": {"variant": "command"}, "doc": "A command button in a window or property-sheet header"},
    "PropertySheet": {"role": "card", "params": ["title"], "defaults": {"variant": "sheet"}, "doc": "Property sheet: header with Done/Cancel/Defaults, then PropertyField rows"},
    "OptionSheet": {"role": "card", "params": ["title"], "defaults": {"variant": "sheet"}, "doc": "Option sheet (parameters of a command such as Print)"},
    "PropertyField": {"role": "labeled", "params": ["label", "value"], "doc": "PropertyField(\"Name\") { FieldBox(…) } — a label with its value"},
    "FieldBox": {"role": "textfield", "params": ["text"], "doc": "A boxed text property"},
    "ChoiceButtons": {"role": "segmented", "params": ["label"], "doc": "ChoiceButtons(items: [\"Left\", \"Center\", \"Right\"], selection: \"Left\"): the chosen value is in reverse video"},
    "ChoiceButton": {"role": "button", "params": ["label"], "defaults": {"variant": "choice"}, "doc": "A single choice box; .selected() reverses it"},
    "OnOffBox": {"role": "checkbox", "params": ["label"], "doc": "A boolean property: a small square, checked when on"},
    "CommandKeys": {"role": "kbd", "params": ["keys"], "defaults": {"keys": ["AGAIN", "DELETE", "FIND", "COPY", "SAME", "MOVE", "OPEN", "PROPS", "HELP", "UNDO"]}, "doc": "The universal-command keys of the Star keyboard as a strip"},
    "CommandKey": {"role": "kbd", "params": ["keys"], "doc": "One function key, e.g. CommandKey(\"MOVE\")"},
    "MessageLine": {"role": "toolbar", "defaults": {"variant": "message"}, "doc": "The prompt/message area at the top of the screen"},
    "DocumentPage": {"role": "vstack", "defaults": {"alignment": "leading", "spacing": 8}, "doc": "A WYSIWYG page in a document window (Classic serif text)"},
    "Heading": {"role": "text", "params": ["content"], "defaults": {"font": "title2"}, "doc": "Document heading"},
    "Paragraph": {"role": "text", "params": ["content"], "doc": "Document paragraph"},
    "FolderList": {"role": "list", "doc": "The contents of an opened folder: FolderEntry rows"},
    "FolderEntry": {"role": "listitem", "params": ["title"], "doc": "FolderEntry(\"Memo\", icon: \"Document\", detail: \"12-Mar-81\")"},
    "ScrollBar": {"role": "slider", "params": ["value"], "defaults": {"variant": "scrollbar", "orientation": "vertical"}, "doc": "The window scroll bar with arrow and next/previous-page boxes"},
    "PopUpMenu": {"role": "menu", "params": ["label"], "doc": "A pop-up command menu"},
    "MenuCommand": {"role": "menuitem", "params": ["label"], "doc": "A command in a pop-up menu"},
    "Confirmation": {"role": "dialog", "params": ["title"], "defaults": {"variant": "alert"}, "doc": "A boxed confirmation/error message with Yes/No commands"},
    "Frame": {"role": "card", "params": ["title"], "defaults": {"variant": "frame"}, "doc": "A graphics frame anchored in a document"}
  }
}
