// shadcn own elements: Dialog, DialogClose, Drawer, DropdownMenu, DropdownMenuCheckboxItem, DropdownMenuContent, DropdownMenuGroup, DropdownMenuItem, DropdownMenuLabel, DropdownMenuRadioItem, DropdownMenuSeparator, DropdownMenuShortcut
VStack(alignment: .leading, spacing: 12) {
  Dialog("Title") { Text("Content"); Button("Action") }
  DialogClose()
  Drawer("Title") { Text("Content"); Button("Action") }
  DropdownMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  DropdownMenuCheckboxItem("Label")
  DropdownMenuContent() { Text("Content"); Button("Action") }
  DropdownMenuGroup() { Text("Content"); Button("Action") }
  DropdownMenuItem("Label")
  DropdownMenuLabel("Content")
  DropdownMenuRadioItem("Label")
  DropdownMenuSeparator()
  DropdownMenuShortcut("Content")
}
.padding()
