// fluent own elements: MenuBarItem, MenuFlyout, MenuFlyoutItem, MenuFlyoutSeparator, MenuFlyoutSubItem, NavigationView, NavigationViewItem, NavigationViewItemHeader, NavigationViewItemSeparator, NumberBox, PasswordBox, PathIcon
VStack(alignment: .leading, spacing: 12) {
  MenuBarItem("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  MenuFlyout("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  MenuFlyoutItem("Label")
  MenuFlyoutSeparator()
  MenuFlyoutSubItem("Label")
  NavigationView() { Text("Content"); Button("Action") }
  NavigationViewItem("Label")
  NavigationViewItemHeader("Content")
  NavigationViewItemSeparator()
  NumberBox("Header")
  PasswordBox("Header")
  PathIcon("star")
}
.padding()
