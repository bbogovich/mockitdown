// sapui5 own elements: Toolbar, ToolbarSeparator, ToolbarSpacer, UploadSet, VBox, VariantManagement, Wizard, WizardStep
VStack(alignment: .leading, spacing: 12) {
  Toolbar() { Button("Save"); Button("Share") }
  ToolbarSeparator()
  ToolbarSpacer()
  UploadSet("Label")
  VBox() { Text("Content"); Button("Action") }
  VariantManagement("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  Wizard() { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  WizardStep("Title")
}
.padding()
