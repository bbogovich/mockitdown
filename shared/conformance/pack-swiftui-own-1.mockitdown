// swiftui own elements: ActionSheet, Alert, AnyView, AreaMark, AsyncImage, BarMark, Button, Canvas, Card, Chart, ColorPicker, CommandGroup
VStack(alignment: .leading, spacing: 12) {
  ActionSheet("Title") { Text("Content"); Button("Action") }
  Alert("Delete this photo?", message: "It will be removed from all your devices.", actions: { Button("Cancel", role: .cancel); Button("Delete", role: .destructive) })
  AnyView() { Text("Content"); Button("Action") }
  AreaMark(values: [3, 5, 2, 6, 4])
  AsyncImage().frame(width: 160, height: 96)
  BarMark(values: [3, 5, 2, 6, 4])
  Button("Share", systemImage: "square.and.arrow.up")
  Canvas("Label").frame(width: 160, height: 96)
  Card("Title") { Text("Content"); Button("Action") }
  Chart(values: [3, 5, 2, 6, 4])
  ColorPicker("Label") { Text("Content"); Button("Action") }
  CommandGroup(after: .newItem) { Button("New Folder").keyboardShortcut("n", modifiers: [.shift, .command]) }
}
.padding()
