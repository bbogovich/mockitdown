// bootstrap own elements: DropdownButton, DropdownDivider, DropdownHeader, DropdownItem, DropdownItemText, DropdownMenu, DropdownToggle, Figure, FigureCaption, FigureImage, FloatingLabel, Form
VStack(alignment: .leading, spacing: 12) {
  DropdownButton("Title") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  DropdownDivider()
  DropdownHeader("Content")
  DropdownItem("Label")
  DropdownItemText("Content")
  DropdownMenu() { Button("Open"); Button("Save"); Divider(); Button("Close") }
  DropdownToggle("Label")
  Figure() { Text("Content"); Button("Action") }
  FigureCaption("Content")
  FigureImage().frame(width: 160, height: 96)
  FloatingLabel("Label")
  Form() { TextField("Name"); Toggle("Notifications", isOn: true) }
}
.padding()
