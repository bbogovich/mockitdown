// antd own elements: Calendar, Card, CardGrid, CardMeta, Carousel, Cascader, CheckCard, CheckableTag, Checkbox, CheckboxGroup, Col, Collapse
VStack(alignment: .leading, spacing: 12) {
  Calendar()
  Card("Title") { Text("Content"); Button("Action") }
  CardGrid() { Text("Content"); Button("Action") }
  CardMeta("Title")
  Carousel().frame(width: 160, height: 96)
  Cascader("Placeholder")
  CheckCard("Title") { Text("Content"); Button("Action") }
  CheckableTag("Label")
  Checkbox("Label")
  CheckboxGroup() { Text("Content"); Button("Action") }
  Col() { Text("Content"); Button("Action") }
  Collapse() { Text("Content"); Button("Action") }
}
.padding()
