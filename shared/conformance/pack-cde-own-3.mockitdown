// cde own elements: XmLabel, XmList, XmListItem, XmMainWindow, XmMenuBar, XmMenuItem, XmMessageBox, XmNotebook, XmOptionMenu, XmPanedWindow, XmPopupMenu, XmPulldownMenu
VStack(alignment: .leading, spacing: 12) {
  XmLabel("Content")
  XmList() { Text("First item"); Text("Second item") }
  XmListItem("Title")
  XmMainWindow() { Text("Content"); Button("Action") }
  XmMenuBar() { Button("Save"); Button("Share") }
  XmMenuItem("Label")
  XmMessageBox("Title") { Text("Content"); Button("Action") }
  XmNotebook() { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  XmOptionMenu("Label")
  XmPanedWindow() { Text("Content"); Button("Action") }
  XmPopupMenu() { Button("Open"); Button("Save"); Divider(); Button("Close") }
  XmPulldownMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
}
.padding()
