// kde-plasma own elements: FormSwitchDelegate, FormTextDelegate, FormTextFieldDelegate, Frame, GlobalDrawer, GridLayout, GroupBox, HamburgerMenu, Heading, IconView, InlineMessage, ItemDelegate
VStack(alignment: .leading, spacing: 12) {
  FormSwitchDelegate("Label")
  FormTextDelegate("Title")
  FormTextFieldDelegate("Label")
  Frame("Title") { Text("Content"); Button("Action") }
  GlobalDrawer("Title") { Text("Content"); Button("Action") }
  GridLayout() { Text("Content"); Button("Action") }
  GroupBox("Title") { Text("Content"); Button("Action") }
  HamburgerMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  Heading("Content")
  IconView() { Text("Content"); Button("Action") }
  InlineMessage("Text")
  ItemDelegate("Title")
}
.padding()
