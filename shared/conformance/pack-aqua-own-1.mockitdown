// aqua own elements: Alert, AlertSheet, AppMenu, ApplicationIcon, BevelButton, Box, Browser, BrowserCell, BrowserColumn, Button, CheckBox, ColorWell
VStack(alignment: .leading, spacing: 12) {
  Alert("Title") { Text("Content"); Button("Action") }
  AlertSheet("Title") { Text("Content"); Button("Action") }
  AppMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  ApplicationIcon("Title")
  BevelButton("Label")
  Box("Title") { Text("Content"); Button("Action") }
  Browser() { Text("Content"); Button("Action") }
  BrowserCell("Title")
  BrowserColumn() { Text("First item"); Text("Second item") }
  Button("Label")
  CheckBox("Label")
  ColorWell()
}
.padding()
