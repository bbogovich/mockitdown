// prime own elements: Textarea, TieredMenu, Timeline, TimelineEvent, Toast, ToggleButton, ToggleSwitch, Toolbar, Tooltip, Tree, TreeNode, TreeSelect
VStack(alignment: .leading, spacing: 12) {
  Textarea("Placeholder")
  TieredMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  Timeline() { TimelineItem("Created"); TimelineItem("Shipped") }
  TimelineEvent("Title")
  Toast("Summary")
  ToggleButton("Label")
  ToggleSwitch("Label")
  Toolbar() { Button("Save"); Button("Share") }
  Tooltip("Text") { Text("Content"); Button("Action") }
  Tree() { TreeItem("Folder") { TreeItem("File") } }
  TreeNode("Label")
  TreeSelect("Placeholder")
}
.padding()
