// winxp own elements: MenuBar, MenuBarItem, MessageBox, MonthCalendar, MultilineTextBox, NotificationArea, OptionButton, PasswordBox, ProgressBar, PropertyRow, PushButton, QuickLaunch
VStack(alignment: .leading, spacing: 12) {
  MenuBar() { Button("Save"); Button("Share") }
  MenuBarItem("Label")
  MessageBox("Title") { Text("Content"); Button("Action") }
  MonthCalendar()
  MultilineTextBox("Text")
  NotificationArea() { Text("Content"); Button("Action") }
  OptionButton("Label")
  PasswordBox("Placeholder")
  ProgressBar("Label")
  PropertyRow("Label", "Value") { Text("Content"); Button("Action") }
  PushButton("Label")
  QuickLaunch() { Text("Content"); Button("Action") }
}
.padding()
