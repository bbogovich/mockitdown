// swiftui own elements: Map, Menu, MultiDatePicker, NavigationLink, NavigationSplitView, NavigationStack, NavigationView, OutlineGroup, PasteButton, PhotosPicker, Picker, PointMark
VStack(alignment: .leading, spacing: 12) {
  Map("Label").frame(width: 160, height: 96)
  Menu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  MultiDatePicker("Label")
  NavigationLink("Title")
  NavigationSplitView {
  List {
    Label("Inbox", systemImage: "tray")
    Label("Sent", systemImage: "paperplane")
    Label("Archive", systemImage: "archivebox")
  }.navigationTitle("Mail")
} detail: {
  Text("Select a message")
}
  NavigationStack() { Text("Content"); Button("Action") }
  NavigationView() { Text("Content"); Button("Action") }
  OutlineGroup("Title") { Text("Content"); Button("Action") }
  PasteButton()
  PhotosPicker()
  Picker("Flavor", selection: "Vanilla") { Text("Chocolate"); Text("Vanilla"); Text("Strawberry") }
  PointMark(values: [3, 5, 2, 6, 4])
}
.padding()
