// primer own elements: TreeView, TreeViewItem, TreeViewSubTree, Truncate, UnderlineNav, UnderlineNavItem, UnderlinePanels, UnderlinePanelsTab
VStack(alignment: .leading, spacing: 12) {
  TreeView() { TreeItem("Folder") { TreeItem("File") } }
  TreeViewItem("Label")
  TreeViewSubTree() { Text("Content"); Button("Action") }
  Truncate("Content")
  UnderlineNav(["One", "Two", "Three"]) { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  TabView { UnderlineNavItem("Inbox") { Text("Inbox content") }; UnderlineNavItem("Archive") { Text("Archive content") } }
  UnderlinePanels(["One", "Two", "Three"]) { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  TabView { UnderlinePanelsTab("Inbox") { Text("Inbox content") }; UnderlinePanelsTab("Archive") { Text("Archive content") } }
}
.padding()
