// primer own elements: SegmentedControlIconButton, Select, SelectOption, SelectPanel, SkeletonAvatar, SkeletonBox, SkeletonText, Snippet, Spinner, SplitPageLayout, SplitPageLayoutContent, SplitPageLayoutPane
VStack(alignment: .leading, spacing: 12) {
  SegmentedControlIconButton("star")
  Select("Placeholder", options: ["Small", "Medium", "Large"], selection: "Medium")
  SelectOption("Content")
  SelectPanel("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  SkeletonAvatar().frame(width: 160, height: 96)
  SkeletonBox().frame(width: 160, height: 96)
  SkeletonText().frame(width: 160, height: 96)
  Snippet("let total = items.count")
  Spinner()
  SplitPageLayout() { Text("Content"); Button("Action") }
  SplitPageLayoutContent() { Text("Content"); Button("Action") }
  SplitPageLayoutPane() { Text("Content"); Button("Action") }
}
.padding()
