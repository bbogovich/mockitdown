// primer own elements: PageLayoutContentRow, PageLayoutFooter, PageLayoutHeader, PageLayoutPane, Pagination, Popover, ProgressBar, Radio, RadioGroup, RelativeTime, SegmentedControl, SegmentedControlButton
VStack(alignment: .leading, spacing: 12) {
  PageLayoutContentRow() { Text("Content"); Button("Action") }
  PageLayoutFooter() { Text("Content"); Button("Action") }
  PageLayoutHeader() { Text("Content"); Button("Action") }
  PageLayoutPane() { Text("Content"); Button("Action") }
  Pagination()
  Popover("Title") { Text("Content"); Button("Action") }
  ProgressBar(60)
  Radio("Label")
  RadioGroup("Label") { Radio("First", selected: true); Radio("Second") }
  RelativeTime("Content")
  SegmentedControl(["One", "Two", "Three"])
  SegmentedControlButton("Title")
}
.padding()
