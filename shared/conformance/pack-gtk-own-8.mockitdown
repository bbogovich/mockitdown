// gtk own elements: Statusbar, Switch, SwitchRow, TabBar, TabPage, TabView, TextView, Toast, ToastOverlay, ToggleButton, ToggleGroup, ToolbarView
VStack(alignment: .leading, spacing: 12) {
  Statusbar() { Button("Save"); Button("Share") }
  Switch("Label")
  SwitchRow("Title")
  TabBar(["One", "Two", "Three"]) { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  TabView { TabPage("Inbox") { Text("Inbox content") }; TabPage("Archive") { Text("Archive content") } }
  TabView() { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  TextView("Text")
  Toast("Title")
  ToastOverlay() { Text("Content"); Button("Action") }
  ToggleButton("Label")
  ToggleGroup(["One", "Two", "Three"])
  ToolbarView() { Text("Content"); Button("Action") }
}
.padding()
