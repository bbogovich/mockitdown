// swiftui own elements: GeometryReader, GlassEffectContainer, GroupBox, HSplitView, HelpLink, Image, Inspector, Label, LabeledContent, LineMark, Link, List
VStack(alignment: .leading, spacing: 12) {
  GeometryReader() { Text("Content"); Button("Action") }
  GlassEffectContainer() { Text("Content"); Button("Action") }
  GroupBox("Title") { Text("Content"); Button("Action") }
  HSplitView() { Text("Content"); Button("Action") }
  HelpLink()
  Image().frame(width: 160, height: 96)
  Inspector("Title") { Text("Content"); Button("Action") }
  Label("Title")
  LabeledContent("Label", "Value") { Text("Content"); Button("Action") }
  LineMark(values: [3, 5, 2, 6, 4])
  Link("Label")
  List(selection: "Inbox") {
  Section("Favourites") {
    Label("Inbox", systemImage: "tray")
    Label("Drafts", systemImage: "doc")
  }
  Section("Folders") {
    Label("Archive", systemImage: "archivebox")
    Label("Projects", systemImage: "folder")
  }
}
}
.padding()
