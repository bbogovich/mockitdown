// win31 own elements: POPUP, PUSHBUTTON, PasswordEdit, PopupMenu, ProgramGroup, ProgramGroupIcon, ProgramItem, ProgramManager, ProgressBar, PushButton, RADIOBUTTON, RTEXT
VStack(alignment: .leading, spacing: 12) {
  POPUP("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  PUSHBUTTON("Label")
  PasswordEdit("Text")
  PopupMenu() { Button("Open"); Button("Save"); Divider(); Button("Close") }
  ProgramGroup("Title") { Text("Content"); Button("Action") }
  ProgramGroupIcon("Title")
  ProgramItem("Title")
  ProgramManager() { Text("Content"); Button("Action") }
  ProgressBar("Label")
  PushButton("Label")
  RADIOBUTTON("Label")
  RTEXT("Content")
}
.padding()
