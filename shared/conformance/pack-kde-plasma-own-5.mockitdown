// kde-plasma own elements: KCM, KCMCategory, KCMSidebar, KMessageWidget, LinkButton, ListItem, ListSectionHeader, ListView, LoadingPlaceholder, MainWindow, Menu, MenuBar
VStack(alignment: .leading, spacing: 12) {
  KCM("Title") { Text("Content"); Button("Action") }
  KCMCategory("Label")
  KCMSidebar("Title") { Text("Content"); Button("Action") }
  KMessageWidget("Text")
  LinkButton("Label")
  ListItem("Title")
  ListSectionHeader("Title") { Text("First item"); Text("Second item") }
  ListView() { Text("First item"); Text("Second item") }
  LoadingPlaceholder().frame(width: 160, height: 96)
  MainWindow() { Text("Content"); Button("Action") }
  Menu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  MenuBar() { Button("Save"); Button("Share") }
}
.padding()
