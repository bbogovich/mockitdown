// nextstep own elements: NXColorWell, NXRunAlertPanel, NXSplitView, NXText, NXWorkspace, Panel, PathView, PopUpList, ProgressIndicator, PullDownList, RadioButton, RadioMatrix
VStack(alignment: .leading, spacing: 12) {
  NXColorWell(.blue).frame(width: 160, height: 96)
  NXRunAlertPanel("Title") { Text("Content"); Button("Action") }
  NXSplitView() { Text("Content"); Button("Action") }
  NXText("Label")
  NXWorkspace() { Text("Content"); Button("Action") }.frame(width: 160, height: 96)
  Panel("Title") { Text("Content"); Button("Action") }
  PathView() { Text("Content"); Button("Action") }
  PopUpList("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  ProgressIndicator()
  PullDownList("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  RadioButton("Label")
  RadioMatrix("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
}
.padding()
