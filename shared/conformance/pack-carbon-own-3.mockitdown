// carbon own elements: DatePicker, DatePickerInput, DefinitionTooltip, DismissibleTag, DonutChart, Dropdown, ExpandableSearch, ExpandableTile, FileUploader, FileUploaderButton, FileUploaderDropContainer, FileUploaderItem
VStack(alignment: .leading, spacing: 12) {
  DatePicker("Label", selection: "2026-11-23")
  DatePickerInput("Label", selection: "2026-11-23")
  DefinitionTooltip("Text") { Text("Content"); Button("Action") }
  DismissibleTag("Label")
  DonutChart(values: [3, 5, 2, 6, 4])
  Dropdown("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  ExpandableSearch("Placeholder")
  ExpandableTile("Title") { Text("Content"); Button("Action") }
  FileUploader("Title") { Text("Content"); Button("Action") }
  FileUploaderButton("Label")
  FileUploaderDropContainer("Label")
  FileUploaderItem("Label")
}
.padding()
