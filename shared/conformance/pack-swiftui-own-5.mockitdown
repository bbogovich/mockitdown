// swiftui own elements: RealityView, RenameButton, Row, SceneView, ScrollView, ScrollViewReader, Section, SectorMark, SecureField, SettingsLink, ShareLink, Sheet
VStack(alignment: .leading, spacing: 12) {
  RealityView("Label").frame(width: 160, height: 96)
  RenameButton()
  Row("Title")
  SceneView("Label").frame(width: 160, height: 96)
  ScrollView() { Text("Content"); Button("Action") }
  ScrollViewReader() { Text("Content"); Button("Action") }
  Section("Title") { Text("First item"); Text("Second item") }
  SectorMark(values: [3, 5, 2, 6, 4])
  SecureField("Placeholder")
  SettingsLink()
  ShareLink()
  Sheet("Title") { Text("Content"); Button("Action") }
}
.padding()
