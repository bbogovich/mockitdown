// swiftui own elements: Popover, ProgressView, RealityView, RenameButton, Row, SceneView, ScrollView, ScrollViewReader, Section, SectorMark, SecureField, SettingsLink
VStack(alignment: .leading, spacing: 12) {
  Popover("Filters") { Toggle("Unread only", isOn: true); Toggle("Flagged", isOn: false) }
  ProgressView("Label")
  RealityView("Label").frame(width: 160, height: 96)
  RenameButton()
  Row("Title")
  SceneView("Label").frame(width: 160, height: 96)
  ScrollView() { Text("Content"); Button("Action") }
  ScrollViewReader() { Text("Content"); Button("Action") }
  Section("Title") { Text("First item"); Text("Second item") }
  SectorMark(values: [3, 5, 2, 6, 4])
  SecureField("Placeholder")
  SettingsLink()
}
.padding()
