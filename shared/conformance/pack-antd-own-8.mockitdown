// antd own elements: ProFormDateRangePicker, ProFormDigit, ProFormPassword, ProFormRadioGroup, ProFormSelect, ProFormSwitch, ProFormText, ProFormTextArea, ProFormUploadDragger, ProHeader, ProLayout, ProList
VStack(alignment: .leading, spacing: 12) {
  ProFormDateRangePicker("Label", selection: "2026-11-23")
  ProFormDigit("Label")
  ProFormPassword("Label")
  ProFormRadioGroup("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  ProFormSelect("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  ProFormSwitch("Label")
  ProFormText("Label")
  ProFormTextArea("Label")
  ProFormUploadDragger("Label")
  ProHeader("Title") { Text("Content"); Button("Action") }
  ProLayout() { Text("Content"); Button("Action") }
  ProList() { Text("First item"); Text("Second item") }
}
.padding()
