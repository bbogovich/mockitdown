// swiftui own elements: SignInWithAppleButton, Slider, SpriteView, Stepper, Tab, TabSection, TabView, Table, TableColumn, TableRow, Text, TextEditor
VStack(alignment: .leading, spacing: 12) {
  SignInWithAppleButton()
  Slider()
  SpriteView("Label").frame(width: 160, height: 96)
  Stepper("Label")
  TabView {
  Tab("Home", systemImage: "house") { Text("Welcome home") }
  Tab("Search", systemImage: "magnifyingglass") { Text("Search the library") }
  Tab("Profile", systemImage: "person") { Text("Your profile") }
}
  TabSection("Title") { Text("First item"); Text("Second item") }
  TabView {
  Tab("Home", systemImage: "house") { Text("Welcome home") }
  Tab("Library", systemImage: "books.vertical") { Text("Your library") }
  Tab("Search", systemImage: "magnifyingglass") { Text("Search") }
}
  Table(columns: ["Name", "Status"], rows: [["Ana Lima", "Active"], ["Ben Okafor", "Away"]])
  TableColumn("Title")
  TableRow() { Text("Ana Lima"); Text("Active") }
  Text("Content")
  TextEditor("Text")
}
.padding()
