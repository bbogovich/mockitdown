// antd own elements: Timeline, TimelineItem, Title, Tooltip, Tour, Transfer, TransferItem, TransferList, TransferOperation, Tree, TreeNode, TreeSelect
VStack(alignment: .leading, spacing: 12) {
  Timeline() { TimelineItem("Created"); TimelineItem("Shipped") }
  TimelineItem("Title")
  Title("Content")
  Tooltip("Title") { Text("Content"); Button("Action") }
  Tour("Title") { Text("Content"); Button("Action") }
  Transfer() { Text("Content"); Button("Action") }
  TransferItem("Title")
  TransferList("Title") { Text("Content"); Button("Action") }
  TransferOperation() { Text("Content"); Button("Action") }
  Tree() { TreeItem("Folder") { TreeItem("File") } }
  TreeNode("Title")
  TreeSelect("Placeholder")
}
.padding()
