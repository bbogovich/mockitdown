// macos9 own elements: PopupMenu, ProgressBar, PullDownMenu, PushButton, RadioButton, RadioGroup, ScrollArea, SearchField, SecondaryGroupBox, Separator, Slider, StickyNote
VStack(alignment: .leading, spacing: 12) {
  PopupMenu("Label")
  ProgressBar("Label")
  PullDownMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  PushButton("Label")
  RadioButton("Label")
  RadioGroup("Label")
  ScrollArea() { Text("Content"); Button("Action") }
  SearchField("Placeholder")
  SecondaryGroupBox("Title") { Text("Content"); Button("Action") }
  Separator()
  Slider("Label")
  StickyNote("Text")
}
.padding()
