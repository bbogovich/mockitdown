// carbon own elements: ClickableTile, CodeSnippet, Column, ComboBox, ComboButton, ComboChart, ComposedModal, Content, ContentSwitcher, CopyButton, DataTable, DataTableSkeleton
VStack(alignment: .leading, spacing: 12) {
  ClickableTile("Title") { Text("Content"); Button("Action") }
  CodeSnippet("let total = items.count")
  Column() { Text("Content"); Button("Action") }
  ComboBox("Label")
  ComboButton("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  ComboChart(values: [3, 5, 2, 6, 4])
  ComposedModal("Title") { Text("Content"); Button("Action") }
  Content() { Text("Content"); Button("Action") }
  ContentSwitcher(["One", "Two", "Three"])
  CopyButton()
  DataTable(columns: ["Name", "Status"], rows: [["Ana Lima", "Active"], ["Ben Okafor", "Away"]])
  DataTableSkeleton().frame(width: 160, height: 96)
}
.padding()
