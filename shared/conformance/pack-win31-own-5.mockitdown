// win31 own elements: MDIClient, MENUITEM, MSDOSPrompt, MSGraph, Menu, MenuBar, MenuItem, MenuSeparator, MessageBox, ModalDialog, MultiLineEdit, Notepad
VStack(alignment: .leading, spacing: 12) {
  MDIClient() { Text("Content"); Button("Action") }
  MENUITEM("Label")
  MSDOSPrompt("let total = items.count")
  MSGraph(values: [3, 5, 2, 6, 4])
  Menu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  MenuBar() { Button("Save"); Button("Share") }
  MenuItem("Label")
  MenuSeparator()
  MessageBox("Title") { Text("Content"); Button("Action") }
  ModalDialog("Title") { Text("Content"); Button("Action") }
  MultiLineEdit("Text")
  Notepad() { Text("Content"); Button("Action") }
}
.padding()
