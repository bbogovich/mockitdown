// primer own elements: Terminal, Text, TextInput, TextInputWithTokens, Textarea, Timeline, TimelineBreak, TimelineComment, TimelineItem, ToggleSwitch, Token, Tooltip
VStack(alignment: .leading, spacing: 12) {
  Terminal("let total = items.count")
  Text("Content")
  TextInput("Placeholder")
  TextInputWithTokens("Placeholder", options: ["Small", "Medium", "Large"], selection: "Medium")
  Textarea("Placeholder")
  Timeline() { TimelineItem("Created"); TimelineItem("Shipped") }
  TimelineBreak()
  TimelineComment("Title") { Text("Content"); Button("Action") }
  TimelineItem("Title")
  ToggleSwitch("Label")
  Token("Text")
  Tooltip("Text") { Text("Content"); Button("Action") }
}
.padding()
