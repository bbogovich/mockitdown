// win95 own elements: CascadeMenu, CheckBox, Clock, ComboBox, ContextMenu, ControlPanelItem, CopyAnimation, DateTimePicker, DefaultButton, Desktop, DesktopIcon, DialogBody
VStack(alignment: .leading, spacing: 12) {
  CascadeMenu() { Button("Open"); Button("Save"); Divider(); Button("Close") }
  CheckBox("Label")
  Clock()
  ComboBox("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  ContextMenu("Label") { Button("Open"); Button("Save"); Divider(); Button("Close") }
  ControlPanelItem("Title")
  CopyAnimation() { Text("Content"); Button("Action") }
  DateTimePicker("Label", selection: "2026-11-23")
  DefaultButton("Label")
  Desktop() { Text("Content"); Button("Action") }.frame(width: 160, height: 96)
  DesktopIcon("Title")
  DialogBody() { Text("Content"); Button("Action") }
}
.padding()
