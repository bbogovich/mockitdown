// fluent own elements: SplitView, StackPanel, SymbolIcon, TabView, TabViewItem, TeachingTip, TextBlock, TextBox, TimePicker, TitleBar, ToggleButton, ToggleMenuFlyoutItem
VStack(alignment: .leading, spacing: 12) {
  SplitView() { Text("Content"); Button("Action") }
  StackPanel() { Text("Content"); Button("Action") }
  SymbolIcon("star")
  TabView() { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  TabView { TabViewItem("Inbox") { Text("Inbox content") }; TabViewItem("Archive") { Text("Archive content") } }
  TeachingTip("Title") { Text("Content"); Button("Action") }
  TextBlock("Content")
  TextBox("Header")
  TimePicker("Header", selection: "2026-11-23")
  TitleBar("Title") { Text("Content"); Button("Action") }
  ToggleButton("Label")
  ToggleMenuFlyoutItem("Label")
}
.padding()
