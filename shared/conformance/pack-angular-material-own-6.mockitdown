// angular-material own elements: MatProgressSpinner, MatRadioButton, MatRadioGroup, MatRaisedButton, MatRow, MatSelect, MatSelectionList, MatSidenav, MatSidenavContainer, MatSidenavContent, MatSlideToggle, MatSlider
VStack(alignment: .leading, spacing: 12) {
  MatProgressSpinner()
  MatRadioButton("Label")
  MatRadioGroup("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  MatRaisedButton("Label")
  MatRow() { Text("Ana Lima"); Text("Active") }
  MatSelect("Label", options: ["Small", "Medium", "Large"], selection: "Medium")
  MatSelectionList() { Text("First item"); Text("Second item") }
  MatSidenav("Title") { Text("Content"); Button("Action") }
  MatSidenavContainer() { Text("Content"); Button("Action") }
  MatSidenavContent() { Text("Content"); Button("Action") }
  MatSlideToggle("Label")
  MatSlider()
}
.padding()
