// carbon own elements: TableContainer, TableExpandRow, TableExpandedRow, TableHeader, TableRow, TableToolbar, TableToolbarAction, TableToolbarContent, TableToolbarMenu, TableToolbarSearch, Tabs, Tag
VStack(alignment: .leading, spacing: 12) {
  TableContainer("Title") { Text("Content"); Button("Action") }
  TableExpandRow() { Text("Ana Lima"); Text("Active") }
  TableExpandedRow() { Text("Ana Lima"); Text("Active") }
  TableHeader("Title")
  TableRow() { Text("Ana Lima"); Text("Active") }
  TableToolbar() { Button("Save"); Button("Share") }
  TableToolbarAction("Label")
  TableToolbarContent() { Text("Content"); Button("Action") }
  TableToolbarMenu() { Button("Open"); Button("Save"); Divider(); Button("Close") }
  TableToolbarSearch()
  Tabs(["One", "Two", "Three"]) { Text("First tab").tabItem { Text("One") }; Text("Second tab").tabItem { Text("Two") } }
  Tag("Label")
}
.padding()
