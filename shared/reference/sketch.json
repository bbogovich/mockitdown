{
 "id": "sketch",
 "name": "Sketch",
 "framework": "Hand-drawn wireframe sketch of the neutral core (paper and pencil, one highlighter)",
 "version": "1",
 "modules": [
  "Sketch",
  "HandDrawn",
  "Napkin"
 ],
 "device": "desktop",
 "chrome": "browser",
 "group": "Wireframe",
 "elements": [
  {
   "name": "Annotation",
   "role": "stickynote",
   "params": [
    "text"
   ],
   "defaults": {
    "variant": "left"
   },
   "variants": [
    "left",
    "right",
    "up",
    "down"
   ],
   "doc": "Handwritten margin note in the highlighter colour with an arrow: Annotation(\"tap to edit\", variant: .up); place with .position(x:y:)",
   "own": true,
   "sample": "Annotation(\"Text\")",
   "variants_sample": "HStack(alignment: .top, spacing: 16) {\n  VStack(alignment: .leading, spacing: 4) { Annotation(\"Text\").variant(\"left\"); Text(\"left\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Annotation(\"Text\").variant(\"right\"); Text(\"right\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Annotation(\"Text\").variant(\"up\"); Text(\"up\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Annotation(\"Text\").variant(\"down\"); Text(\"down\").font(.caption).foregroundStyle(.secondary) }\n}"
  },
  {
   "name": "Arrow",
   "role": "divider",
   "params": [
    "label"
   ],
   "defaults": {
    "variant": "right"
   },
   "variants": [
    "right",
    "left",
    "down",
    "up"
   ],
   "doc": "A pencil arrow between screens or boxes in a flow, optional label: Arrow(\"tap\"), Arrow(variant: .down)",
   "own": true,
   "sample": "Arrow(\"Label\")",
   "variants_sample": "HStack(alignment: .top, spacing: 16) {\n  VStack(alignment: .leading, spacing: 4) { Arrow(\"Label\").variant(\"right\"); Text(\"right\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Arrow(\"Label\").variant(\"left\"); Text(\"left\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Arrow(\"Label\").variant(\"down\"); Text(\"down\").font(.caption).foregroundStyle(.secondary) }\n  VStack(alignment: .leading, spacing: 4) { Arrow(\"Label\").variant(\"up\"); Text(\"up\").font(.caption).foregroundStyle(.secondary) }\n}"
  },
