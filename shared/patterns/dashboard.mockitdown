// Dashboard: key figures, a trend, a breakdown and recent activity.
ScrollView {
  VStack(alignment: .leading, spacing: 16) {
    HStack {
      Text("Overview").font(.title2)
      Spacer()
      Picker("Period", selection: "Last 30 days") { Text("Last 7 days"); Text("Last 30 days"); Text("This year") }
    }
    LazyVGrid(columns: [GridItem(.flexible()), GridItem(.flexible()), GridItem(.flexible())], spacing: 12) {
      Stat("Revenue", "$48k", change: "+12%", trend: [3, 4, 3, 5, 6, 7])
      Stat("Orders", "1,284", change: "+4%", trend: [5, 5, 6, 5, 7, 8])
      Stat("Refunds", "23", change: "-8%", trend: [6, 5, 5, 4, 3, 3])
    }
    HStack(alignment: .top, spacing: 12) {
      Card("Sales by week") {
        LineChart(values: [12, 18, 15, 22, 28, 26, 31])
      }
      Card("Channels") {
        DonutChart(values: [45, 30, 25])
      }
    }
    Card("Orders by region") {
      BarChart(values: [32, 21, 17, 12, 9])
    }
    Card("Recent activity") {
      Timeline {
        TimelineItem("Order #1042 shipped", time: "09:12")
        TimelineItem("Refund issued to Ben Okafor", time: "08:40")
        TimelineItem("New customer: Chen Wu", time: "Yesterday")
      }
    }
  }
  .padding()
}
