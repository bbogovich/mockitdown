// Wizard (multi-step form): the steps, the current step's fields and back / next navigation.
VStack(alignment: .leading, spacing: 16) {
  Text("Create a project").font(.title2)
  Steps(["Details", "Team", "Billing", "Review"], current: 1)
  Card("Team") {
    VStack(alignment: .leading, spacing: 12) {
      Text("Invite the people who will work on this project.").foregroundStyle(.secondary)
      TextField("Email address", text: "chen.wu@example.com")
      Picker("Role", selection: "Editor") { Text("Viewer"); Text("Editor"); Text("Admin") }
      List {
        ListItem("Ana Lima", subtitle: "Owner", avatar: "Ana Lima")
        ListItem("Ben Okafor", subtitle: "Editor", avatar: "Ben Okafor")
      }
      Checkbox("Send an invitation email", isOn: true)
    }
  }
  ProgressView("Step 2 of 4", value: 0.5)
  HStack {
    Button("Cancel")
    Spacer()
    Button("Back")
    Button("Next").buttonStyle(.borderedProminent)
  }
}
.padding()
