# written by sio init — defaults for every SpecItOut implementation project

# Claude Code: commit only shareable settings and project agents, commands and skills
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/
.claude/settings.local.json
.claude/*.local.*

# SpecItOut machine state
.specitout/run.json
.specitout/*.local.json

# MkDocs build output (the implementation site lives on the docs branch)
/site/

# Secrets: never commit an environment file; .env.example documents the variables
.env
.env.*
!.env.example

# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log

# python-cli: build outputs and tool state
__pycache__/
*.egg-info/
.venv/
dist/

# example site build output
python/examples/site/site/
*.png.html

# Zensical render cache
.cache/
/build/
/dist/
python/build/
python/dist/

# Python package copies of the shared assets, written at build time by python/tools/sync_shared.py
# (R-REPO-002: shared/ is the only place they are written)
python/src/mockitdown/page.css
python/src/mockitdown/icons.json
python/src/mockitdown/vocabulary.json
python/src/mockitdown/packs/*/

# The repository LICENSE, copied beside pyproject.toml at build time
python/LICENSE

# TypeScript variant: dependencies, build output and compiled tests; the LICENSE copy made at build
typescript/node_modules/
typescript/dist/
typescript/test-build/
typescript/test-results/
typescript/playwright-report/
typescript/LICENSE
